{
  "schema_version": 1,
  "contract": "anchor-trio-model-policy-v1",
  "policy": {
    "mode": "latest_supported",
    "effort": "highest_supported"
  },
  "notes": [
    "All model names other than the provider's moving best alias are synthetic.",
    "Both implementations must consume raw fixtures unchanged; the test consumers do not adapt incompatible schemas.",
    "Unavailable cases must raise the public PolicyUnavailable type, not an incidental parsing error.",
    "Reason labels describe the contract failure; implementation-specific error prose is not part of the shared contract.",
    "Provider priority is used only when advertised. Provider-order selection is not an attested frontier rank.",
    "The canonical Claude capability input is an efforts array; CLI-help parsing remains a provider-specific discovery responsibility."
  ],
