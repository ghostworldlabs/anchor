{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MvWfbfvjQe88ewE7FX7bzT","type":"tool_result","content":"1\t\"\"\"Publisher — runs after the Agents sweep (01:45 daily per plan §16.2).\n2\t\n3\tBuilds a scrubbed kb-snapshot.sqlite (no transcripts, no artifact bundles),\n4\tgenerates the daily CHANGELOG entry, stages an explicit allowlist of paths,\n5\tand (when not in --dry-run) git commit + tag YYYYMMDD + push.\n6\t\n7\tP8 scaffold: --dry-run mode shows what would be staged. Live push needs the\n8\tuser to create the aurora-library private repo on GitHub and set GITHUB_PAT +\n9\tGITHUB_REPO in .env, then run `python -m aurora.publisher` (no --dry-run).\n10\t\"\"\"\n11\tfrom __future__ import annotations\n12\timport argparse\n13\timport hashlib\n14\timport json\n15\timport os\n16\timport shutil\n17\timport sqlite3\n18\timport subprocess\n19\timport sys\n20\timport tempfile\n21\tfrom datetime import datetime, timezone\n22\tfrom pathlib import Path\n23\t\n24\t# Force line-buffered stdout/stderr so cmd-launcher and scheduled-task callers\n25\t# see progress in real time instead of one big buffered dump (or nothing).\n26\ttry:\n27\t    sys.stdout.reconfigure(line_buffering=True)\n28\t    sys.stderr.reconfigure(line_buffering=True)\n29\texcept Exception:\n30\t    pass\n31\t\n32\t# Publisher is a stand-alone entry point — it must NOT depend on its caller\n33\t# loading .env. Load it ourselves.\n34\ttry:\n35\t    from dotenv import load_dotenv\n36\t    load_dotenv(Path(__file__).resolve().parent / \".env\", override=False)\n37\texcept Exception:\n38\t    pass\n39\t\n40\t# Wave 2 (2026-06-06) — single-owner gate predicate. Publisher is an in-package\n41\t# enforcement point, so it imports the gate clause from its sole owner rather\n42\t# than re-typing the servable SQL literal (the converged Shark finding).\n43\tfrom aurora.roles.security import gate\n44\t\n45\tROOT = Path(__file__).resolve().parent\n46\tDB_PATH = ROOT / \"kb\" / \"aurora.db\"\n47\tLIBRARY_ROOT = ROOT / \"library\"\n48\tREPORTS_ROOT = ROOT / \"reports\"\n49\tSEED_MAP_ROOT = ROOT / \"seed_map\"\n50\tHELPING_HAND_PLUGIN = ROOT / \"helping-hand-plugin\"\n51\tPUBLISH_ROOT = ROOT / \"_publish\"     # local staging tree\n52\tSNAPSHOT_NAME = \"kb-snapshot.sqlite\"\n53\t\n54\t# ── Awareness Revamp Wave 3 (2026-06-12): model_benchmarks CC1 disposition ────\n55\t# model_benchmarks disposition = PUBLISH-WITH-LICENSE-FILTER. The table SHIPS,\n56\t# but the publisher deletes every cell that is null-license, non-allowed-license,\n57\t# or restricted-source BEFORE the final VACUUM. These two sets are the auditable\n58\t# policy (RESEARCH §B-5/§B-6): Epoch CC-BY-4.0 and Aider/Terminal-Bench\n59\t# Apache-2.0 are redistributable; Artificial-Analysis-derived and OpenRouter-\n60\t# derived cells are NOT (scrubbed by source regardless of license).\n61\tALLOWED_BENCHMARK_LICENSES = (\"CC-BY-4.0\", \"Apache-2.0\")\n62\tEXCLUDED_BENCHMARK_SOURCES = (\"artificial-analysis\", \"openrouter\")\n63\t\n64\t\n65\t# Wave C C3 (2026-05-29): Aurora Sentinel security gate.\n66\t# Mode-aware SQL fragment for filtering non-clean artifacts out of the\n67\t# published snapshot + the published library/ copytree. Two of the four\n68\t# §4.2 enforcement points live in this file (the other two live in\n69\t# librarian.upsert_artifact and the MCP server).\n70\tdef _security_gate_clause(table_alias: str = \"a\") -> str:\n71\t    \"\"\"Mode-aware servable clause for the snapshot SELECT (§4.2 enforcement\n72\t    point #3). Delegates to the single owner gate.enforcement_clause() so the\n73\t    servable SQL literal lives in exactly one file (roles/security/gate.py).\"\"\"\n74\t    return gate.enforcement_clause(table_alias)\n75\t\n76\t\n77\tdef _artifact_is_servable_in_snapshot(conn: sqlite3.Connection,\n78\t                                       slug: str) -> bool:\n79\t    \"\"\"Predicate for the copytree filter (§4.2 enforcement point #4). Returns\n80\t    True when this slug's most recent artifact row passes the gate; True in\n81\t    shadow/off so calibration data flows through.\n82\t\n83\t    Lookup is by slug-only (most-recent row wins on ties) because the\n84\t    library directory layout `library/<kind>/<slug>/` indexes by slug. In\n85\t    practice (sweep, slug) is unique per kind, so this is unambiguous for\n86\t    any catalog populated by the current librarian.\n87\t\n88\t    Wave 2 (2026-06-10) — retired pages must NEVER ship (E20). This predicate is\n89\t    evaluated FIRST, UNCONDITIONALLY, BEFORE the AURORA_SECURITY_MODE early-\n90\t    return below — because in production that env var is UNSET, and a check\n91\t    placed after the early-return would be dead code that never runs. A slug\n92\t    whose most-recent row is retired is non-servable regardless of security mode.\n93\t    \"\"\"\n94\t    try:\n95\t        rrow = conn.execute(\n96\t            \"SELECT retired_at FROM artifacts \"\n97\t            \"WHERE slug=? ORDER BY last_verified_at DESC LIMIT 1\",\n98\t            (slug,),\n99\t        ).fetchone()\n100\t        if rrow is not None and rrow[0] is not None:"}]},"parent_tool_use_id":"toolu_01VLkraJFgEdSF3EAkXiHTtu","session_id":"5f986a64-6630-4578-8cdf-92983029246b","uuid":"acd886f8-3db6-4905-894f-df9450bd213b","timestamp":"2026-06-23T19:12:16.399Z","subagent_type":"Explore","task_description":"Map Aurora code architecture"}
