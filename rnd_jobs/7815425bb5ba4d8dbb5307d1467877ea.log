{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0182KrMSXfPWfH35jfKvGTCx","type":"tool_result","content":"1\t\"\"\"Thin LLM wrapper that records every call into the `costs` table.\n2\tSingle point where pricing lives so all roles share the same accounting.\n3\t\n4\tBucket G1+G2 (v4.3, 2026-05-19):\n5\t  - tenacity-driven retry on transient Anthropic and Gemini errors\n6\t    (full-jitter exponential 1..60s, 5 attempts, then degrade to Haiku)\n7\t  - critic_b default model swapped to gemini-2.5-flash-lite\n8\t    (thinking-off-by-default, 6x cheaper, sidesteps the MAX_TOKENS bug)\n9\t\"\"\"\n10\tfrom __future__ import annotations\n11\timport logging\n12\timport os\n13\timport time\n14\tfrom dataclasses import dataclass\n15\tfrom datetime import datetime, timezone\n16\tfrom pathlib import Path\n17\tfrom typing import Optional\n18\timport yaml\n19\t\n20\tfrom tenacity import (\n21\t    retry,\n22\t    stop_after_attempt,\n23\t    stop_after_delay,\n24\t    wait_exponential_jitter,\n25\t    retry_if_exception,\n26\t    before_sleep_log,\n27\t)\n28\t\n29\tlog = logging.getLogger(__name__)\n30\t\n31\tROOT = Path(__file__).resolve().parent\n32\tPRICING_PATH = ROOT / \"kb\" / \"pricing.yaml\"\n33\t\n34\t# ---- Transient-error classifiers (Bucket G1) ----\n35\t\n36\tdef _is_retryable_anthropic(exc: BaseException) -> bool:\n37\t    \"\"\"True for transient Anthropic errors: timeouts, connection drops,\n38\t    429 (rate-limited), 5xx, and 529 (overloaded). NOT for 4xx like 400/401/403.\"\"\"\n39\t    import anthropic\n40\t    if isinstance(exc, (anthropic.APITimeoutError, anthropic.APIConnectionError)):\n41\t        return True\n42\t    if isinstance(exc, anthropic.APIStatusError):\n43\t        return exc.status_code in (408, 425, 429, 500, 502, 503, 504, 529)\n44\t    return False\n45\t\n46\t\n47\tdef _is_retryable_genai(exc: BaseException) -> bool:\n48\t    \"\"\"Heuristic for google-generativeai transient errors. Their exception\n49\t    hierarchy is less structured than Anthropic's, so we match on type name\n50\t    and message keywords.\"\"\"\n51\t    name = type(exc).__name__\n52\t    if name in (\n53\t        \"ServiceUnavailable\", \"DeadlineExceeded\", \"Aborted\",\n54\t        \"ResourceExhausted\", \"InternalServerError\", \"RetryError\",\n55\t    ):\n56\t        return True\n57\t    msg = str(exc).lower()\n58\t    return any(k in msg for k in (\n59\t        \"503\", \"504\", \"529\", \"overloaded\", \"timeout\", \"rate limit\", \"try again\",\n60\t    ))\n61\t\n62\t\n63\t# ---- Retry decorators ----\n64\t# Full-jitter exponential, 5 attempts, max 60s wait. `reraise=True` so the\n65\t# caller sees the original exception type, not a tenacity RetryError.\n66\t#\n67\t# Bucket O-23 (2026-05-23): stop is now `stop_after_attempt(5) | stop_after_delay(60)`\n68\t# so the inner retry chain cannot run longer than 60s wall-clock regardless of\n69\t# attempt count. The outer Sonnet→Haiku fallback in call_anthropic has its own\n70\t# wall-clock guard (HAIKU_FALLBACK_DEADLINE_S) so the total worst case is\n71\t# 60s + 60s = 120s, not the prior 5×60 + 5×60 = ~10min.\n72\t_RETRY_KW = dict(\n73\t    wait=wait_exponential_jitter(initial=1, max=60),\n74\t    stop=stop_after_attempt(5) | stop_after_delay(60),\n75\t    reraise=True,\n76\t    before_sleep=before_sleep_log(log, logging.WARNING),\n77\t)\n78\t\n79\t# O-23: outer wall-clock budget across the Sonnet→Haiku fallback chain.\n80\tHAIKU_FALLBACK_DEADLINE_S = 120.0\n81\t\n82\t\n83\t@retry(retry=retry_if_exception(_is_retryable_anthropic), **_RETRY_KW)\n84\tdef _anthropic_create(client, **kw):\n85\t    return client.messages.create(**kw)\n86\t\n87\t\n88\t@retry(retry=retry_if_exception(_is_retryable_genai), **_RETRY_KW)\n89\tdef _gemini_generate(model_obj, prompt, generation_config):\n90\t    return model_obj.generate_content(prompt, generation_config=generation_config)\n91\t\n92\t\n93\t# ---- Bucket G4: per-run degrade counter, read by orchestrator.close_run() ----\n94\t# Incremented whenever a Sonnet->Haiku or Gemini->Haiku fallback fires for a\n95\t# given run. orchestrator looks at this after walk_pipeline to decide whether\n96\t# to close the run as 'ok' or 'partial'.\n97\t_DEGRADE_COUNT: \"dict[int, int]\" = {}\n98\t\n99\t\n100\tdef _note_degrade(cost_recorder: Optional[\"CostRecorder\"], reason: str) -> None:"}]},"parent_tool_use_id":"toolu_01VLkraJFgEdSF3EAkXiHTtu","session_id":"5f986a64-6630-4578-8cdf-92983029246b","uuid":"f290f217-5f2e-43e7-aa10-d362102e9e25","timestamp":"2026-06-23T19:12:16.211Z","subagent_type":"Explore","task_description":"Map Aurora code architecture"}
