{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V1ewR1FvbvQbZJ4Zy2548v","type":"tool_result","content":"400\t    return os.environ.get(name, \"\").strip().lower() in (\"1\", \"true\", \"yes\", \"on\")\n401\t\n402\t\n403\tdef gemini_disabled() -> bool:\n404\t    \"\"\"2026-06-05 (cost-audit) global kill-switch. With AURORA_DISABLE_GEMINI=1 all\n405\t    Gemini chat calls route to the Anthropic Haiku fallback and embeddings are\n406\t    skipped, so a topped-up key cannot silently resume Gemini spend. The May bill\n407\t    was $118 (+9746%) driven by unrecorded thinking tokens; see\n408\t    reports/cost-audit-2026-06-05.md.\"\"\"\n409\t    return _truthy_env(\"AURORA_DISABLE_GEMINI\")\n410\t\n411\t\n412\t# ---- Wave L3 (2026-06-07): structured-output forced-tool-use machinery ----\n413\t#\n414\t# The installed anthropic SDK is 0.102.0. It DOES expose native structured\n415\t# outputs (`client.messages.parse` / `output_config={\"format\": {...}}`), but\n416\t# Aurora's whole metering + retry + Sonnet→Haiku-fallback path is built around\n417\t# the raw `client.messages.create(**kw)` call wrapped by `_anthropic_create`,\n418\t# whose response carries `resp.content` (text blocks) and `resp.usage`\n419\t# (token + cache fields). Native parse returns a different response wrapper and\n420\t# would force a parallel code path; the cost-metering block below reads\n421\t# `resp.usage` / `resp.content` UNCHANGED.\n422\t#\n423\t# So Wave L3 uses the PORTABLE strict-tool-use equivalent: a single tool whose\n424\t# `input_schema` IS the caller's `output_schema`, forced via\n425\t# `tool_choice={\"type\":\"tool\",\"name\":...}` and `strict:true`. The model is then\n426\t# OBLIGED to emit exactly one tool_use block whose `.input` is schema-conformant\n427\t# JSON — no prose, no code fences, no parse failure. We serialize that\n428\t# `.input` dict back to a JSON string and return it, so every existing caller\n429\t# (which does `json.loads(text)`) keeps working WITHOUT ever taking a\n430\t# strip_fences path. Metering is byte-for-byte identical: same\n431\t# `_anthropic_create(client, **kw)`, same `resp.usage` read, same\n432\t# `CostRecorder.record(...)` incl. the L1/L2 cache fields. The Sonnet→Haiku\n433\t# fallback reuses the same `kw` (tools + tool_choice ride along), so the\n434\t# degraded Haiku call is ALSO schema-guaranteed and metered identically.\n435\t_STRUCTURED_TOOL_NAME = \"emit_result\"\n436\t\n437\t\n438\t# ---- Wave L4 (2026-06-07): adaptive thinking via `effort` ----\n439\t#\n440\t# Anthropic deprecated the fixed-budget thinking knob: on 4.6+ `budget_tokens`\n441\t# is deprecated and on Opus 4.7/4.8 it is REMOVED — sending\n442\t# `thinking={\"type\":\"enabled\",\"budget_tokens\":N}` returns a 400. The modern\n443\t# replacement is ADAPTIVE thinking (`thinking={\"type\":\"adaptive\"}`) whose depth\n444\t# is steered by the GA `effort` parameter, which lives inside `output_config`\n445\t# (NOT top-level): `output_config={\"effort\": \"low\"|\"medium\"|\"high\"|...}`. Source:\n446\t# the bundled claude-api skill — SKILL.md \"Thinking & Effort\" + the python\n447\t# claude-api README \"Extended Thinking\" section (Anthropic docs, cached 2026):\n448\t#\n449\t#     thinking={\"type\": \"adaptive\"}\n450\t#     output_config={\"effort\": \"high\"}   # low | medium | high (| xhigh | max, Opus)\n451\t#\n452\t# So when a caller passes `effort=`, call_anthropic attaches exactly that shape\n453\t# and NEVER a `budget_tokens` field. Default (`effort=None`) attaches NEITHER —\n454\t# the request is byte-for-byte the pre-Wave-L4 path, so the default path is\n455\t# cost-neutral and behaviour-preserving.\n456\t#\n457\t# Aurora-allowed effort values. We don't hard-enforce the Opus-only `max` here\n458\t# (the API gates that per-model); these are the documented levels.\n459\t_EFFORT_LEVELS = (\"low\", \"medium\", \"high\", \"xhigh\", \"max\")\n460\t\n461\t# The deprecated/removed key that must NEVER appear in an assembled Anthropic\n462\t# request. Opus 4.8 returns a 400 if it does; the guard below fails loudly so a\n463\t# regression is caught in-process rather than as a live 400 mid-sweep.\n464\t_FORBIDDEN_ANTHROPIC_KEY = \"budget_tokens\"\n465\t\n466\t\n467\tdef _find_forbidden_key(obj, key: str) -> bool:\n468\t    \"\"\"Recursively True iff `key` appears anywhere in a nested dict/list `obj`.\"\"\"\n469\t    if isinstance(obj, dict):\n470\t        if key in obj:\n471\t            return True\n472\t        return any(_find_forbidden_key(v, key) for v in obj.values())\n473\t    if isinstance(obj, (list, tuple)):\n474\t        return any(_find_forbidden_key(v, key) for v in obj)\n475\t    return False\n476\t\n477\t\n478\tdef _assert_no_budget_tokens(kw: dict) -> None:\n479\t    \"\"\"Wave L4 GUARD: fail LOUDLY if a `budget_tokens` field is present anywhere\n480\t    in an assembled Anthropic request dict.\n481\t\n482\t    `budget_tokens` is deprecated on 4.6+ and REMOVED on Opus 4.7/4.8 (the live\n483\t    API returns a 400). Adaptive thinking via `effort` is the only supported\n484\t    path. This guard runs at the single dispatch funnel — immediately before\n485\t    every `_anthropic_create(...)` call (the initial call, the Haiku fallback,\n486\t    and the structured->plain degrade all go through it) — so NO assembled\n487\t    request can ever carry the forbidden key, with `effort` set OR unset. It\n488\t    raises rather than silently stripping: a `budget_tokens` appearing here means\n489\t    a code path tried to send the deprecated shape, which is a bug to surface,\n490\t    not paper over.\"\"\"\n491\t    if _find_forbidden_key(kw, _FORBIDDEN_ANTHROPIC_KEY):\n492\t        raise AssertionError(\n493\t            \"Wave L4 guard: an Anthropic request carried the deprecated/removed \"\n494\t            f\"`{_FORBIDDEN_ANTHROPIC_KEY}` field (400 on Opus 4.7/4.8). Use \"\n495\t            \"adaptive thinking via `effort` instead — see the call_anthropic \"\n496\t            \"`effort` parameter and the Wave-L4 note in llm.py.\"\n497\t        )\n498\t\n499\t\n500\tdef _fold_thinking_into_output(usage) -> int:\n501\t    \"\"\"Wave L4: return the usage's output token count WITH any SEPARATELY-reported\n502\t    thinking/reasoning tokens folded in, so adaptive-thinking spend is never\n503\t    silently dropped from metering.\n504\t\n505\t    This mirrors the Gemini `thoughts_token_count` fold in `call_gemini` — the\n506\t    root cause of the prior $118 incident was thinking tokens billed but never\n507\t    recorded. On the Anthropic Messages API, `usage.output_tokens` ALREADY\n508\t    includes thinking tokens (thinking is emitted as output content blocks), so\n509\t    in the common case there is nothing extra to add and the returned value\n510\t    equals `usage.output_tokens` — the default/no-effort path is unchanged.\n511\t\n512\t    But the SDK/usage shape can evolve to surface thinking separately (and some\n513\t    response shapes expose a distinct reasoning/thinking-token field). To be\n514\t    DEFENSIVELY correct — and to honour the Wave-L4 invariant that thinking\n515\t    tokens are always metered into output — we look for a separately-reported\n516\t    thinking-token field and add it to `output_tokens` if (and only if) it is\n517\t    present and non-zero. We never double-count: only a SEPARATE field is added;\n518\t    if the API ever moves thinking out of `output_tokens` into its own field,\n519\t    this keeps metering whole automatically.\"\"\"\n520\t    out = int(getattr(usage, \"output_tokens\", 0) or 0)\n521\t    # Probe the known/plausible separate-thinking field names, newest-first.\n522\t    # If a future SDK reports thinking tokens separately under any of these,\n523\t    # they get folded into the metered output rather than dropped.\n524\t    for fld in (\"output_thinking_tokens\", \"thinking_output_tokens\",\n525\t                \"thinking_tokens\", \"reasoning_tokens\", \"reasoning_output_tokens\"):\n526\t        extra = getattr(usage, fld, None)\n527\t        if extra:\n528\t            out += int(extra)\n529\t    return out\n530\t\n531\t\n532\tdef _structured_text_from_resp(resp) -> Optional[str]:\n533\t    \"\"\"Return a JSON string from the forced tool_use block of a structured\n534\t    response, or None if no tool_use block is present (the model declined / the\n535\t    response was empty). Callers treat None like an unparseable response —\n536\t    their existing field-default / fail-closed degradation applies.\"\"\"\n537\t    import json as _json\n538\t    for b in getattr(resp, \"content\", None) or []:\n539\t        if getattr(b, \"type\", None) == \"tool_use\" or hasattr(b, \"input\"):\n540\t            inp = getattr(b, \"input\", None)\n541\t            if isinstance(inp, dict):\n542\t                return _json.dumps(inp)\n543\t    return None\n544\t\n545\t\n546\tdef call_anthropic(prompt: str, *, model: Optional[str] = None, max_tokens: int = 600,\n547\t                   cost_recorder: Optional[CostRecorder] = None,\n548\t                   role_hint: str = \"anthropic\",\n549\t                   system: Optional[str] = None,\n550\t                   cache_system: bool = False,\n551\t                   output_schema: Optional[dict] = None,\n552\t                   effort: Optional[str] = None) -> str:\n553\t    \"\"\"Call Anthropic Messages API with G1 retry + Haiku-fallback.\n554\t\n555\t    Records cost via `cost_recorder`. On exhausted transient retries against a\n556\t    non-Haiku model (typically Sonnet for runner/critic_a), degrades to Haiku\n557\t    once. On Haiku failure, raises — caller decides to mark `runs.status='partial'`.\n558\t\n559\t    Wave L3 (2026-06-07): when `output_schema` (a JSON Schema dict) is supplied,\n560\t    the call uses STRICT FORCED TOOL USE to schema-guarantee the JSON response —\n561\t    a single tool named `emit_result` whose `input_schema` IS `output_schema`,\n562\t    forced via `tool_choice` + `strict:true`. The returned string is the\n563\t    `json.dumps(...)` of that tool's validated `.input`, so a caller's\n564\t    `json.loads(text)` parses cleanly and NEVER needs `strip_fences`. If the\n565\t    model somehow returns no tool_use block, the returned text is `\"\"` — the\n566\t    caller's existing field-default / fail-closed path then degrades exactly as\n567\t    on a malformed response (no unearned pass; no silent crash). The\n568\t    cost-metering path (resp.usage / CostRecorder.record incl. cache fields) is\n569\t    UNCHANGED, and the Sonnet→Haiku fallback carries the same `output_schema`\n570\t    (tools + tool_choice ride on the shared `kw`).\n571\t\n572\t    Wave 5 / W5-F1 (2026-06-07): structured output is a BEST-EFFORT enhancement\n573\t    that DEGRADES to the legacy plain-text path. Whether the live Anthropic API\n574\t    accepts our strict no-`required` schema is unverified; if it rejects it the\n575\t    SDK raises a NON-retryable 400, which the Sonnet→Haiku fallback can't fix\n576\t    (same schema -> another 400 -> re-raise). An unhandled raise here would abort\n577\t    the whole nightly sweep (critic_a/critic_b/reconciler don't wrap this call).\n578\t    So when `output_schema` is set and the structured attempt FAILS after the\n579\t    Sonnet→Haiku fallback is exhausted, we DEGRADE: retry ONCE as a PLAIN call\n580\t    WITHOUT tools/tool_choice/output_schema (the legacy text path callers already\n581\t    parse with json.loads + strip_fences + field-defaults), and `_note_degrade`\n582\t    so the fallback is visible in telemetry / the degrade counter. Net:\n583\t      - schema accepted -> schema-guaranteed JSON (the win), as before;\n584\t      - schema rejected / unsupported -> plain text -> caller's existing parse +\n585\t        defaults -> NO crash, NO sweep abort.\n586\t    Cost is metered ONCE, off whichever call actually succeeded (the failed\n587\t    structured attempt produced no usage and is not metered). The security\n588\t    judge's fail-CLOSED behaviour is intact: an empty/abstain result from the\n589\t    plain fallback still maps to abstain (the fallback never hides a real\n590\t    abstain). The default (no output_schema) path is byte-for-byte unchanged.\n591\t\n592\t    Wave L2 (2026-06-07): when `cache_system=True` AND a `system` is supplied,\n593\t    the system prompt is sent as a STRUCTURED content block carrying\n594\t    `cache_control: {\"type\": \"ephemeral\"}` instead of a bare string. Anthropic\n595\t    then bills a near-identical nightly system+rubric prefix at the cache-read\n596\t    rate after the first call writes the cache. The response usage's\n597\t    `cache_read_input_tokens` / `cache_creation_input_tokens` are folded into\n598\t    `CostRecorder.record(... cache_read_tokens=, cache_write_tokens=)` so the\n599\t    L1 substrate prices them at the cache sub-rates (~0.1x / ~1.25x input).\n600\t\n601\t    The cache_control rides on `kw[\"system\"]`, so the Sonnet→Haiku fallback\n602\t    (which reuses the same `kw` dict) caches identically — a degraded Haiku call\n603\t    still benefits from (and meters) caching. When `cache_system=False` (the\n604\t    default), the request and metering are byte-for-byte the pre-Wave-L2 path:\n605\t    a bare-string `system` and `record(...)` with no cache args.\n606\t\n607\t    Wave L4 (2026-06-07): `effort` opts into ADAPTIVE extended thinking. When\n608\t    supplied (one of \"low\"/\"medium\"/\"high\"/\"xhigh\"/\"max\"), the request carries\n609\t    `thinking={\"type\":\"adaptive\"}` + `output_config={\"effort\": effort}` — the\n610\t    modern, GA shape. It NEVER assembles `budget_tokens` (deprecated on 4.6+,\n611\t    removed on Opus 4.7/4.8 with a 400) — a guard (`_assert_no_budget_tokens`)\n612\t    runs at the single dispatch funnel and fails loudly if any assembled request\n613\t    ever carries it. API-reported thinking tokens are folded into the metered\n614\t    OUTPUT tokens (`_fold_thinking_into_output`, mirroring the Gemini\n615\t    `thoughts_token_count` fold) so thinking spend is never silently dropped (the\n616\t    $118-incident lesson). `effort` rides on `kw`, so the Sonnet→Haiku fallback\n617\t    and the structured->plain degrade carry it too. When `effort=None` (the\n618\t    default) NEITHER the thinking nor output_config keys are attached and the\n619\t    metered output is exactly `usage.output_tokens` — the request and cost are\n620\t    byte-for-byte the pre-Wave-L4 path (cost-neutral, behaviour-preserving).\n621\t    \"\"\"\n622\t    if effort is not None and effort not in _EFFORT_LEVELS:\n623\t        raise ValueError(\n624\t            f\"call_anthropic: effort={effort!r} not in {_EFFORT_LEVELS}\"\n625\t        )\n626\t    import anthropic\n627\t    client = anthropic.Anthropic(api_key=os.environ[\"ANTHROPIC_API_KEY\"])\n628\t    # O-6: AURORA_EMBEDDER_MODEL is for the Gemini-embedder role; leaking it\n629\t    # here meant a Gemini model name could land in the Anthropic SDK and 4xx\n630\t    # (non-retryable by G1, and the Haiku-fallback below requires a\n631\t    # \"claude-haiku\" prefix). All real callers pass `model=` explicitly.\n632\t    mdl = model or HAIKU_DEFAULT\n633\t    kw = {\n634\t        \"model\": mdl,\n635\t        \"max_tokens\": max_tokens,\n636\t        \"messages\": [{\"role\": \"user\", \"content\": prompt}],\n637\t    }\n638\t    if output_schema is not None:\n639\t        # Wave L3: strict forced tool use. One tool whose input_schema IS the\n640\t        # caller's output_schema; force it so the model MUST emit a single\n641\t        # schema-conformant tool_use block (no prose, no fences, no parse fail).\n642\t        # `strict: true` makes the API validate the input against the schema.\n643\t        # This rides on `kw`, so the Sonnet->Haiku fallback below reuses it and\n644\t        # the degraded Haiku call is schema-guaranteed too.\n645\t        kw[\"tools\"] = [{\n646\t            \"name\": _STRUCTURED_TOOL_NAME,\n647\t            \"description\": \"Return the result as structured JSON matching the schema.\",\n648\t            \"strict\": True,\n649\t            \"input_schema\": output_schema,\n650\t        }]\n651\t        kw[\"tool_choice\"] = {\"type\": \"tool\", \"name\": _STRUCTURED_TOOL_NAME}\n652\t    if effort is not None:\n653\t        # Wave L4: adaptive thinking, depth steered by `effort`. NOTE — we set\n654\t        # `output_config.effort` here; the Wave-L3 structured path uses\n655\t        # `tools` + `tool_choice` (NOT output_config.format), so the two never\n656\t        # collide on the same key. NEVER `budget_tokens` (the guard enforces).\n657\t        kw[\"thinking\"] = {\"type\": \"adaptive\"}\n658\t        oc = kw.get(\"output_config\")\n659\t        if isinstance(oc, dict):\n660\t            oc[\"effort\"] = effort\n661\t        else:\n662\t            kw[\"output_config\"] = {\"effort\": effort}\n663\t    if system:\n664\t        # Wave L2: only attach the ephemeral cache_control marker when the\n665\t        # stable prefix is actually large enough to cache on this model.\n666\t        # cache_control BELOW the per-model minimum (MODEL_CACHE_MIN_TOKENS) is\n667\t        # a silent no-op at the API — it would never set\n668\t        # cache_creation_input_tokens, so sending it just clutters the request.\n669\t        # We gate on the *initial* model: if the Sonnet->Haiku fallback fires it\n670\t        # reuses this same `kw[\"system\"]`, so a marker that cleared the initial\n671\t        # model rides along unchanged (and Haiku's own metering still folds any\n672\t        # cache tokens). When the prefix is below threshold we send a bare-string\n673\t        # system — byte-for-byte the cache-off path — so today's small Aurora\n674\t        # prefixes incur zero behavioural change while the plumbing stays ready\n675\t        # for larger prompts. See cache_prefix_clears_minimum / the module-level\n676\t        # MODEL_CACHE_MIN_TOKENS note.\n677\t        if cache_system and cache_prefix_clears_minimum(system, mdl):\n678\t            # Structured system block with an ephemeral cache breakpoint on the\n679\t            # stable prefix. The whole `system` here IS the stable prefix —\n680\t            # callers keep their per-candidate VARIABLE text in the user\n681\t            # message (`prompt`), never in `system`.\n682\t            kw[\"system\"] = [{\n683\t                \"type\": \"text\",\n684\t                \"text\": system,\n685\t                \"cache_control\": {\"type\": \"ephemeral\"},\n686\t            }]\n687\t        else:\n688\t            if cache_system:\n689\t                log.debug(\n690\t                    \"call_anthropic: cache_system requested but system prefix \"\n691\t                    \"(~%d tok) is below %s's cache minimum (%d tok) — sending \"\n692\t                    \"bare-string system (caching is a no-op at this size)\",\n693\t                    _estimate_prefix_tokens(system), mdl,\n694\t                    _cache_min_tokens_for(mdl),\n695\t                )\n696\t            kw[\"system\"] = system\n697\t    # O-23: wall-clock budget across the entire chain (inner retries + Haiku\n698\t    # fallback). On a sustained 529 storm this caps total hang at ~120s.\n699\t    start = time.monotonic()"}]},"parent_tool_use_id":"toolu_01VLkraJFgEdSF3EAkXiHTtu","session_id":"5f986a64-6630-4578-8cdf-92983029246b","uuid":"1cc4319a-4795-4275-9b46-eab020940a24","timestamp":"2026-06-23T19:12:54.370Z","subagent_type":"Explore","task_description":"Map Aurora code architecture"}
