{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011YPvEMHKfDZ7kkATdeuMRf","type":"tool_result","content":"1\t-- Aurora knowledge-base schema (v3)\n2\t-- Generated from NIGHTLY_SWEEP_PLAN.md §6\n3\t-- Apply with: sqlite3 aurora.db < schema.sql\n4\tPRAGMA foreign_keys = ON;\n5\tPRAGMA journal_mode = WAL;\n6\t\n7\t-- artifacts: the canonical record per discovered skill/template/tool/agent\n8\t-- Bucket I1 (v4.3, 2026-05-19 PM; doc drift fix Wave A2 2026-05-29):\n9\t-- description_vec BLOB stores gemini-embedding-2 embeddings of\n10\t-- short_description as little-endian float32. Populated by\n11\t-- bin/embed-library.py; consumed by helping-hand-plugin/.../server.py\n12\t-- match_request (cosine sim). NULL until embedded; server falls back to\n13\t-- keyword overlap when NULL or GEMINI_API_KEY unset.\n14\tCREATE TABLE IF NOT EXISTS artifacts (\n15\t  id INTEGER PRIMARY KEY,\n16\t  sweep TEXT NOT NULL CHECK(sweep IN ('skills','tools','agents','models')),\n17\t  -- A7 (2026-05-29): 'paper' added per Q1 decision — arxiv/journal references\n18\t  -- get their own kind so the tool/agent coverage metrics aren't polluted\n19\t  -- and the tool_install satellite (0009) doesn't carry NULL rows for them.\n20\t  -- Migration 0012 widens this CHECK in existing DBs.\n21\t  kind TEXT NOT NULL CHECK(kind IN ('skill','template','tool','agent','model','paper')),\n22\t  parent_artifact_id INTEGER REFERENCES artifacts(id),\n23\t  slug TEXT NOT NULL,\n24\t  name TEXT NOT NULL,\n25\t  short_description TEXT,\n26\t  description_vec BLOB,  -- I1: gemini-embedding-2 embedding (LE float32); NULL until populated\n27\t  canonical_url TEXT NOT NULL,\n28\t  github_full_name TEXT,\n29\t  github_network_parent TEXT,\n30\t  license TEXT,\n31\t  language TEXT,\n32\t  first_seen_at TEXT NOT NULL,\n33\t  last_verified_at TEXT NOT NULL,\n34\t  last_surfaced_in_summary_at TEXT,\n35\t  retired_at TEXT,\n36\t  -- Wave C Sentinel (2026-05-29): security gate columns. NULL means unscanned\n37\t  -- which means non-servable (fail-CLOSED). Mirrors\n38\t  -- kb/migrations/0019_security.sql for existing DBs.\n39\t  security_status TEXT,\n40\t  security_scanned_arf_version INTEGER,\n41\t  payload_sha256 TEXT,\n42\t  -- Wave 4 (2026-06-10): the persisted taste score. Mirrors\n43\t  -- kb/migrations/0025_interest_score.sql for existing DBs. interest_score is a\n44\t  -- 0..1 interestingness vs docs/INTEREST_PROFILE.md (NULL until scored);\n45\t  -- interest_why is the one-line rationale (NULL on the heuristic-fallback path);\n46\t  -- interest_scored_at is the ISO write time. Written by roles/taste.py;\n47\t  -- consumed by morning_briefing._top_finds + bin/weekly_digest ranking.\n48\t  interest_score REAL,\n49\t  interest_why TEXT,\n50\t  interest_scored_at TEXT,\n51\t  -- Awareness Revamp Wave 2 (2026-06-12): the frontier-relevance ranker score.\n52\t  -- Mirrors kb/migrations/0026_frontier_score.sql for existing DBs. NULL until\n53\t  -- written; in Wave 2 it stays NULL on every cron path (ranker runs SHADOW-only\n54\t  -- via bin/run_ranker_shadow.py). CC1: PUBLISH-CLEAN (a harmless derived numeric).\n55\t  frontier_score REAL,\n56\t  UNIQUE(sweep, slug)\n57\t);\n58\tCREATE INDEX IF NOT EXISTS idx_artifacts_kind ON artifacts(kind);\n59\tCREATE INDEX IF NOT EXISTS idx_artifacts_canonical ON artifacts(canonical_url);\n60\tCREATE INDEX IF NOT EXISTS idx_artifacts_security_status ON artifacts(security_status);\n61\t\n62\t-- aliases: every observed URL points to a canonical artifact_id\n63\tCREATE TABLE IF NOT EXISTS aliases (\n64\t  id INTEGER PRIMARY KEY,\n65\t  artifact_id INTEGER NOT NULL REFERENCES artifacts(id),\n66\t  observed_url TEXT NOT NULL UNIQUE,\n67\t  first_observed_at TEXT NOT NULL\n68\t);\n69\tCREATE INDEX IF NOT EXISTS idx_aliases_artifact ON aliases(artifact_id);\n70\t\n71\t-- sources: every doc that contributed to an artifact.\n72\t-- Wave B item B3 (2026-05-29): excerpt + title + extraction_offsets columns\n73\t-- (mirrors kb/migrations/0017_sources_excerpt.sql). LangExtract writes the\n74\t-- supporting passage to `excerpt`, the source's human-readable title to\n75\t-- `title`, and a JSON {field_name: [start_pos, end_pos]} provenance map to\n76\t-- `extraction_offsets`. NULL on rows written before the adapter ran or by\n77\t-- the LLM-only fallback path. See `roles/langextract_adapter.py`.\n78\tCREATE TABLE IF NOT EXISTS sources (\n79\t  id INTEGER PRIMARY KEY,\n80\t  artifact_id INTEGER NOT NULL REFERENCES artifacts(id),\n81\t  url TEXT NOT NULL,\n82\t  curator TEXT,\n83\t  kind TEXT,\n84\t  fetched_at TEXT NOT NULL,\n85\t  content_sha256 TEXT,\n86\t  excerpt TEXT,\n87\t  title TEXT,\n88\t  extraction_offsets TEXT  -- JSON {field_name: [start_pos, end_pos]}\n89\t);\n90\tCREATE INDEX IF NOT EXISTS idx_sources_artifact ON sources(artifact_id);\n91\t\n92\t-- runs: each nightly sweep\n93\t-- Wave B B6 (2026-05-29): critic_c_status / _calls / _errors mirror\n94\t-- kb/migrations/0015_critic_c_status.sql so virgin DBs start with the\n95\t-- columns. The orchestrator stamps these after walk_pipeline; the morning\n96\t-- briefing rolls them up so degraded mode (no Groq key, rate-limited, etc.)\n97\t-- is visible.\n98\tCREATE TABLE IF NOT EXISTS runs (\n99\t  id INTEGER PRIMARY KEY,\n100\t  sweep TEXT NOT NULL,\n101\t  started_at TEXT NOT NULL,\n102\t  finished_at TEXT,\n103\t  status TEXT,\n104\t  budget_tokens_in INTEGER,\n105\t  budget_tokens_out INTEGER,\n106\t  notes TEXT,\n107\t  seed_map_snapshot BLOB,\n108\t  prompt_template_shas TEXT,\n109\t  model_ids TEXT,\n110\t  critic_c_status TEXT,\n111\t  critic_c_calls INTEGER DEFAULT 0,\n112\t  critic_c_errors INTEGER DEFAULT 0\n113\t);\n114\tCREATE INDEX IF NOT EXISTS idx_runs_sweep_started ON runs(sweep, started_at);\n115\t\n116\t-- validations: every cheap-pass and swarm-pass evaluation\n117\tCREATE TABLE IF NOT EXISTS validations (\n118\t  id INTEGER PRIMARY KEY,\n119\t  artifact_id INTEGER NOT NULL REFERENCES artifacts(id),\n120\t  run_id INTEGER NOT NULL REFERENCES runs(id),\n121\t  stage TEXT NOT NULL,\n122\t  verdict TEXT,\n123\t  score REAL,\n124\t  rationale TEXT,\n125\t  transcript_path TEXT,\n126\t  artifact_bundle_path TEXT\n127\t);\n128\tCREATE INDEX IF NOT EXISTS idx_validations_artifact ON validations(artifact_id);\n129\tCREATE INDEX IF NOT EXISTS idx_validations_run ON validations(run_id);\n130\t\n131\t-- embeddings: hierarchical placement (Axis 1: domain × Axis 2: complexity)\n132\tCREATE TABLE IF NOT EXISTS embeddings (\n133\t  id INTEGER PRIMARY KEY,\n134\t  artifact_id INTEGER NOT NULL REFERENCES artifacts(id),\n135\t  domain_path TEXT,\n136\t  domain_depth INTEGER,\n137\t  complexity_rank INTEGER CHECK(complexity_rank BETWEEN 0 AND 4),\n138\t  embedded_at TEXT NOT NULL\n139\t);\n140\tCREATE INDEX IF NOT EXISTS idx_embeddings_artifact ON embeddings(artifact_id);\n141\t\n142\t-- neural_plasticity: agents only (v3 expanded schema)\n143\tCREATE TABLE IF NOT EXISTS neural_plasticity (\n144\t  artifact_id INTEGER PRIMARY KEY REFERENCES artifacts(id),\n145\t  what_learns TEXT,\n146\t  learning_signal TEXT,\n147\t  what_is_modified TEXT,\n148\t  loss_or_objective TEXT,\n149\t  memory_model TEXT,\n150\t  forgetting_strategy TEXT,\n151\t  consolidation TEXT,\n152\t  long_term_stability_evidence TEXT,\n153\t  failure_modes TEXT,\n154\t  credit_assignment_latency TEXT,\n155\t  update_reversibility TEXT,\n156\t  interference_scope TEXT,\n157\t  memory_write_permissions TEXT,\n158\t  shipped_eval_harness TEXT,\n159\t  last_updated_at TEXT NOT NULL\n160\t);\n161\t\n162\t-- seed_map_edits: REMOVED in Bucket J3 (v4.3, 2026-05-19 PM).\n163\t-- The quarantine-promotion flow was specified in plan §10 but never\n164\t-- implemented; not load-bearing at current 356-artifact scale.\n165\t-- Deferred to ≥500 artifacts. The DROP TABLE below is idempotent and safe\n166\t-- to re-apply.\n167\tDROP TABLE IF EXISTS seed_map_edits;\n168\t\n169\t-- costs: per-call cost tracking (powers exec summary budget line + morning briefing)\n170\tCREATE TABLE IF NOT EXISTS costs (\n171\t  id INTEGER PRIMARY KEY,\n172\t  run_id INTEGER NOT NULL REFERENCES runs(id),\n173\t  role TEXT NOT NULL,\n174\t  vendor TEXT NOT NULL,\n175\t  model_id TEXT NOT NULL,\n176\t  tokens_in INTEGER NOT NULL,\n177\t  tokens_out INTEGER NOT NULL,\n178\t  usd_estimate REAL NOT NULL,\n179\t  recorded_at TEXT NOT NULL,\n180\t  -- 0024 (Wave L1): cache/batch telemetry. Nullable / defaulted so legacy\n181\t  -- 4-arg CostRecorder.record() and pre-0024 rows are unaffected. cache_read\n182\t  -- priced ~0.1x input, cache_write ~1.25x input; batch_mode=1 means the\n183\t  -- usd_estimate already carries the batch discount.\n184\t  cache_read_tokens INTEGER,\n185\t  cache_write_tokens INTEGER,\n186\t  batch_mode INTEGER DEFAULT 0\n187\t);\n188\tCREATE INDEX IF NOT EXISTS idx_costs_run ON costs(run_id);\n189\tCREATE INDEX IF NOT EXISTS idx_costs_vendor_recorded ON costs(vendor, recorded_at);\n190\t\n191\t-- publisher_state: PAT lifecycle + last push\n192\tCREATE TABLE IF NOT EXISTS publisher_state (\n193\t  id INTEGER PRIMARY KEY,\n194\t  pat_created_at TEXT,\n195\t  pat_expires_at TEXT,\n196\t  last_push_at TEXT,\n197\t  last_push_sha TEXT,\n198\t  last_push_status TEXT\n199\t);\n200\t"}]},"parent_tool_use_id":"toolu_01VLkraJFgEdSF3EAkXiHTtu","session_id":"5f986a64-6630-4578-8cdf-92983029246b","uuid":"c275bf0a-bfc5-4d44-9d64-c053e33f63eb","timestamp":"2026-06-23T19:12:37.338Z","subagent_type":"Explore","task_description":"Map Aurora code architecture"}
