{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013YDgQtRKjSbJrXWJdrpxSh","type":"tool_result","content":"1200\t            log.error(\"orchestrator: model_smoke_tester failed: %s\", e)\n1201\t            smoke_summary = f\"smoke: failed ({type(e).__name__})\"\n1202\t\n1203\t    cost_row = conn.execute(\n1204\t        \"SELECT COALESCE(SUM(usd_estimate),0), COALESCE(SUM(tokens_in),0), \"\n1205\t        \"COALESCE(SUM(tokens_out),0) FROM costs WHERE run_id=?\", (run_id,)\n1206\t    ).fetchone()\n1207\t    log.info(\"[7/7] models complete: fetched %d, screened %d, persisted %d, \"\n1208\t             \"cards %d, benchmarks %d, grid models %d; $%.4f spent; %s\",\n1209\t             len(fetched), len(screened), placed, len(written_md), n_bench, n_grid,\n1210\t             cost_row[0], smoke_summary)\n1211\t\n1212\t    return (f\"sweep={cfg.name}; fetched={len(fetched)}; screened {len(screened)} models; \"\n1213\t            f\"placed={placed}; cards={len(written_md)}; benchmarks={n_bench}; \"\n1214\t            f\"grid_models={n_grid}; usd=${cost_row[0]:.4f}; \"\n1215\t            f\"tokens_in={cost_row[1]}; tokens_out={cost_row[2]}; {smoke_summary}\")\n1216\t\n1217\t\n1218\t# ----------------------------------------------------------------------------\n1219\t# Awareness Revamp Wave 2: SHADOW-ONLY retarget (CC2 — never touches live KB)\n1220\t# ----------------------------------------------------------------------------\n1221\t\n1222\tSHADOW_RETARGET_SEED_MAP = ROOT / \"seed_map\" / \"shadow_retarget.yaml\"\n1223\t\n1224\t\n1225\tdef _load_shadow_retarget_seeds() -> list[dict]:\n1226\t    \"\"\"Load the SHADOW-ONLY retarget seeds (seed_map/shadow_retarget.yaml).\n1227\t    These are NEVER loaded by the nightly path — only this shadow branch reads\n1228\t    them. Returns the raw seed dicts (all `enabled: false` + `shadow_only: true`\n1229\t    on disk; the shadow pass enables them in-memory for the shadow fetch only).\"\"\"\n1230\t    import yaml\n1231\t    if not SHADOW_RETARGET_SEED_MAP.exists():\n1232\t        return []\n1233\t    data = yaml.safe_load(SHADOW_RETARGET_SEED_MAP.read_text(encoding=\"utf-8\")) or {}\n1234\t    return list(data.get(\"seeds\", []))\n1235\t\n1236\t\n1237\tdef _run_retarget_shadow(cfg, *, shadow_date: Optional[str]) -> int:\n1238\t    \"\"\"Run the W2 high-signal sources + frontier ranker in SHADOW ONLY.\n1239\t\n1240\t    CC2: opens the live KB STRICTLY read-only (via bin/run_ranker_shadow), runs\n1241\t    the ranker over current artifacts, writes the diff to reports/ranker_shadow/\n1242\t    and (if any rows are persisted) to a SEPARATE shadow DB — NEVER the live\n1243\t    aurora.db. Nothing is promoted to cron. The new sources are loaded from\n1244\t    seed_map/shadow_retarget.yaml and reported (the live shadow FETCH of those\n1245\t    sources is gated by the cost cap + remains shadow-only; in this wave the\n1246\t    deliverable is the reviewable ranker diff + the recall-net proof).\"\"\"\n1247\t    from datetime import date as _date\n1248\t    sys.path.insert(0, str(ROOT / \"bin\"))\n1249\t    import importlib.util\n1250\t\n1251\t    spec = importlib.util.spec_from_file_location(\n1252\t        \"run_ranker_shadow\", ROOT / \"bin\" / \"run_ranker_shadow.py\")\n1253\t    rrs = importlib.util.module_from_spec(spec)\n1254\t    spec.loader.exec_module(rrs)\n1255\t\n1256\t    run_date = shadow_date or _date.today().isoformat()\n1257\t    seeds = _load_shadow_retarget_seeds()\n1258\t    arxiv_seeds = [s for s in seeds if s.get(\"kind\") in (\"arxiv\", \"feed\")]\n1259\t    log.info(\"orchestrator[retarget-shadow]: %d shadow seeds loaded \"\n1260\t             \"(%d arxiv recall-net), date=%s — SHADOW ONLY, live KB read-only\",\n1261\t             len(seeds), len(arxiv_seeds), run_date)\n1262\t\n1263\t    diff = rrs.run_shadow(\n1264\t        db_path=DB_PATH, date=run_date, top_n=50,\n1265\t        persist_diffs=True, dry_run=False,\n1266\t    )\n1267\t    log.info(\"orchestrator[retarget-shadow]: %d artifacts, %d loaded; \"\n1268\t             \"ranker_validated=%s; promotion_eligible=%s; diff -> %s\",\n1269\t             diff[\"n_artifacts\"], diff[\"n_loaded\"], diff[\"ranker_validated\"],\n1270\t             diff[\"promotion_eligible\"], diff.get(\"_written\"))\n1271\t    log.info(\"orchestrator[retarget-shadow]: budget cell 'ranker_shadow' cap \"\n1272\t             \"$%.4f; promotion to cron is a MANUAL step after review\",\n1273\t             PER_ROLE_BUDGET_USD[\"ranker_shadow\"])\n1274\t    return 0\n1275\t\n1276\t\n1277\t# ----------------------------------------------------------------------------\n1278\t# Main\n1279\t# ----------------------------------------------------------------------------\n1280\t\n1281\tdef main(argv: Optional[list[str]] = None) -> int:\n1282\t    load_dotenv(ROOT / \".env\", override=False)\n1283\t\n1284\t    ap = argparse.ArgumentParser(description=\"Aurora nightly sweep orchestrator.\")\n1285\t    ap.add_argument(\"--sweep\", required=True, choices=[\"skills\", \"tools\", \"agents\", \"models\"])\n1286\t    ap.add_argument(\"--dry-run\", action=\"store_true\",\n1287\t                    help=\"Walk the pipeline with no LLM calls or network fetches.\")\n1288\t    ap.add_argument(\"--no-swarm\", action=\"store_true\",\n1289\t                    help=\"Skip runner+critic_a+critic_b+reconciler; embed and file every static-pass candidate.\")\n1290\t    # Bucket L M-2: models-sweep knobs. Parsed now (so the CLI surface is stable\n1291\t    # for scripts/scheduled tasks); wired into the smoke_runner + screener in\n1292\t    # later waves. --providers restricts which vendor keys the smoke runner\n1293\t    # exercises; --top-k caps how many candidates enter the swarm.\n1294\t    ap.add_argument(\"--providers\", default=None,\n1295\t                    help=\"(models sweep) comma-separated provider allowlist, e.g. 'anthropic,google'. \"\n1296\t                         \"Parsed now; used by the smoke runner in a later wave.\")\n1297\t    ap.add_argument(\"--top-k\", type=int, default=None,\n1298\t                    help=\"(models sweep) cap on candidates entering the swarm. \"\n1299\t                         \"Parsed now; used by the screener in a later wave.\")\n1300\t    ap.add_argument(\"--log-level\", default=\"INFO\",\n1301\t                    choices=[\"DEBUG\", \"INFO\", \"WARNING\", \"ERROR\"])\n1302\t    # Awareness Revamp Wave 2 (2026-06-12): SHADOW-ONLY retarget. Default False.\n1303\t    # When UNSET (the cron default) behavior is byte-for-byte unchanged — the\n1304\t    # flag is not consulted anywhere on the live write path below. When SET, the\n1305\t    # orchestrator runs the new high-signal sources + frontier ranker in SHADOW\n1306\t    # against a *_shadow/fixture KB (NEVER the live tables), cost-capped via the\n1307\t    # \"ranker_shadow\" budget cell, and returns WITHOUT opening a live run. CC2:\n1308\t    # zero live-DB writes; off cron; promotion is a documented MANUAL step.\n1309\t    ap.add_argument(\"--retarget-shadow\", action=\"store_true\", default=False,\n1310\t                    help=\"SHADOW-ONLY: run the W2 high-signal sources + frontier \"\n1311\t                         \"ranker against a fixture/shadow KB (never live), \"\n1312\t                         \"cost-capped; nothing is promoted to cron.\")\n1313\t    ap.add_argument(\"--shadow-date\", default=None,\n1314\t                    help=\"(with --retarget-shadow) deterministic run date \"\n1315\t                         \"YYYY-MM-DD for the shadow diff.\")\n1316\t    args = ap.parse_args(argv)\n1317\t\n1318\t    LOG_DIR.mkdir(parents=True, exist_ok=True)\n1319\t    log_file = LOG_DIR / f\"orchestrator-{datetime.now(timezone.utc):%Y%m%dT%H%M%SZ}-{args.sweep}.log\"\n1320\t    logging.basicConfig(\n1321\t        level=args.log_level,\n1322\t        format=\"%(asctime)s %(name)s %(levelname)s  %(message)s\",\n1323\t        handlers=[logging.StreamHandler(sys.stderr), logging.FileHandler(log_file, encoding=\"utf-8\")],\n1324\t    )\n1325\t\n1326\t    cfg = SWEEP_CONFIGS[args.sweep]\n1327\t    if not cfg.seed_map_path.exists():\n1328\t        log.error(\"seed map not found: %s\", cfg.seed_map_path)\n1329\t        return 2\n1330\t\n1331\t    # Awareness Revamp Wave 2 (2026-06-12): SHADOW-ONLY retarget branch. This\n1332\t    # returns BEFORE any live run is opened — the live KB is never touched here.\n1333\t    # CC2: zero live writes, off cron, cost-capped via the \"ranker_shadow\" cell.\n1334\t    # When --retarget-shadow is UNSET this whole block is skipped, so the cron\n1335\t    # default path below is byte-for-byte unchanged.\n1336\t    if args.retarget_shadow:\n1337\t        return _run_retarget_shadow(cfg, shadow_date=args.shadow_date)\n1338\t\n1339\t    with sweep_lock(skip=args.dry_run):\n1340\t        conn = _connect_with_fallback(DB_PATH)\n1341\t        seed_map_text = cfg.seed_map_path.read_text(encoding=\"utf-8\")\n1342\t        prompts_dir = ROOT / \"prompts\"\n1343\t        run_id = open_run(conn, cfg.name, seed_map_text, prompts_dir, args.dry_run)\n1344\t        log.info(\"orchestrator: opened run_id=%s\", run_id)\n1345\t        try:\n1346\t            # Bucket L M-2: route the models sweep to its sibling pipeline. The\n1347\t            # other three sweeps keep the original skill-shaped walk.\n1348\t            if cfg.name == \"models\":\n1349\t                if args.providers:\n1350\t                    log.info(\"orchestrator: --providers=%s (provider allowlist)\",\n1351\t                             args.providers)\n1352\t                providers = (\n1353\t                    {p.strip().lower() for p in args.providers.split(\",\") if p.strip()}\n1354\t                    if args.providers else None\n1355\t                )\n1356\t                notes = asyncio.run(walk_models_pipeline(cfg, conn, run_id,\n1357\t                                                         dry_run=args.dry_run,\n1358\t                                                         no_swarm=args.no_swarm,\n1359\t                                                         top_k=args.top_k,\n1360\t                                                         providers=providers))\n1361\t            else:\n1362\t                notes = asyncio.run(walk_pipeline(cfg, conn, run_id,\n1363\t                                                  dry_run=args.dry_run,\n1364\t                                                  no_swarm=args.no_swarm))\n1365\t            \n1366\t            # Synthesis: Update the thematic literature review for today.\n1367\t            if not args.dry_run:\n1368\t                try:\n1369\t                    # Wave-C: advisor replaces literature_reviewer.\n1370\t                    # Same call shape; advisor produces both the briefing\n1371\t                    # paragraph (daily_syntheses) AND citation-grounded\n1372\t                    # decision-tree artifacts. Keeping lit_reviewer import\n1373\t                    # for 1-week rollback per FINAL_GOLD_STANDARD_REVISION\n1374\t                    # plan.\n1375\t                    advisor_role.run_advisor(conn, run_id)\n1376\t                except Exception as e:\n1377\t                    log.error(\"orchestrator: literature_reviewer failed: %s\", e)\n1378\t\n1379\t            # Bucket G4 (v4.3, 2026-05-19): consult per-run degrade counter\n1380\t            # bumped by llm.py whenever a Sonnet/Gemini call fell back to Haiku.\n1381\t            # Any degrade in a non-dry run -> status='partial' (not 'ok' or 'failed').\n1382\t            from aurora.llm import get_and_clear_degrade_count\n1383\t            degrades = get_and_clear_degrade_count(run_id)\n1384\t            # O-19 follow-up + Wave B B6 (2026-05-29): surface critic_c stats.\n1385\t            # An abstain just means no third-family provider was reachable\n1386\t            # (Ollama/DeepSeek/Groq); the run is still 'ok' but the runs row\n1387\t            # carries the terminal status so the morning briefing can roll up\n1388\t            # \"N fired / N abstained_no_key / N abstained_rate_limited / N\n1389\t            # errored\" honestly. Pre-B6 only the abstain count was tracked in\n1390\t            # memory and lost on process exit — no DB persistence.\n1391\t            from aurora.roles.critic_c import get_and_clear_run_stats as _get_cc_stats\n1392\t            cc_stats = _get_cc_stats(run_id)\n1393\t            cc_abstains = cc_stats[\"abstains\"]\n1394\t            if cc_abstains:\n1395\t                log.info(\"orchestrator: critic_c abstained %d time(s) for run_id=%s \"\n1396\t                         \"(status=%s)\", cc_abstains, run_id, cc_stats[\"status\"])\n1397\t            # Persist to runs row. Guarded by column_exists in case a DB\n1398\t            # somehow predates migration 0015 (defensive — apply_migrations\n1399\t            # ran at startup, but a hand-rolled DB shouldn't crash the close)."}]},"parent_tool_use_id":"toolu_01VLkraJFgEdSF3EAkXiHTtu","session_id":"5f986a64-6630-4578-8cdf-92983029246b","uuid":"cbfcd371-6d40-4093-b5c0-92d3973ee724","timestamp":"2026-06-23T19:12:44.631Z","subagent_type":"Explore","task_description":"Map Aurora code architecture"}
