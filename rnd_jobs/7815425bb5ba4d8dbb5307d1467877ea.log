{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L1SH7kE7QcYJax1wRhRvyu","type":"tool_result","content":"1\t\"\"\"Aurora Dashboard — a locally-served, read-only operator console for the\n2\tnightly multi-agent fleet.\n3\t\n4\tTwo layers, deliberately separated so this can later mount as an Anchor tab:\n5\t\n6\t- ``dashboard.data``  — a Flask-agnostic data-access layer (read-only sqlite +\n7\t  report-file readers). Imports NOTHING web, NOTHING from the Aurora sweep code.\n8\t- ``dashboard.web``   — a thin Flask blueprint over the data layer.\n9\t\n10\tPublic surface:\n11\t    create_blueprint(config)  -> a Flask Blueprint mountable on any Flask app\n12\t    create_app(config=None)   -> a standalone Flask app serving the dashboard\n13\t\"\"\"\n14\tfrom .config import DashboardConfig\n15\tfrom .web.blueprint import create_blueprint\n16\t\n17\t__all__ = [\"DashboardConfig\", \"create_blueprint\", \"create_app\"]\n18\t\n19\t\n20\tdef create_app(config: \"DashboardConfig | None\" = None):\n21\t    \"\"\"Build a standalone Flask app serving the dashboard.\n22\t\n23\t    Kept here (not in web/) so the web layer stays a pure blueprint factory and\n24\t    the Anchor-tab boundary is: ``app.register_blueprint(create_blueprint(cfg))``.\n25\t    \"\"\"\n26\t    from flask import Flask, send_from_directory\n27\t\n28\t    cfg = config or DashboardConfig.default()\n29\t    app = Flask(__name__)\n30\t    bp = create_blueprint(cfg)\n31\t    app.register_blueprint(bp)\n32\t\n33\t    static_dir = cfg.static_dir\n34\t\n35\t    @app.route(\"/\")\n36\t    def _index():\n37\t        return send_from_directory(static_dir, \"dashboard.html\")\n38\t\n39\t    return app\n40\t"}]},"parent_tool_use_id":"toolu_01VLkraJFgEdSF3EAkXiHTtu","session_id":"5f986a64-6630-4578-8cdf-92983029246b","uuid":"7890033a-ff67-49d6-ba24-0cdc79468c7f","timestamp":"2026-06-23T19:12:32.795Z","subagent_type":"Explore","task_description":"Map Aurora code architecture"}
