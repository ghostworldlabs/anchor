{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vs6GwdywAfi5qeF4TXkccF","type":"tool_result","content":"1000\t                break\n1001\t            if time.monotonic() >= deadline:\n1002\t                _note_degrade(\n1003\t                    cost_recorder,\n1004\t                    f\"submit_anthropic_batch poll timeout ({timeout:.0f}s) — \"\n1005\t                    f\"degrading {len(all_ids)} item(s) to synchronous\",\n1006\t                )\n1007\t                return BatchCollectResult(batch_id=getattr(batch, \"id\", None),\n1008\t                                          texts={}, failed=set(all_ids))\n1009\t            time.sleep(interval)\n1010\t            batch = _batches_retrieve(client, batch.id)\n1011\t        results = _batches_results(client, batch.id)\n1012\t    except Exception as e:  # noqa: BLE001 — a batch outage degrades, never aborts\n1013\t        _note_degrade(\n1014\t            cost_recorder,\n1015\t            f\"submit_anthropic_batch {type(e).__name__} — degrading \"\n1016\t            f\"{len(all_ids)} item(s) to synchronous: {str(e)[:160]}\",\n1017\t        )\n1018\t        return BatchCollectResult(batch_id=None, texts={}, failed=set(all_ids))\n1019\t\n1020\t    texts: dict[str, str] = {}\n1021\t    seen: set[str] = set()\n1022\t    failed: set[str] = set()\n1023\t    for r in results:\n1024\t        cid = getattr(r, \"custom_id\", None)\n1025\t        if cid is None:\n1026\t            continue\n1027\t        seen.add(cid)\n1028\t        res = getattr(r, \"result\", None)\n1029\t        if getattr(res, \"type\", None) == \"succeeded\":\n1030\t            message = res.message\n1031\t            _meter_batch_result(cost_recorder, message)\n1032\t            texts[cid] = batch_result_text(\n1033\t                message, structured=structured_by_id.get(cid, False))\n1034\t        else:\n1035\t            # errored / expired / canceled -> degrade this item synchronously.\n1036\t            failed.add(cid)\n1037\t            _note_degrade(\n1038\t                cost_recorder,\n1039\t                f\"batch item {cid} result={getattr(res, 'type', 'missing')} \"\n1040\t                \"— degrading to synchronous\",\n1041\t            )\n1042\t    # Any submitted id that produced NO result row at all also fails closed.\n1043\t    for cid in all_ids - seen:\n1044\t        failed.add(cid)\n1045\t        _note_degrade(\n1046\t            cost_recorder,\n1047\t            f\"batch item {cid} produced no result — degrading to synchronous\",\n1048\t        )\n1049\t    return BatchCollectResult(batch_id=getattr(batch, \"id\", None),\n1050\t                              texts=texts, failed=failed)\n1051\t\n1052\t\n1053\tdef call_gemini(prompt: str, *, model: Optional[str] = None, max_tokens: int = 600,\n1054\t                cost_recorder: Optional[CostRecorder] = None,\n1055\t                role_hint: str = \"gemini\",\n1056\t                system: Optional[str] = None) -> str:\n1057\t    \"\"\"Call Gemini API. Falls back to Anthropic if GEMINI_API_KEY is unset or\n1058\t    if AURORA_CRITIC_B_PROVIDER=local.\"\"\"\n1059\t    provider = os.environ.get(\"AURORA_CRITIC_B_PROVIDER\", \"gemini\").strip().lower()\n1060\t    if gemini_disabled() or provider == \"local\" or not os.environ.get(\"GEMINI_API_KEY\"):\n1061\t        log.info(\"call_gemini: routing to Anthropic Haiku (gemini_disabled=%s provider=%s)\",\n1062\t                 gemini_disabled(), provider)\n1063\t        return call_anthropic(prompt, model=HAIKU_DEFAULT,\n1064\t                              max_tokens=max_tokens, cost_recorder=cost_recorder,\n1065\t                              role_hint=role_hint + \"_fallback\", system=system)\n1066\t    try:\n1067\t        import google.generativeai as genai\n1068\t    except ModuleNotFoundError:\n1069\t        log.warning(\"call_gemini: google-generativeai not installed; falling back to Anthropic\")\n1070\t        return call_anthropic(prompt, model=HAIKU_DEFAULT,\n1071\t                              max_tokens=max_tokens, cost_recorder=cost_recorder,\n1072\t                              role_hint=role_hint + \"_fallback\", system=system)\n1073\t    genai.configure(api_key=os.environ[\"GEMINI_API_KEY\"])\n1074\t    # Bucket G2 (v4.3): default to gemini-3.5-flash. Thinking-off-by-default,\n1075\t    # 6x cheaper ($0.15/$0.60 per MTok), sidesteps the MAX_TOKENS-on-thinking bug.\n1076\t    mdl_name = model or os.environ.get(\"AURORA_CRITIC_B_MODEL\", GEMINI_DEFAULT)\n1077\t    model_obj = genai.GenerativeModel(mdl_name, system_instruction=system)\n1078\t    # Bump output cap to reduce MAX_TOKENS truncation; reasoning models often\n1079\t    # spend many tokens on hidden thinking before emitting any text.\n1080\t    base_cfg = {\"max_output_tokens\": max(2048, max_tokens * 4)}\n1081\t    # 2026-06-05 (cost-audit): DISABLE thinking. The old comment here claimed\n1082\t    # gemini-3.5-flash was \"thinking-off-by-default, 6x cheaper\" — that was WRONG\n1083\t    # (it described gemini-2.5-flash-lite, critic_b's model). gemini-3.5-flash is a\n1084\t    # reasoning model whose hidden \"thoughts\" tokens are billed by Google at the\n1085\t    # output rate but were NEVER recorded here (candidates_token_count only) — the\n1086\t    # root cause of the May Gemini bill ($118, +9746%). thinking_budget=0 turns it\n1087\t    # off; if this SDK build rejects the field we retry without it (no regression),\n1088\t    # and the thoughts_token_count guard below flags any residual thinking.\n1089\t    cfg = {**base_cfg, \"thinking_config\": {\"thinking_budget\": 0}}\n1090\t    try:\n1091\t        try:\n1092\t            resp = _gemini_generate(model_obj, prompt, cfg)\n1093\t        except (TypeError, AttributeError, KeyError) as cfg_err:\n1094\t            log.warning(\"call_gemini: thinking-disable config rejected (%s); retrying \"\n1095\t                        \"without it — VERIFY thinking is off for %s\",\n1096\t                        type(cfg_err).__name__, mdl_name)\n1097\t            resp = _gemini_generate(model_obj, prompt, base_cfg)\n1098\t    except Exception as e:\n1099\t        _note_degrade(cost_recorder, f\"call_gemini {type(e).__name__} on {mdl_name} -> Haiku\")\n1100\t        return call_anthropic(prompt, model=HAIKU_DEFAULT,\n1101\t                              max_tokens=max_tokens, cost_recorder=cost_recorder,\n1102\t                              role_hint=role_hint + \"_fallback\", system=system)\n1103\t    # `.text` raises ValueError when finish_reason != STOP. Pull parts manually.\n1104\t    text = \"\"\n1105\t    try:\n1106\t        text = resp.text or \"\"\n1107\t    except ValueError:\n1108\t        try:\n1109\t            for cand in (resp.candidates or []):\n1110\t                for part in (cand.content.parts or []):\n1111\t                    if getattr(part, \"text\", None):\n1112\t                        text += part.text\n1113\t        except Exception:\n1114\t            text = \"\"\n1115\t    if not text:\n1116\t        _note_degrade(cost_recorder, \"call_gemini empty response -> Haiku\")\n1117\t        return call_anthropic(prompt, model=HAIKU_DEFAULT,\n1118\t                              max_tokens=max_tokens, cost_recorder=cost_recorder,\n1119\t                              role_hint=role_hint + \"_fallback\", system=system)\n1120\t    usage = getattr(resp, \"usage_metadata\", None)\n1121\t    tokens_in = getattr(usage, \"prompt_token_count\", 0) if usage else 0\n1122\t    tokens_out = getattr(usage, \"candidates_token_count\", 0) if usage else 0\n1123\t    # 2026-06-05 (cost-audit): fold billed thinking tokens into tokens_out (Google\n1124\t    # bills them at the output rate). These were dropped before, hiding the real\n1125\t    # cost. Warn loudly if a model still thinks despite the disable above.\n1126\t    thoughts = getattr(usage, \"thoughts_token_count\", 0) if usage else 0\n1127\t    if thoughts:\n1128\t        log.warning(\"call_gemini: %s billed %d thinking token(s) — thinking-disable did \"\n1129\t                    \"NOT take; investigate (see cost-audit-2026-06-05)\", mdl_name, thoughts)\n1130\t        tokens_out += thoughts\n1131\t    if cost_recorder is not None:\n1132\t        cost_recorder.record(\"gemini\", mdl_name, tokens_in, tokens_out)\n1133\t    return text\n1134\t\n1135\t\n1136\tdef call_gemini_embedding(text: str, *, model: str = \"models/text-embedding-004\",\n1137\t                         cost_recorder: Optional[CostRecorder] = None) -> list[float]:\n1138\t    \"\"\"Call Gemini Embedding API. Uses models/text-embedding-004 (or the new\n1139\t    gemini-embedding-2 in May 2026). Records cost.\"\"\"\n1140\t    if gemini_disabled():\n1141\t        log.warning(\"call_gemini_embedding: AURORA_DISABLE_GEMINI set — skipping embed (returns []).\")\n1142\t        return []\n1143\t    try:\n1144\t        import google.generativeai as genai\n1145\t    except ModuleNotFoundError:\n1146\t        log.error(\"call_gemini_embedding: google-generativeai not installed\")\n1147\t        return []\n1148\t    \n1149\t    api_key = os.environ.get(\"GEMINI_API_KEY\")\n1150\t    if not api_key:\n1151\t        log.error(\"call_gemini_embedding: GEMINI_API_KEY missing\")\n1152\t        return []\n1153\t        \n1154\t    genai.configure(api_key=api_key)\n1155\t    \n1156\t    # Bucket I1 (v4.3, 2026-05-21): migrate to Gemini Embedding 2.\n1157\t    # leading leaderboards, 10x cheaper than Voyage, multimodal.\n1158\t    mdl = model if \"embedding\" in model else \"models/gemini-embedding-2\"\n1159\t    \n1160\t    @retry(retry=retry_if_exception(_is_retryable_genai), **_RETRY_KW)\n1161\t    def _do_embed():\n1162\t        return genai.embed_content(model=mdl, content=text, task_type=\"retrieval_document\")\n1163\t\n1164\t    try:\n1165\t        resp = _do_embed()\n1166\t        vec = resp.get(\"embedding\", [])\n1167\t        if cost_recorder is not None:\n1168\t            # Embedding models often charge by character or token; Gemini 2.0+ \n1169\t            # is token-based. Estimate 1 token per 4 chars if usage is missing.\n1170\t            usage = resp.get(\"usage\", {})\n1171\t            tokens = usage.get(\"prompt_token_count\", len(text) // 4)\n1172\t            cost_recorder.record(\"gemini\", mdl, tokens, 0)\n1173\t        return vec\n1174\t    except Exception as e:\n1175\t        log.error(\"call_gemini_embedding failed: %s\", e)\n1176\t        return []\n1177\t\n1178\t\n1179\tdef call_model(prompt: str, *, model: str, max_tokens: int = 600,\n1180\t               cost_recorder: Optional[CostRecorder] = None,\n1181\t               role_hint: str = \"llm\",\n1182\t               system: Optional[str] = None,\n1183\t               cache_system: bool = False,\n1184\t               output_schema: Optional[dict] = None,\n1185\t               effort: Optional[str] = None) -> str:\n1186\t    \"\"\"Unified entry point that dispatches to Anthropic or Gemini based on model ID.\n1187\t\n1188\t    Wave L2 (2026-06-07): `cache_system` is honoured only on the Anthropic path\n1189\t    (prompt caching is an Anthropic-Messages feature). The Gemini path ignores\n1190\t    it — Gemini has its own implicit caching the cost substrate doesn't meter\n1191\t    here — so a Gemini-routed role never errors on the kwarg and behaves exactly\n1192\t    as before.\n1193\t\n1194\t    Wave L3 (2026-06-07): `output_schema` is likewise Anthropic-only — it drives\n1195\t    `call_anthropic`'s strict forced-tool-use structured output. The Gemini path\n1196\t    DELIBERATELY ignores it and keeps its existing free-form text response (the\n1197\t    Gemini-routed roles still parse via json.loads(strip_fences(...))). This is\n1198\t    why a role that may be Gemini-overridden (critic_a via AURORA_CRITIC_A_MODEL)\n1199\t    passes output_schema through here: the schema only engages when the model"}]},"parent_tool_use_id":"toolu_01VLkraJFgEdSF3EAkXiHTtu","session_id":"5f986a64-6630-4578-8cdf-92983029246b","uuid":"69913215-aeac-4dfb-be8a-1bc6a2011347","timestamp":"2026-06-23T19:13:10.331Z","subagent_type":"Explore","task_description":"Map Aurora code architecture"}
