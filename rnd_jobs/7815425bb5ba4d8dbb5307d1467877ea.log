{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019uAht8jgLgbQvxZdBR96tB","type":"tool_result","content":"500\t\n501\t\n502\tdef _connect_with_fallback(db_path: Path) -> sqlite3.Connection:\n503\t    try:\n504\t        conn = _smoke_open(db_path)\n505\t        _ensure_schema(conn)\n506\t        return conn\n507\t    except sqlite3.OperationalError as e:\n508\t        if \"I/O\" not in str(e) and \"locking\" not in str(e).lower():\n509\t            raise\n510\t        log.warning(\"orchestrator: sqlite I/O unsupported on this mount; staging in /tmp\")\n511\t        staging_dir = Path(tempfile.mkdtemp(prefix=\"aurora-sql-\"))\n512\t        staging = staging_dir / \"aurora.db\"\n513\t        if db_path.exists():\n514\t            shutil.copy2(db_path, staging)\n515\t        conn = _smoke_open(staging)\n516\t        _ensure_schema(conn)\n517\t        _STAGING[id(conn)] = (db_path, staging)\n518\t        return conn\n519\t\n520\t\n521\tdef _close_with_fallback(conn: sqlite3.Connection) -> None:\n522\t    pair = _STAGING.pop(id(conn), None)\n523\t    conn.close()\n524\t    if pair is not None:\n525\t        dest, staging = pair\n526\t        shutil.copy2(staging, dest)\n527\t\n528\t\n529\t# ----------------------------------------------------------------------------\n530\t# Run lifecycle\n531\t# ----------------------------------------------------------------------------\n532\t\n533\tdef _hash_text(s: str) -> str:\n534\t    return hashlib.sha256(s.encode(\"utf-8\")).hexdigest()[:16]\n535\t\n536\t\n537\tdef open_run(conn: sqlite3.Connection, sweep_name: str, seed_map_text: str,\n538\t             prompts_dir: Path, dry_run: bool) -> int:\n539\t    started = datetime.now(timezone.utc).isoformat()\n540\t    prompt_shas: dict[str, str] = {}\n541\t    if prompts_dir.exists():\n542\t        for p in sorted(prompts_dir.glob(\"**/*.md\")):\n543\t            prompt_shas[str(p.relative_to(prompts_dir))] = _hash_text(p.read_text(encoding=\"utf-8\"))\n544\t    # Wave L5 (2026-06-07): per-role model defaults were ALREADY on current tiers\n545\t    # (Sonnet 4.6 / Haiku 4.5 / Gemini 3.5-flash — all priced, non-$0 keys in\n546\t    # kb/pricing.yaml; no deprecated Opus 4/4.1 anywhere), so L5 changed nothing\n547\t    # in the default path here. Retargeting is done by setting an AURORA_*_MODEL\n548\t    # env override. NOTE: this dict is snapshotted into the `runs` table for\n549\t    # provenance; the live model each role uses is read from the same env var by\n550\t    # the role itself (e.g. roles/runner.py also reads AURORA_RUNNER_MODEL), so\n551\t    # this is NOT the sole selection point — keep the fallback defaults in sync.\n552\t    # L5's concrete change: the current Opus tier (claude-opus-4-8) is now priced\n553\t    # + cache-rated in pricing.yaml, so an AURORA_RUNNER_MODEL=claude-opus-4-8\n554\t    # override meters correctly instead of recording $0; the default path stays\n555\t    # on Sonnet (cheaper) and never silently selects Opus.\n556\t    model_ids = {\n557\t        \"scout\":      os.environ.get(\"AURORA_SCOUT_MODEL\", \"gemini-3.5-flash\"),\n558\t        \"runner\":     os.environ.get(\"AURORA_RUNNER_MODEL\", \"claude-sonnet-4-6\"),\n559\t        \"critic_a\":   os.environ.get(\"AURORA_CRITIC_A_MODEL\", \"claude-sonnet-4-6\"),\n560\t        \"critic_b\":   os.environ.get(\"AURORA_CRITIC_B_MODEL\", \"gemini-3.5-flash\"),\n561\t        \"reconciler\": os.environ.get(\"AURORA_RECONCILER_MODEL\", \"claude-sonnet-4-6\"),\n562\t        \"embedder\":   os.environ.get(\"AURORA_EMBEDDER_MODEL\", \"gemini-3.5-flash\"),\n563\t        \"librarian\":  os.environ.get(\"AURORA_LIBRARIAN_MODEL\", \"gemini-3.5-flash\"),\n564\t    }\n565\t    cur = conn.execute(\n566\t        \"INSERT INTO runs (sweep, started_at, status, seed_map_snapshot, \"\n567\t        \"prompt_template_shas, model_ids) VALUES (?, ?, ?, ?, ?, ?)\",\n568\t        (\n569\t            sweep_name, started,\n570\t            \"dry_run\" if dry_run else \"running\",\n571\t            seed_map_text.encode(\"utf-8\"),\n572\t            json.dumps(prompt_shas, sort_keys=True),\n573\t            json.dumps(model_ids, sort_keys=True),\n574\t        ),\n575\t    )\n576\t    conn.commit()\n577\t    return cur.lastrowid\n578\t\n579\t\n580\tdef close_run(conn: sqlite3.Connection, run_id: int, *, status: str,\n581\t              notes: str = \"\") -> None:\n582\t    conn.execute(\n583\t        \"UPDATE runs SET finished_at = ?, status = ?, notes = ? WHERE id = ?\",\n584\t        (datetime.now(timezone.utc).isoformat(), status, notes, run_id),\n585\t    )\n586\t    conn.commit()\n587\t\n588\t\n589\tdef _persist_sanitizer_telemetry(conn: sqlite3.Connection, run_id: int,\n590\t                                 n_injections: int) -> None:\n591\t    \"\"\"Wave 1 (2026-06-02): stamp the sanitizer's per-run injection count onto\n592\t    the runs row so the morning briefing's Telemetry section can render it.\n593\t\n594\t    Guarded by column_exists so a DB that somehow predates migration 0020\n595\t    (hand-rolled, or apply_migrations skipped) never crashes the sweep — the\n596\t    telemetry is best-effort, exactly like the critic_c stamp below.\"\"\"\n597\t    try:\n598\t        from aurora.kb.migrate import column_exists\n599\t        if column_exists(conn, \"runs\", \"sanitizer_n_injections\"):\n600\t            conn.execute(\n601\t                \"UPDATE runs SET sanitizer_n_injections=? WHERE id=?\",\n602\t                (int(n_injections), run_id),\n603\t            )\n604\t            conn.commit()\n605\t    except Exception as e:  # noqa: BLE001 — never block a sweep on telemetry\n606\t        log.warning(\"orchestrator: failed to persist sanitizer telemetry for \"\n607\t                    \"run_id=%s: %s\", run_id, e)\n608\t\n609\t\n610\t# ----------------------------------------------------------------------------\n611\t# Pipeline walk\n612\t# ----------------------------------------------------------------------------\n613\t\n614\tasync def walk_pipeline(cfg: SweepConfig, conn: sqlite3.Connection, run_id: int, *,\n615\t                        dry_run: bool, no_swarm: bool) -> str:\n616\t    log.info(\"─\" * 60)\n617\t    log.info(\"Sweep: %s  run_id=%s  dry_run=%s  no_swarm=%s\",\n618\t             cfg.name, run_id, dry_run, no_swarm)\n619\t    log.info(\"─\" * 60)\n620\t\n621\t    seed_map = yaml.safe_load(cfg.seed_map_path.read_text(encoding=\"utf-8\"))\n622\t    log.info(\"[1/8] seed_map loaded: %s\", cfg.seed_map_path.name)\n623\t\n624\t    # Bucket O-21 follow-up (2026-05-23): drain the embeddings_pending queue\n625\t    # at the start of every sweep. Cheap when the queue is empty (single\n626\t    # SELECT). Runs inside the held sweep_lock — no separate lock needed.\n627\t    if not dry_run:\n628\t        drain_cost = CostRecorder(conn, run_id, \"embedder\")\n629\t        drain_result = embedder.drain_pending(conn, cost_recorder=drain_cost,\n630\t                                              max_items=int(os.environ.get(\n631\t                                                  \"AURORA_DRAIN_MAX_ITEMS\", \"10\")))\n632\t        if drain_result[\"attempted\"]:\n633\t            log.info(\"[0/8] embeddings_pending drain: attempted=%d succeeded=%d still_failing=%d\",\n634\t                     drain_result[\"attempted\"], drain_result[\"succeeded\"],\n635\t                     drain_result[\"still_failing\"])\n636\t\n637\t    # Wave 5 (2026-06-06): scout memory — prioritize historically high-yield\n638\t    # seeds (exploit) while reserving a slice for new ones (explore). Yields are\n639\t    # computed from prior sweeps' attributed artifacts; best-effort. Ordering is\n640\t    # active as soon as yield history exists; the explore/exploit BUDGET CAP\n641\t    # (which skips some low-yield seeds to spend a measurable slice on new ones)\n642\t    # is opt-in via AURORA_SCOUT_BUDGET so the default nightly coverage is never\n643\t    # silently reduced. None -> fetch all (ordered).\n644\t    scout_yields = None\n645\t    if not dry_run:\n646\t        try:\n647\t            from aurora.roles import source_reputation\n648\t            scout_yields = source_reputation.compute_yield(conn) or None\n649\t        except Exception as e:  # noqa: BLE001 — never break the sweep on memory"}]},"parent_tool_use_id":"toolu_01VLkraJFgEdSF3EAkXiHTtu","session_id":"5f986a64-6630-4578-8cdf-92983029246b","uuid":"03856338-7170-4966-a3aa-91dc02376e2c","timestamp":"2026-06-23T19:12:46.871Z","subagent_type":"Explore","task_description":"Map Aurora code architecture"}
