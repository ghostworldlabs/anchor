ses the real resp.usage counts (ground truth). claude-opus-4-6 is\n35\t    # kept above (still a live, priced, active tier).\n36\t    claude-opus-4-8:\n37\t      tokens_in_per_million_usd: 5.0\n38\t      tokens_out_per_million_usd: 25.0\n39\t      cache_read_per_million_usd: 0.5\n40\t      cache_write_per_million_usd: 6.25\n41\t      tokenizer_factor: 1.35\n42\t  gemini:\n43\t    # Wave 4 (2026-06-06): per-rate verification status lives in the top-level\n44\t    # `verification:` block below (machine-readable; the cost rollup can flag\n45\t    # estimate-priced spend). gemini-3.5-flash and gemini-embedding-2 remain\n46\t    # ESTIMATES — no published Google SKU to pin them to — so they are flagged\n47\t    # verified:false there. The unmetered MCP query-embedding path the\n48\t    # cost-audit suspected is now closed (server.py:_embed_query meters into\n49\t    # costs). gemini-2.5-pro/flash are real published Google rates;\n50\t    # text-embedding-004 is a best-effort estimate (flagged verified:false too).\n51\t    # See reports/cost-audit-2026-06-05.md.\n52\t    gemini-3.5-flash:\n53\t      tokens_in_per_million_usd: 1.5\n54\t      tokens_out_per_million_usd: 9.0\n55\t    gemini-embedding-2:        # priced for the bare key AND `models/gemini-embedding-2` (lookup strips the prefix)\n56\t      tokens_in_per_million_usd: 0.2\n57\t      tokens_out_per_million_usd: 0.0\n58\t    text-embedding-004:        # legacy embedder default in llm.call_gemini_embedding\n59\t      tokens_in_per_million_usd: 0.2\n60\t      tokens_out_per_million_usd: 0.0\n61\t    gemini-2.5-pro:\n62\t      tokens_in_per_million_usd: 1.25\n63\t      tokens_out_per_million_usd: 10.0\n64\t    gemini-2.5-flash:\n65\t      tokens_in_per_million_usd: 0.3\n66\t      tokens_out_per_million_usd: 2.5\n67\t  deepseek:\n68\t    deepseek-chat:\n69\t      tokens_in_per_million_usd: 0.27\n70\t      tokens_out_per_million_usd: 1.10\n71\t  groq:\n72\t    llama-3.3-70b-versatile:\n73\t      tokens_in_per_million_usd: 0.59\n74\t      tokens_out_per_million_usd: 0.79\n75\t  local:\n76\t    default:\n77\t      tokens_in_per_million_usd: 0.0\n78\t      tokens_out_per_million_usd: 0.0\n79\tdefault_models:\n80\t  scout:\n81\t    vendor: gemini\n82\t    model: gemini-3.5-flash\n83\t  runner:\n84\t    vendor: anthropic\n85\t    model: claude-sonnet-4-6\n86\t  critic_a:\n87\t    vendor: anthropic\n88\t    model: claude-sonnet-4-6\n89\t  critic_b:\n90\t    vendor: gemini\n91\t    model: gemini-3.5-flash\n92\t  reconciler:\n93\t    vendor: anthropic\n94\t    model: claude-sonnet-4-6\n95\t  embedder:\n96\t    vendor: gemini\n97\t    model: gemini-3.5-flash\n98\t  librarian:\n99\t    vendor: gemini\n100\t    model: gemini-3.5-flash"}]},"parent_tool_use_id":"toolu_01VLkraJFgEdSF3EAkXiHTtu","session_id":"5f986a64-6630-4578-8cdf-92983029246b","uuid":"9dde1587-112e-4e10-b0a6-1ff8f4afc94e","timestamp":"2026-06-23T19:13:01.070Z","subagent_type":"Explore","task_description":"Map Aurora code architecture"}
