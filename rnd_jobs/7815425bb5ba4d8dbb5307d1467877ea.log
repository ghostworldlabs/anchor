{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0184Hpk8XHeGmaYpd1tV4JD4","type":"tool_result","content":"1\t\"\"\"Scout — fetches against the seed map.\n2\t\n3\tSupported kinds:\n4\t  - local_mount: walk a directory; emit FetchedSource per SKILL.md (P2)\n5\t  - repo: read GitHub repo + walk for SKILL.md / *.md (P3)\n6\t  - awesome_list: fetch README.md, extract markdown links pointing to repos (P3)\n7\t  - topic_crawl: GitHub Search API for repos with the topic (P3)\n8\t  - rss: feedparser (P3)\n9\t  - arxiv: arxiv API XML (P3)\n10\t  - hub / directory / marketplace / doc_site / blog / forum / reddit: deferred to P4+\n11\t\n12\tAll HTTP fetches respect AURORA_MAX_FETCH globally and a per-host rate-limit\n13\tof 1 req/s. GitHub API calls use GH_TOKEN from .env if present (5K/hr); else\n14\tanonymous (60/hr).\n15\t\"\"\"\n16\tfrom __future__ import annotations\n17\timport asyncio\n18\timport logging\n19\timport os\n20\timport re\n21\tfrom datetime import datetime, timezone\n22\tfrom pathlib import Path\n23\tfrom typing import Optional\n24\tfrom .contracts import FetchedSource\n25\t\n26\tlog = logging.getLogger(__name__)\n27\t\n28\t\n29\t# ---------------------------------------------------------------------------\n30\t# Helpers\n31\t# ---------------------------------------------------------------------------\n32\t\n33\tdef _now_iso() -> str:\n34\t    return datetime.now(timezone.utc).isoformat()\n35\t\n36\t\n37\tdef _max_fetch() -> Optional[int]:\n38\t    n = int(os.environ.get(\"AURORA_MAX_FETCH\", \"0\"))\n39\t    return n if n > 0 else None\n40\t\n41\t\n42\tdef _gh_token() -> Optional[str]:\n43\t    return (os.environ.get(\"GH_TOKEN\") or os.environ.get(\"GITHUB_TOKEN\")\n44\t            or os.environ.get(\"GITHUB_PAT\") or None)\n45\t\n46\t\n47\tdef _gh_headers() -> dict:\n48\t    h = {\"Accept\": \"application/vnd.github+json\",\n49\t         \"X-GitHub-Api-Version\": \"2022-11-28\",\n50\t         \"User-Agent\": \"aurora-scout/0.1\"}\n51\t    tok = _gh_token()\n52\t    if tok:\n53\t        h[\"Authorization\"] = f\"Bearer {tok}\"\n54\t    return h\n55\t\n56\t\n57\t_HOST_LAST: dict[str, float] = {}\n58\t\n59\t\n60\tasync def _per_host_throttle(url: str) -> None:\n61\t    \"\"\"Naive per-host 1 req/sec throttle.\"\"\"\n62\t    import time\n63\t    m = re.match(r\"https?://([^/]+)\", url)\n64\t    if not m:\n65\t        return\n66\t    host = m.group(1)\n67\t    now = time.monotonic()\n68\t    last = _HOST_LAST.get(host, 0.0)\n69\t    delay = 1.0 - (now - last)\n70\t    if delay > 0:\n71\t        await asyncio.sleep(delay)\n72\t    _HOST_LAST[host] = time.monotonic()\n73\t\n74\t\n75\t# ---------------------------------------------------------------------------\n76\t# kind=local_mount\n77\t# ---------------------------------------------------------------------------\n78\t\n79\tdef _fetch_local_mount(seed: dict) -> list[FetchedSource]:\n80\t    root = Path(seed[\"url\"])\n81\t    out: list[FetchedSource] = []\n82\t    if not root.exists():\n83\t        log.warning(\"scout.local_mount: root does not exist: %s\", root)\n84\t        return out\n85\t    cap = _max_fetch()\n86\t    for child in sorted(root.iterdir()):\n87\t        if not child.is_dir():\n88\t            continue\n89\t        md = child / \"SKILL.md\"\n90\t        if not md.exists():\n91\t            continue\n92\t        try:\n93\t            content = md.read_text(encoding=\"utf-8\")\n94\t        except OSError as e:\n95\t            log.warning(\"scout.local_mount: failed to read %s: %s\", md, e)\n96\t            continue\n97\t        out.append(FetchedSource(\n98\t            seed_id=seed[\"id\"],\n99\t            url=f\"file://{md}\",\n100\t            curator=seed[\"curator\"],"}]},"parent_tool_use_id":"toolu_01VLkraJFgEdSF3EAkXiHTtu","session_id":"5f986a64-6630-4578-8cdf-92983029246b","uuid":"d43da90a-12bc-4dd0-b750-ef3775adcdf0","timestamp":"2026-06-23T19:13:23.480Z","subagent_type":"Explore","task_description":"Map Aurora code architecture"}
