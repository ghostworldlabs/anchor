{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019isU5pYQmW1SFn1XDYE2wJ","type":"tool_result","content":"1\t\"\"\"Per-sweep configuration. The orchestrator dispatches by name; each sweep\n2\tspecifies the seed-map path, the prompt templates to use, and per-sweep\n3\tbudget knobs.\"\"\"\n4\tfrom __future__ import annotations\n5\tfrom dataclasses import dataclass\n6\tfrom pathlib import Path\n7\tfrom typing import Literal\n8\t\n9\t\n10\t@dataclass(frozen=True)\n11\tclass SweepConfig:\n12\t    name: Literal[\"skills\", \"tools\", \"agents\", \"models\"]\n13\t    seed_map_path: Path\n14\t    top_k_floor: int\n15\t    top_k_ceiling: int\n16\t    runner_timeout_seconds: int\n17\t    # Tokens-in / tokens-out budgets are applied uniformly (§13) but a sweep\n18\t    # can override here.\n19\t    budget_tokens_in: int = 600_000\n20\t    budget_tokens_out: int = 150_000\n21\t\n22\t\n23\t_root = Path(__file__).resolve().parent.parent\n24\tSEED = _root / \"seed_map\"\n25\t\n26\tSWEEP_CONFIGS: dict[str, SweepConfig] = {\n27\t    \"skills\": SweepConfig(\n28\t        name=\"skills\",\n29\t        seed_map_path=SEED / \"skills.yaml\",\n30\t        top_k_floor=2,\n31\t        top_k_ceiling=8,\n32\t        runner_timeout_seconds=180,    # skills are quick to exercise\n33\t    ),\n34\t    \"tools\": SweepConfig(\n35\t        name=\"tools\",\n36\t        seed_map_path=SEED / \"tools.yaml\",\n37\t        top_k_floor=2,\n38\t        top_k_ceiling=8,\n39\t        runner_timeout_seconds=300,\n40\t    ),\n41\t    \"agents\": SweepConfig(\n42\t        name=\"agents\",\n43\t        seed_map_path=SEED / \"agents.yaml\",\n44\t        top_k_floor=2,\n45\t        top_k_ceiling=8,\n46\t        runner_timeout_seconds=600,    # agents need longer end-to-end runs\n47\t    ),\n48\t    # Bucket L (v3.3, 2026-05-20): Models sweep. The runner stage is replaced by\n49\t    # the smoke_runner (1-token live call per provider key) in a later wave; for\n50\t    # now this config feeds walk_models_pipeline's skeleton. Timeout sits between\n51\t    # tools and agents — the per-candidate work is a tiny smoke call plus\n52\t    # card-parse, not an end-to-end agent run.\n53\t    \"models\": SweepConfig(\n54\t        name=\"models\",\n55\t        seed_map_path=SEED / \"models.yaml\",\n56\t        top_k_floor=2,\n57\t        top_k_ceiling=8,\n58\t        runner_timeout_seconds=300,\n59\t    ),\n60\t}\n61\t"}]},"parent_tool_use_id":"toolu_01VLkraJFgEdSF3EAkXiHTtu","session_id":"5f986a64-6630-4578-8cdf-92983029246b","uuid":"aa94ca83-3840-4b67-b52d-ba4f577ddfab","timestamp":"2026-06-23T19:12:42.897Z","subagent_type":"Explore","task_description":"Map Aurora code architecture"}
