{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QSzAddbQiRfaUCNcV7RoUf","type":"tool_result","content":"1\t\"\"\"Dashboard configuration — all paths the read-only data layer needs.\n2\t\n3\tDefaults resolve to the Aurora repo layout (the package lives at\n4\t``<repo>/dashboard``), but every path is injectable so tests run hermetically\n5\tagainst fixture dirs and the blueprint can be mounted into Anchor with different\n6\troots.\n7\t\"\"\"\n8\tfrom __future__ import annotations\n9\t\n10\tfrom dataclasses import dataclass\n11\tfrom pathlib import Path\n12\t\n13\t\n14\t@dataclass(frozen=True)\n15\tclass DashboardConfig:\n16\t    kb_path: Path           # kb/aurora.db (opened READ-ONLY)\n17\t    reports_dir: Path       # reports/\n18\t    library_dir: Path       # library/ (for dead-link checks / map seed)\n19\t    logs_dir: Path          # logs/ (sweep stdout logs; read-only, allowlisted)\n20\t    static_dir: Path        # dashboard/web/static\n21\t    port: int = 5001        # Anchor owns 5000\n22\t    host: str = \"127.0.0.1\"  # local-only; no auth surface\n23\t\n24\t    @staticmethod\n25\t    def repo_root() -> Path:\n26\t        # <repo>/dashboard/config.py -> <repo>\n27\t        return Path(__file__).resolve().parent.parent\n28\t\n29\t    @classmethod\n30\t    def default(cls) -> \"DashboardConfig\":\n31\t        root = cls.repo_root()\n32\t        return cls(\n33\t            kb_path=root / \"kb\" / \"aurora.db\",\n34\t            reports_dir=root / \"reports\",\n35\t            library_dir=root / \"library\",\n36\t            logs_dir=root / \"logs\",\n37\t            static_dir=Path(__file__).resolve().parent / \"web\" / \"static\",\n38\t        )\n39\t\n40\t    @classmethod\n41\t    def for_test(cls, base: Path) -> \"DashboardConfig\":\n42\t        \"\"\"A config rooted at a fixture dir (used by the test suite).\"\"\"\n43\t        return cls(\n44\t            kb_path=base / \"kb\" / \"aurora.db\",\n45\t            reports_dir=base / \"reports\",\n46\t            library_dir=base / \"library\",\n47\t            logs_dir=base / \"logs\",\n48\t            static_dir=Path(__file__).resolve().parent / \"web\" / \"static\",\n49\t        )\n50\t"}]},"parent_tool_use_id":"toolu_01VLkraJFgEdSF3EAkXiHTtu","session_id":"5f986a64-6630-4578-8cdf-92983029246b","uuid":"a9b3f9f9-fec3-48a7-8296-d2b4691d955b","timestamp":"2026-06-23T19:12:32.844Z","subagent_type":"Explore","task_description":"Map Aurora code architecture"}
