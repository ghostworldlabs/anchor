{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NUZGxqLkBoyiZUj3MjtS8T","type":"tool_result","content":"200\t\n201\t-- Schema version\n202\tCREATE TABLE IF NOT EXISTS schema_version (\n203\t  version INTEGER PRIMARY KEY,\n204\t  applied_at TEXT NOT NULL\n205\t);\n206\tINSERT OR IGNORE INTO schema_version (version, applied_at) VALUES (3, datetime('now'));\n207\t\n208\t-- v3.1 (Bucket I1 + J3, 2026-05-19 PM): add artifacts.description_vec, drop seed_map_edits.\n209\t-- Idempotent migration: ALTER TABLE ... ADD COLUMN tolerates re-run via DEFAULT NULL semantics,\n210\t-- and DROP TABLE IF EXISTS is no-op when already gone.\n211\tINSERT OR IGNORE INTO schema_version (version, applied_at) VALUES (31, datetime('now'));\n212\t\n213\t-- v3.2 (Bucket M, 2026-05-20): Helping Hand usage telemetry. Mirrors\n214\t-- kb/migrations/0001_hh_telemetry.sql so a virgin DB built straight from\n215\t-- schema.sql already has these tables; the migration runner brings existing\n216\t-- DBs up to v32. See the migration file for column semantics.\n217\tCREATE TABLE IF NOT EXISTS hh_sessions (\n218\t  session_id   TEXT PRIMARY KEY,\n219\t  started_at   TEXT NOT NULL,\n220\t  last_seen_at TEXT NOT NULL,\n221\t  scorer       TEXT,\n222\t  match_calls  INTEGER DEFAULT 0\n223\t);\n224\t-- hh_events.outcome accepted values (no CHECK constraint to keep the table\n225\t-- forward-compatible; the curator-side analytics tolerates unknown values\n226\t-- gracefully):\n227\t--   'surfaced'         -> auto-logged by server when match_request returns\n228\t--                         a candidate (recall denominator)\n229\t--   'loaded'           -> promoted from surfaced by log_use(accepted=True),\n230\t--                         or directly written by auto-mode silent loads\n231\t--   'dismissed'        -> promoted from surfaced by log_use(accepted=False)\n232\t--   'no_match_judged'  -> Wave A2 (2026-05-29): MoE judge actively returned\n233\t--                         null. Distinct from 'surfaced' with no follow-up\n234\t--                         (which conflates judge-never-ran with agent-ignored)\n235\t--   'abandoned'        -> TTL expired without a terminal action\n236\tCREATE TABLE IF NOT EXISTS hh_events (\n237\t  id              INTEGER PRIMARY KEY,\n238\t  session_id      TEXT REFERENCES hh_sessions(session_id),\n239\t  query_sha256    TEXT,\n240\t  query_preview   TEXT,\n241\t  slug            TEXT,\n242\t  artifact_kind   TEXT,\n243\t  score           REAL,\n244\t  scorer          TEXT,\n245\t  rank            INTEGER,\n246\t  threshold       REAL,\n247\t  above_threshold INTEGER,\n248\t  outcome         TEXT NOT NULL DEFAULT 'surfaced',\n249\t  recorded_at     TEXT NOT NULL\n250\t);\n251\tCREATE INDEX IF NOT EXISTS idx_hh_events_recorded ON hh_events(recorded_at);\n252\tCREATE INDEX IF NOT EXISTS idx_hh_events_slug ON hh_events(slug);\n253\tCREATE INDEX IF NOT EXISTS idx_hh_events_session ON hh_events(session_id);\n254\t\n255\t-- Awareness Revamp Wave 2 (2026-06-12): shadow-vs-legacy ranking diff records.\n256\t-- Mirrors kb/migrations/0026_frontier_score.sql. CC1: INTERNAL shadow\n257\t-- diagnostics → SCRUB (publisher deletes it before VACUUM; never shipped to\n258\t-- aurora-library). In Wave 2 these rows are written ONLY to a fixture/shadow DB\n259\t-- copy by bin/run_ranker_shadow.py, never the live aurora.db.\n260\tCREATE TABLE IF NOT EXISTS ranking_diffs (\n261\t  id              INTEGER PRIMARY KEY,\n262\t  run_or_date     TEXT,\n263\t  artifact_id     INTEGER,\n264\t  legacy_rank     INTEGER,\n265\t  shadow_rank     INTEGER,\n266\t  legacy_score    REAL,\n267\t  shadow_score    REAL,\n268\t  frontier_score  REAL,\n269\t  demoted_loaded  INTEGER,\n270\t  created_at      TEXT\n271\t);\n272\tCREATE INDEX IF NOT EXISTS idx_ranking_diffs_run ON ranking_diffs(run_or_date);\n273\tCREATE INDEX IF NOT EXISTS idx_ranking_diffs_artifact ON ranking_diffs(artifact_id);\n274\t-- helping_hand_log was historically created lazily by the MCP server; define\n275\t-- it here for fresh installs, with the v3.2 session_id column.\n276\tCREATE TABLE IF NOT EXISTS helping_hand_log (\n277\t  id          INTEGER PRIMARY KEY,\n278\t  slug        TEXT,\n279\t  context_hash TEXT,\n280\t  accepted    INTEGER,\n281\t  recorded_at TEXT,\n282\t  session_id  TEXT\n283\t);\n284\tINSERT OR IGNORE INTO schema_version (version, applied_at) VALUES (32, datetime('now'));\n285\t\n286\t-- v3.3 (Bucket L M-1, 2026-05-20): Models sweep. Mirrors\n287\t-- kb/migrations/0002_models.sql so a virgin DB built straight from schema.sql\n288\t-- already has these tables (and the widened artifacts CHECK above); the\n289\t-- migration runner brings existing DBs up to v33. See the migration file for\n290\t-- the artifacts CHECK-widen rebuild (only needed for existing DBs) and column\n291\t-- semantics.\n292\tCREATE TABLE IF NOT EXISTS models (\n293\t  artifact_id INTEGER PRIMARY KEY REFERENCES artifacts(id),\n294\t  provider TEXT NOT NULL,\n295\t  family TEXT NOT NULL,\n296\t  version TEXT NOT NULL,\n297\t  vendor_model_id TEXT,\n298\t  released_at TEXT,\n299\t  context_in_tokens INTEGER,\n300\t  max_output_tokens INTEGER,\n301\t  modalities TEXT,\n302\t  tool_use TEXT,\n303\t  reasoning_mode TEXT,\n304\t  knowledge_cutoff TEXT,\n305\t  price_in_usd_per_mtok REAL,\n306\t  price_out_usd_per_mtok REAL,\n307\t  price_tier_notes TEXT,\n308\t  license_class TEXT,\n309\t  region_availability TEXT,\n310\t  deprecation_date TEXT,\n311\t  vendor_doc_url TEXT,\n312\t  is_preview INTEGER DEFAULT 0,\n313\t  last_metadata_verified_at TEXT,\n314\t  UNIQUE(provider, family, version)\n315\t);\n316\tCREATE TABLE IF NOT EXISTS model_benchmarks (\n317\t  id INTEGER PRIMARY KEY,\n318\t  artifact_id INTEGER NOT NULL REFERENCES artifacts(id),\n319\t  benchmark TEXT NOT NULL,\n320\t  score REAL,\n321\t  score_text TEXT,\n322\t  scored_at TEXT,\n323\t  observed_at TEXT NOT NULL,\n324\t  source_url TEXT NOT NULL,\n325\t  contamination_flag TEXT,\n326\t  -- Awareness Revamp W3 (0027_benchmark_provenance): per-cell provenance.\n327\t  -- source  = data origin ('epoch' | 'artificial-analysis' | 'openrouter'); the\n328\t  --           publisher SCRUBS restricted sources (AA/OpenRouter) from snapshots.\n329\t  -- license = per-cell redistribution license ('CC-BY-4.0' | 'Apache-2.0' |\n330\t  --           'proprietary'); NOT-NULL at write time (CC5); the publisher keeps\n331\t  --           only allowed licenses (CC1 publish-with-license-filter).\n332\t  source TEXT,\n333\t  license TEXT,\n334\t  UNIQUE(artifact_id, benchmark, scored_at)\n335\t);\n336\tCREATE INDEX IF NOT EXISTS idx_model_benchmarks_artifact ON model_benchmarks(artifact_id);\n337\tCREATE TABLE IF NOT EXISTS model_smoke_tests (\n338\t  id INTEGER PRIMARY KEY,\n339\t  artifact_id INTEGER NOT NULL REFERENCES artifacts(id),\n340\t  run_id INTEGER NOT NULL REFERENCES runs(id),\n341\t  ran_at TEXT NOT NULL,\n342\t  status TEXT NOT NULL,\n343\t  latency_ms INTEGER,\n344\t  http_status INTEGER,\n345\t  tokens_in INTEGER,\n346\t  tokens_out INTEGER,\n347\t  usd_estimate REAL,\n348\t  error_class TEXT,\n349\t  error_msg TEXT\n350\t);\n351\tCREATE INDEX IF NOT EXISTS idx_smoke_artifact_ran_at ON model_smoke_tests(artifact_id, ran_at DESC);\n352\t-- v3.4 (Bucket Self-Evolving, 2026-05-21): Self-Evolving MoE Architecture.\n353\t-- Adds interaction buffers for behavioral telemetry and skill upgrade tracking.\n354\tCREATE TABLE IF NOT EXISTS hh_interaction_buffer (\n355\t  id              INTEGER PRIMARY KEY,\n356\t  session_id      TEXT REFERENCES hh_sessions(session_id),\n357\t  user_prompt     TEXT,\n358\t  assistant_response TEXT,\n359\t  sentiment_score REAL,    -- -1 (frustrated) to 1 (happy)\n360\t  repetition_score REAL,   -- 0 to 1 (similarity to previous turns)\n361\t  turn_count      INTEGER,\n362\t  adopted         INTEGER,  -- 1 if git commit or file save followed\n363\t  utility_score   REAL,    -- final LLM-as-a-judge score\n364\t  agent_context   TEXT,    -- JSON blob: {\"calling_agent\": \"...\", \"project_type\": \"...\"}\n365\t  recorded_at     TEXT NOT NULL\n366\t);\n367\tCREATE TABLE IF NOT EXISTS hh_skill_upgrades (\n368\t  id              INTEGER PRIMARY KEY,\n369\t  skill_slug      TEXT NOT NULL,\n370\t  old_hash        TEXT,\n371\t  new_hash        TEXT,\n372\t  reason          TEXT,\n373\t  change_patch    TEXT,\n374\t  utility_gain    REAL,\n375\t  recorded_at     TEXT NOT NULL\n376\t);\n377\tINSERT OR IGNORE INTO schema_version (version, applied_at) VALUES (34, datetime('now'));\n378\t\n379\t-- Wave A3 (2026-05-29): tool_install satellite. Mirrors\n380\t-- kb/migrations/0009_tool_install.sql so a virgin DB built straight from\n381\t-- schema.sql already has the table; the migration runner brings existing DBs\n382\t-- up to v9 (migrations sequence). See the migration file header for the\n383\t-- schema_version-sequence reconciliation note (continue with migrations\n384\t-- sequence, NOT the 3,31,32,34 schema.sql sequence).\n385\tCREATE TABLE IF NOT EXISTS tool_install (\n386\t  artifact_id            INTEGER PRIMARY KEY REFERENCES artifacts(id) ON DELETE CASCADE,\n387\t  install_method         TEXT CHECK(install_method IS NULL OR install_method IN\n388\t                            ('npm','npx','pip','uvx','pipx','cargo','go',\n389\t                             'docker','clone','remote-http','manual')),\n390\t  install_command        TEXT,\n391\t  invocation_kind        TEXT CHECK(invocation_kind IS NULL OR invocation_kind IN\n392\t                            ('mcp-stdio','mcp-http','mcp-sse','cli',\n393\t                             'python-import','npm-import','rest-api','desktop-app')),\n394\t  mcp_config_json        TEXT,\n395\t  function_spec_json     TEXT,\n396\t  required_env_vars      TEXT,\n397\t  required_oauth_scopes  TEXT,\n398\t  transport              TEXT CHECK(transport IS NULL OR transport IN\n399\t                            ('stdio','http','sse','websocket')),"}]},"parent_tool_use_id":"toolu_01VLkraJFgEdSF3EAkXiHTtu","session_id":"5f986a64-6630-4578-8cdf-92983029246b","uuid":"0ef5f1f4-d665-45b8-bc4a-82f6d9e4d1ab","timestamp":"2026-06-23T19:13:26.165Z","subagent_type":"Explore","task_description":"Map Aurora code architecture"}
