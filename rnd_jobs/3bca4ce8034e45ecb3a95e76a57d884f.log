{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WfGZSt9Z75E84eGGGgyDnF","type":"tool_result","content":"1281\tdef main(argv: Optional[list[str]] = None) -> int:\n1282\t    load_dotenv(ROOT / \".env\", override=False)\n1283\t\n1284\t    ap = argparse.ArgumentParser(description=\"Aurora nightly sweep orchestrator.\")\n1285\t    ap.add_argument(\"--sweep\", required=True, choices=[\"skills\", \"tools\", \"agents\", \"models\"])\n1286\t    ap.add_argument(\"--dry-run\", action=\"store_true\",\n1287\t                    help=\"Walk the pipeline with no LLM calls or network fetches.\")\n1288\t    ap.add_argument(\"--no-swarm\", action=\"store_true\",\n1289\t                    help=\"Skip runner+critic_a+critic_b+reconciler; embed and file every static-pass candidate.\")\n1290\t    # Bucket L M-2: models-sweep knobs. Parsed now (so the CLI surface is stable\n1291\t    # for scripts/scheduled tasks); wired into the smoke_runner + screener in\n1292\t    # later waves. --providers restricts which vendor keys the smoke runner\n1293\t    # exercises; --top-k caps how many candidates enter the swarm.\n1294\t    ap.add_argument(\"--providers\", default=None,\n1295\t                    help=\"(models sweep) comma-separated provider allowlist, e.g. 'anthropic,google'. \"\n1296\t                         \"Parsed now; used by the smoke runner in a later wave.\")\n1297\t    ap.add_argument(\"--top-k\", type=int, default=None,\n1298\t                    help=\"(models sweep) cap on candidates entering the swarm. \"\n1299\t                         \"Parsed now; used by the screener in a later wave.\")\n1300\t    ap.add_argument(\"--log-level\", default=\"INFO\",\n1301\t                    choices=[\"DEBUG\", \"INFO\", \"WARNING\", \"ERROR\"])\n1302\t    # Awareness Revamp Wave 2 (2026-06-12): SHADOW-ONLY retarget. Default False.\n1303\t    # When UNSET (the cron default) behavior is byte-for-byte unchanged — the\n1304\t    # flag is not consulted anywhere on the live write path below. When SET, the\n1305\t    # orchestrator runs the new high-signal sources + frontier ranker in SHADOW\n1306\t    # against a *_shadow/fixture KB (NEVER the live tables), cost-capped via the\n1307\t    # \"ranker_shadow\" budget cell, and returns WITHOUT opening a live run. CC2:\n1308\t    # zero live-DB writes; off cron; promotion is a documented MANUAL step.\n1309\t    ap.add_argument(\"--retarget-shadow\", action=\"store_true\", default=False,\n1310\t                    help=\"SHADOW-ONLY: run the W2 high-signal sources + frontier \"\n1311\t                         \"ranker against a fixture/shadow KB (never live), \"\n1312\t                         \"cost-capped; nothing is promoted to cron.\")\n1313\t    ap.add_argument(\"--shadow-date\", default=None,\n1314\t                    help=\"(with --retarget-shadow) deterministic run date \"\n1315\t                         \"YYYY-MM-DD for the shadow diff.\")\n1316\t    args = ap.parse_args(argv)\n1317\t\n1318\t    LOG_DIR.mkdir(parents=True, exist_ok=True)\n1319\t    log_file = LOG_DIR / f\"orchestrator-{datetime.now(timezone.utc):%Y%m%dT%H%M%SZ}-{args.sweep}.log\"\n1320\t    logging.basicConfig(\n1321\t        level=args.log_level,\n1322\t        format=\"%(asctime)s %(name)s %(levelname)s  %(message)s\",\n1323\t        handlers=[logging.StreamHandler(sys.stderr), logging.FileHandler(log_file, encoding=\"utf-8\")],\n1324\t    )\n1325\t\n1326\t    cfg = SWEEP_CONFIGS[args.sweep]\n1327\t    if not cfg.seed_map_path.exists():\n1328\t        log.error(\"seed map not found: %s\", cfg.seed_map_path)\n1329\t        return 2\n1330\t\n1331\t    # Awareness Revamp Wave 2 (2026-06-12): SHADOW-ONLY retarget branch. This\n1332\t    # returns BEFORE any live run is opened — the live KB is never touched here.\n1333\t    # CC2: zero live writes, off cron, cost-capped via the \"ranker_shadow\" cell.\n1334\t    # When --retarget-shadow is UNSET this whole block is skipped, so the cron\n1335\t    # default path below is byte-for-byte unchanged.\n1336\t    if args.retarget_shadow:\n1337\t        return _run_retarget_shadow(cfg, shadow_date=args.shadow_date)\n1338\t\n1339\t    with sweep_lock(skip=args.dry_run):\n1340\t        conn = _connect_with_fallback(DB_PATH)\n1341\t        seed_map_text = cfg.seed_map_path.read_text(encoding=\"utf-8\")\n1342\t        prompts_dir = ROOT / \"prompts\"\n1343\t        run_id = open_run(conn, cfg.name, seed_map_text, prompts_dir, args.dry_run)\n1344\t        log.info(\"orchestrator: opened run_id=%s\", run_id)\n1345\t        try:\n1346\t            # Bucket L M-2: route the models sweep to its sibling pipeline. The\n1347\t            # other three sweeps keep the original skill-shaped walk.\n1348\t            if cfg.name == \"models\":\n1349\t                if args.providers:\n1350\t                    log.info(\"orchestrator: --providers=%s (provider allowlist)\",\n1351\t                             args.providers)\n1352\t                providers = (\n1353\t                    {p.strip().lower() for p in args.providers.split(\",\") if p.strip()}\n1354\t                    if args.providers else None\n1355\t                )\n1356\t                notes = asyncio.run(walk_models_pipeline(cfg, conn, run_id,\n1357\t                                                         dry_run=args.dry_run,\n1358\t                                                         no_swarm=args.no_swarm,\n1359\t                                                         top_k=args.top_k,\n1360\t                                                         providers=providers))\n1361\t            else:\n1362\t                notes = asyncio.run(walk_pipeline(cfg, conn, run_id,\n1363\t                                                  dry_run=args.dry_run,\n1364\t                                                  no_swarm=args.no_swarm))\n1365\t            \n1366\t            # Synthesis: Update the thematic literature review for today.\n1367\t            if not args.dry_run:\n1368\t                try:\n1369\t                    # Wave-C: advisor replaces literature_reviewer.\n1370\t                    # Same call shape; advisor produces both the briefing\n1371\t                    # paragraph (daily_syntheses) AND citation-grounded\n1372\t                    # decision-tree artifacts. Keeping lit_reviewer import\n1373\t                    # for 1-week rollback per FINAL_GOLD_STANDARD_REVISION\n1374\t                    # plan.\n1375\t                    advisor_role.run_advisor(conn, run_id)\n1376\t                except Exception as e:\n1377\t                    log.error(\"orchestrator: literature_reviewer failed: %s\", e)\n1378\t\n1379\t            # Bucket G4 (v4.3, 2026-05-19): consult per-run degrade counter\n1380\t            # bumped by llm.py whenever a Sonnet/Gemini call fell back to Haiku."}]},"parent_tool_use_id":"toolu_01ACwxJodXAE6No2Hnb7B6TY","session_id":"a7fcfbf6-6e6f-495e-9c53-2f0602be6ffe","uuid":"db76d899-5b00-4f15-83aa-e709bf68659c","timestamp":"2026-06-23T19:01:57.894Z","subagent_type":"Explore","task_description":"Map Aurora architecture & code"}
