{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MrBQTgVGgDzyEU83KVwxYS","type":"tool_result","content":"1-\"\"\"Aurora orchestrator — entry point for nightly sweeps.\n2-\n3-Usage:\n4:    python -m aurora.orchestrator --sweep skills              # live sweep\n5:    python -m aurora.orchestrator --sweep skills --dry-run    # walk pipeline, no LLM calls\n6:    python -m aurora.orchestrator --sweep skills --no-swarm   # skip runner+critics+reconciler (P2 mode)\n7-\"\"\"\n8-from __future__ import annotations\n9-import argparse\n10-import asyncio\n11-import contextlib\n--\n1280-\n1281-def main(argv: Optional[list[str]] = None) -> int:\n1282-    load_dotenv(ROOT / \".env\", override=False)\n1283-\n1284-    ap = argparse.ArgumentParser(description=\"Aurora nightly sweep orchestrator.\")\n1285:    ap.add_argument(\"--sweep\", required=True, choices=[\"skills\", \"tools\", \"agents\", \"models\"])\n1286:    ap.add_argument(\"--dry-run\", action=\"store_true\",\n1287-                    help=\"Walk the pipeline with no LLM calls or network fetches.\")\n1288:    ap.add_argument(\"--no-swarm\", action=\"store_true\",\n1289-                    help=\"Skip runner+critic_a+critic_b+reconciler; embed and file every static-pass candidate.\")\n1290-    # Bucket L M-2: models-sweep knobs. Parsed now (so the CLI surface is stable\n1291-    # for scripts/scheduled tasks); wired into the smoke_runner + screener in\n1292-    # later waves. --providers restricts which vendor keys the smoke runner\n1293-    # exercises; --top-k caps how many candidates enter the swarm."}]},"parent_tool_use_id":"toolu_01ACwxJodXAE6No2Hnb7B6TY","session_id":"a7fcfbf6-6e6f-495e-9c53-2f0602be6ffe","uuid":"39b19e3b-2c1d-45cb-b182-1da752e18870","timestamp":"2026-06-23T19:01:27.341Z","subagent_type":"Explore","task_description":"Map Aurora architecture & code"}
