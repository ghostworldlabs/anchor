{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019kzKdho829Pnt2uZJqrumv","type":"tool_result","content":"1\t\"\"\"Aurora orchestrator — entry point for nightly sweeps.\n2\t\n3\tUsage:\n4\t    python -m aurora.orchestrator --sweep skills              # live sweep\n5\t    python -m aurora.orchestrator --sweep skills --dry-run    # walk pipeline, no LLM calls\n6\t    python -m aurora.orchestrator --sweep skills --no-swarm   # skip runner+critics+reconciler (P2 mode)\n7\t\"\"\"\n8\tfrom __future__ import annotations\n9\timport argparse\n10\timport asyncio\n11\timport contextlib\n12\timport hashlib\n13\timport json\n14\timport logging\n15\timport os\n16\timport shutil\n17\timport sqlite3\n18\timport sys\n19\timport tempfile\n20\timport time\n21\tfrom datetime import datetime, timezone\n22\tfrom pathlib import Path\n23\tfrom typing import Optional\n24\t\n25\timport yaml\n26\tfrom dotenv import load_dotenv\n27\t\n28\tfrom aurora.sweeps import SWEEP_CONFIGS, SweepConfig\n29\tfrom aurora.roles import scout, quarantine as quarantine_role, static_screener\n30\tfrom aurora.roles import sanitizer as sanitizer_role\n31\tfrom aurora.roles import embedder, librarian\n32\tfrom aurora.roles import runner as runner_role\n33\tfrom aurora.roles import critic_a, critic_b, critic_c, reconciler\n34\tfrom aurora.roles import batch_sweep\n35\tfrom aurora.roles import evidence, shadow_diff\n36\tfrom aurora.roles import model_card_parser, benchmark_scraper, literature_reviewer, pricing_collector\n37\t# Wave-C (2026-05-25): advisor replaces literature_reviewer's call site below.\n38\t# We keep the literature_reviewer import for a 1-week rollback window.\n39\tfrom aurora.roles import advisor as advisor_role\n40\tfrom aurora.llm import CostRecorder\n41\tfrom aurora.exec_summary import write_summary, mtd_per_vendor\n42\t\n43\tlog = logging.getLogger(\"aurora.orchestrator\")\n44\t\n45\tROOT = Path(__file__).resolve().parent\n46\tDB_PATH = ROOT / \"kb\" / \"aurora.db\"\n47\tLOCK_PATH = ROOT / \"lock\" / \"sweep.lock\"\n48\tLOG_DIR = ROOT / \"logs\"\n49\tLIBRARY_ROOT = ROOT / \"library\"\n50\tREPORTS_ROOT = ROOT / \"reports\"\n51\t\n52\tMONTHLY_CAPS = {\"anthropic\": 50.00, \"gemini\": 10.00}\n53\t\n54\t# Bucket J4 (v4.3, 2026-05-19 PM): per-sweep budget guardrail.\n55\t# Bucket O-12 (2026-05-23): per-role budget cells. The 15-20% overshoot pattern\n56\t# from J4 was critic_b-token-blowup-dominated; per-role cells isolate which\n57\t# throttle. The total still applies (sum of cells ≤ PER_SWEEP_BUDGET_USD).\n58\t# Cells are PROPORTIONAL — derived from observed nightly cost ratios. Adjust\n59\t# as the system grows; the guardrail prefers conservative (lower) caps.\n60\t_SWEEPS_PER_DAY = 3\n61\t_DAYS_PER_MONTH = 30\n62\tPER_SWEEP_BUDGET_USD = MONTHLY_CAPS[\"anthropic\"] / _DAYS_PER_MONTH / _SWEEPS_PER_DAY\n63\t\n64\t# Per-role cells. Sum is < PER_SWEEP_BUDGET_USD on purpose (headroom). Any cell\n65\t# crossing trips the same 'partial' status as the total cap.\n66\tPER_ROLE_BUDGET_USD = {\n67\t    \"scout\":       PER_SWEEP_BUDGET_USD * 0.05,\n68\t    \"sanitizer\":   PER_SWEEP_BUDGET_USD * 0.10,\n69\t    \"runner\":      PER_SWEEP_BUDGET_USD * 0.35,\n70\t    \"critic_a\":    PER_SWEEP_BUDGET_USD * 0.15,\n71\t    \"critic_b\":    PER_SWEEP_BUDGET_USD * 0.15,\n72\t    # Wave 1 (2026-06-02): critic_c's third-judge provider calls (DeepSeek/Groq)\n73\t    # now flow through CostRecorder. Small cell — critic_c runs on cheap/free-tier\n74\t    # cross-family providers, so its expected spend is the lowest of the judges.\n75\t    \"critic_c\":    PER_SWEEP_BUDGET_USD * 0.05,\n76\t    \"reconciler\":  PER_SWEEP_BUDGET_USD * 0.10,\n77\t    # Wave 2 / H2 (2026-06-06): defense-in-depth cap on the evidence-loop SHADOW\n78\t    # re-scoring spend. With the default-off live re-score\n79\t    # (AURORA_EVIDENCE_LIVE_RESCORE unset) the nightly path uses the precomputed\n80\t    # zero-cost score_fn, so this cell is normally 0. It only bites when the live\n81\t    # re-score IS enabled, bounding it via _role_budget_exceeded(\"evidence_shadow\").\n82\t    # Conservative: it re-runs the same panel the legacy verdict already pays for,\n83\t    # so size it like the panel's own cells (a/b/c+reconciler ~= 0.45 combined);\n84\t    # cap at the reconciler cell so it can never dwarf the live verdict spend.\n85\t    \"evidence_shadow\": PER_SWEEP_BUDGET_USD * 0.10,\n86\t    \"embedder\":    PER_SWEEP_BUDGET_USD * 0.05,\n87\t    \"literature_reviewer\": PER_SWEEP_BUDGET_USD * 0.03,\n88\t    \"pricing_collector\":   PER_SWEEP_BUDGET_USD * 0.05,\n89\t    # Awareness Revamp Wave 2 (2026-06-12): cap on the SHADOW-ONLY retarget\n90\t    # pass (new high-signal sources + frontier ranker, via --retarget-shadow).\n91\t    # Normally 0 — it only meters when --retarget-shadow is set, which is OFF\n92\t    # the nightly cron. Small cell: the shadow pass is cheap-metadata scoring,\n93\t    # not a full swarm.\n94\t    \"ranker_shadow\": PER_SWEEP_BUDGET_USD * 0.08,\n95\t}\n96\t\n97\t\n98\tdef _sweep_cost_so_far(conn: sqlite3.Connection, run_id: int) -> float:\n99\t    \"\"\"Sum of usd_estimate for this run across all cost_recorder writes so far.\n100\t    Cheap (single SUM over an indexed-by-run-id table) — fine to call after"}]},"parent_tool_use_id":"toolu_01Y16vzRsaFa4WCzXfR89u1q","session_id":"a7fcfbf6-6e6f-495e-9c53-2f0602be6ffe","uuid":"0101b1cd-8a87-4c9a-b0a0-8070f08167f3","timestamp":"2026-06-23T19:01:46.633Z","subagent_type":"Explore","task_description":"Audit Aurora recent work & health"}
