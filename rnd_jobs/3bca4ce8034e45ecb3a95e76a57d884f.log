{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UmJc1MZQgT94i4VHMfXivF","type":"tool_result","content":"1\t\"\"\"Idempotent schema applier. Works around Cowork-sandbox mount limitation by\n2\tbuilding in /tmp and copying into place when running under that constraint.\"\"\"\n3\tfrom __future__ import annotations\n4\timport argparse\n5\timport os\n6\timport shutil\n7\timport sqlite3\n8\timport tempfile\n9\tfrom pathlib import Path\n10\t\n11\t\n12\tdef apply_schema(db_path: Path, schema_path: Path, *, force: bool = False) -> None:\n13\t    schema = schema_path.read_text(encoding=\"utf-8\")\n14\t\n15\t    # Detect if the target supports SQLite locking (host mounts inside Cowork's\n16\t    # Linux sandbox sometimes don't). If a direct write to db_path fails, fall\n17\t    # back to temp-then-copy.\n18\t    def _try_apply_at(target: Path) -> None:\n19\t        conn = sqlite3.connect(str(target))\n20\t        try:\n21\t            conn.executescript(schema)\n22\t            conn.commit()\n23\t        finally:\n24\t            conn.close()\n25\t\n26\t    if force and db_path.exists():\n27\t        db_path.unlink()\n28\t\n29\t    try:\n30\t        _try_apply_at(db_path)\n31\t    except sqlite3.OperationalError as e:\n32\t        if \"I/O\" not in str(e):\n33\t            raise\n34\t        # Fallback: build in tempdir, copy to destination.\n35\t        with tempfile.TemporaryDirectory() as td:\n36\t            staging = Path(td) / \"aurora.db\"\n37\t            _try_apply_at(staging)\n38\t            shutil.copy2(staging, db_path)\n39\t\n40\t\n41\tdef main() -> None:\n42\t    here = Path(__file__).parent\n43\t    ap = argparse.ArgumentParser(description=\"Apply Aurora schema to aurora.db.\")\n44\t    ap.add_argument(\"--db\", type=Path, default=here / \"aurora.db\",\n45\t                    help=\"Path to aurora.db (default: kb/aurora.db)\")\n46\t    ap.add_argument(\"--schema\", type=Path, default=here / \"schema.sql\",\n47\t                    help=\"Path to schema.sql\")\n48\t    ap.add_argument(\"--force\", action=\"store_true\",\n49\t                    help=\"Delete and recreate the DB (DESTRUCTIVE)\")\n50\t    args = ap.parse_args()\n51\t    apply_schema(args.db, args.schema, force=args.force)\n52\t    print(f\"Schema applied to {args.db}\")\n53\t\n54\t\n55\tif __name__ == \"__main__\":\n56\t    main()\n57\t"}]},"parent_tool_use_id":"toolu_01ACwxJodXAE6No2Hnb7B6TY","session_id":"a7fcfbf6-6e6f-495e-9c53-2f0602be6ffe","uuid":"ac7e3fc2-c92c-4508-a697-7c73f2413f6c","timestamp":"2026-06-23T19:01:16.508Z","subagent_type":"Explore","task_description":"Map Aurora architecture & code"}
