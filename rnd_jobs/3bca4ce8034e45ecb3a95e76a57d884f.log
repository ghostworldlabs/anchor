{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L11ucqx1AaFifNoo5oNWip","type":"tool_result","content":"1\t\"\"\"Aurora orchestrator — entry point for nightly sweeps.\n2\t\n3\tUsage:\n4\t    python -m aurora.orchestrator --sweep skills              # live sweep\n5\t    python -m aurora.orchestrator --sweep skills --dry-run    # walk pipeline, no LLM calls\n6\t    python -m aurora.orchestrator --sweep skills --no-swarm   # skip runner+critics+reconciler (P2 mode)\n7\t\"\"\"\n8\tfrom __future__ import annotations\n9\timport argparse\n10\timport asyncio\n11\timport contextlib\n12\timport hashlib\n13\timport json\n14\timport logging\n15\timport os\n16\timport shutil\n17\timport sqlite3\n18\timport sys\n19\timport tempfile\n20\timport time\n21\tfrom datetime import datetime, timezone\n22\tfrom pathlib import Path\n23\tfrom typing import Optional\n24\t\n25\timport yaml\n26\tfrom dotenv import load_dotenv\n27\t\n28\tfrom aurora.sweeps import SWEEP_CONFIGS, SweepConfig\n29\tfrom aurora.roles import scout, quarantine as quarantine_role, static_screener\n30\tfrom aurora.roles import sanitizer as sanitizer_role\n31\tfrom aurora.roles import embedder, librarian\n32\tfrom aurora.roles import runner as runner_role\n33\tfrom aurora.roles import critic_a, critic_b, critic_c, reconciler\n34\tfrom aurora.roles import batch_sweep\n35\tfrom aurora.roles import evidence, shadow_diff\n36\tfrom aurora.roles import model_card_parser, benchmark_scraper, literature_reviewer, pricing_collector\n37\t# Wave-C (2026-05-25): advisor replaces literature_reviewer's call site below.\n38\t# We keep the literature_reviewer import for a 1-week rollback window.\n39\tfrom aurora.roles import advisor as advisor_role\n40\tfrom aurora.llm import CostRecorder\n41\tfrom aurora.exec_summary import write_summary, mtd_per_vendor\n42\t\n43\tlog = logging.getLogger(\"aurora.orchestrator\")\n44\t\n45\tROOT = Path(__file__).resolve().parent\n46\tDB_PATH = ROOT / \"kb\" / \"aurora.db\"\n47\tLOCK_PATH = ROOT / \"lock\" / \"sweep.lock\"\n48\tLOG_DIR = ROOT / \"logs\"\n49\tLIBRARY_ROOT = ROOT / \"library\"\n50\tREPORTS_ROOT = ROOT / \"reports\"\n51\t\n52\tMONTHLY_CAPS = {\"anthropic\": 50.00, \"gemini\": 10.00}\n53\t\n54\t# Bucket J4 (v4.3, 2026-05-19 PM): per-sweep budget guardrail.\n55\t# Bucket O-12 (2026-05-23): per-role budget cells. The 15-20% overshoot pattern\n56\t# from J4 was critic_b-token-blowup-dominated; per-role cells isolate which\n57\t# throttle. The total still applies (sum of cells ≤ PER_SWEEP_BUDGET_USD).\n58\t# Cells are PROPORTIONAL — derived from observed nightly cost ratios. Adjust\n59\t# as the system grows; the guardrail prefers conservative (lower) caps.\n60\t_SWEEPS_PER_DAY = 3\n61\t_DAYS_PER_MONTH = 30\n62\tPER_SWEEP_BUDGET_USD = MONTHLY_CAPS[\"anthropic\"] / _DAYS_PER_MONTH / _SWEEPS_PER_DAY\n63\t\n64\t# Per-role cells. Sum is < PER_SWEEP_BUDGET_USD on purpose (headroom). Any cell\n65\t# crossing trips the same 'partial' status as the total cap.\n66\tPER_ROLE_BUDGET_USD = {\n67\t    \"scout\":       PER_SWEEP_BUDGET_USD * 0.05,\n68\t    \"sanitizer\":   PER_SWEEP_BUDGET_USD * 0.10,\n69\t    \"runner\":      PER_SWEEP_BUDGET_USD * 0.35,\n70\t    \"critic_a\":    PER_SWEEP_BUDGET_USD * 0.15,\n71\t    \"critic_b\":    PER_SWEEP_BUDGET_USD * 0.15,\n72\t    # Wave 1 (2026-06-02): critic_c's third-judge provider calls (DeepSeek/Groq)\n73\t    # now flow through CostRecorder. Small cell — critic_c runs on cheap/free-tier\n74\t    # cross-family providers, so its expected spend is the lowest of the judges.\n75\t    \"critic_c\":    PER_SWEEP_BUDGET_USD * 0.05,\n76\t    \"reconciler\":  PER_SWEEP_BUDGET_USD * 0.10,\n77\t    # Wave 2 / H2 (2026-06-06): defense-in-depth cap on the evidence-loop SHADOW\n78\t    # re-scoring spend. With the default-off live re-score\n79\t    # (AURORA_EVIDENCE_LIVE_RESCORE unset) the nightly path uses the precomputed\n80\t    # zero-cost score_fn, so this cell is normally 0. It only bites when the live\n81\t    # re-score IS enabled, bounding it via _role_budget_exceeded(\"evidence_shadow\").\n82\t    # Conservative: it re-runs the same panel the legacy verdict already pays for,\n83\t    # so size it like the panel's own cells (a/b/c+reconciler ~= 0.45 combined);\n84\t    # cap at the reconciler cell so it can never dwarf the live verdict spend.\n85\t    \"evidence_shadow\": PER_SWEEP_BUDGET_USD * 0.10,\n86\t    \"embedder\":    PER_SWEEP_BUDGET_USD * 0.05,\n87\t    \"literature_reviewer\": PER_SWEEP_BUDGET_USD * 0.03,\n88\t    \"pricing_collector\":   PER_SWEEP_BUDGET_USD * 0.05,\n89\t    # Awareness Revamp Wave 2 (2026-06-12): cap on the SHADOW-ONLY retarget\n90\t    # pass (new high-signal sources + frontier ranker, via --retarget-shadow).\n91\t    # Normally 0 — it only meters when --retarget-shadow is set, which is OFF\n92\t    # the nightly cron. Small cell: the shadow pass is cheap-metadata scoring,\n93\t    # not a full swarm.\n94\t    \"ranker_shadow\": PER_SWEEP_BUDGET_USD * 0.08,\n95\t}\n96\t\n97\t\n98\tdef _sweep_cost_so_far(conn: sqlite3.Connection, run_id: int) -> float:\n99\t    \"\"\"Sum of usd_estimate for this run across all cost_recorder writes so far.\n100\t    Cheap (single SUM over an indexed-by-run-id table) — fine to call after\n101\t    every candidate.\"\"\"\n102\t    row = conn.execute(\n103\t        \"SELECT COALESCE(SUM(usd_estimate), 0.0) FROM costs WHERE run_id = ?\",\n104\t        (run_id,),\n105\t    ).fetchone()\n106\t    return float(row[0] or 0.0)\n107\t\n108\t\n109\tdef _role_cost_so_far(conn: sqlite3.Connection, run_id: int, role: str) -> float:\n110\t    \"\"\"O-12: per-role spend for this run. Cheap (indexed by run_id).\"\"\"\n111\t    row = conn.execute(\n112\t        \"SELECT COALESCE(SUM(usd_estimate), 0.0) FROM costs WHERE run_id=? AND role=?\",\n113\t        (run_id, role),\n114\t    ).fetchone()\n115\t    return float(row[0] or 0.0)\n116\t\n117\t\n118\tdef _role_budget_exceeded(conn: sqlite3.Connection, run_id: int, role: str) -> bool:\n119\t    \"\"\"O-12: returns True iff this role has crossed its per-role cell.\"\"\"\n120\t    cap = PER_ROLE_BUDGET_USD.get(role)\n121\t    if cap is None:\n122\t        return False\n123\t    return _role_cost_so_far(conn, run_id, role) > cap\n124\t\n125\t\n126\tdef _verdict_is_more_lenient(candidate_verdict: str, baseline_verdict: str) -> bool:\n127\t    \"\"\"F2 (Wave 2/H2): True iff `candidate_verdict` is MORE LENIENT (more\n128\t    servable) than `baseline_verdict`. Severity ordering reject<flag<pass is\n129\t    owned by shadow_diff._SEVERITY (single source of truth, no second literal);\n130\t    an unknown label is treated as `flag` (the conservative middle), matching\n131\t    the shadow-diff gate's own fail-safe. Used to enforce monotonic-toward-\n132\t    stricter adoption of the loop verdict vs the legacy verdict.\"\"\"\n133\t    sev = shadow_diff._SEVERITY\n134\t    return sev.get(candidate_verdict, 1) > sev.get(baseline_verdict, 1)\n135\t\n136\t\n137\tdef _live_rescore_enabled() -> bool:\n138\t    \"\"\"PRIMARY (Wave 2/H2): is the REAL per-iteration evidence re-score enabled on\n139\t    the nightly path? DEFAULT-OFF. The nightly shadow loop costs ZERO added LLM\n140\t    spend unless AURORA_EVIDENCE_LIVE_RESCORE is explicitly set (1/true/on/yes),\n141\t    and the global AURORA_ENGINE=legacy rollback also disables it. SA-1's metered\n142\t    batch (bin/run_evidence_shadow.py) is the budget-capped place for the real\n143\t    re-score; this flag governs only the nightly orchestrator path.\"\"\"\n144\t    if os.environ.get(\"AURORA_ENGINE\", \"\").strip().lower() == \"legacy\":\n145\t        return False\n146\t    return (os.environ.get(\"AURORA_EVIDENCE_LIVE_RESCORE\", \"\").strip().lower()\n147\t            in (\"1\", \"true\", \"on\", \"yes\"))\n148\t\n149\t\n150\tdef _select_shadow_score_fn(conn, run_id, *, candidate, runner_artifact, critics,\n151\t                            legacy_verdict, overall_score, incorporation_note,\n152\t                            rationale, transcript_text, cost_recorder):\n153\t    \"\"\"Pick the nightly evidence-loop score_fn.\n154\t\n155\t    DEFAULT (PRIMARY invariant): `make_precomputed_score_fn` — REPLAYS the\n156\t    critics the legacy verdict already computed, so the nightly shadow loop adds\n157\t    ZERO LLM cost (no `evidence_shadow` cost rows). Only when the explicit,\n158\t    default-off `AURORA_EVIDENCE_LIVE_RESCORE` flag is set (and the role budget\n159\t    cell is not already exceeded) does the nightly path use the REAL metered\n160\t    per-iteration `make_live_score_fn`.\"\"\"\n161\t    if _live_rescore_enabled() and not _role_budget_exceeded(\n162\t            conn, run_id, \"evidence_shadow\"):\n163\t        return evidence.make_live_score_fn(\n164\t            candidate, runner_artifact,\n165\t            cost_recorder=cost_recorder, run_id=run_id,\n166\t            transcript_fallback=transcript_text)\n167\t    return evidence.make_precomputed_score_fn(\n168\t        list(critics), legacy_verdict,\n169\t        overall_score=overall_score,\n170\t        incorporation_note=incorporation_note,\n171\t        rationale=rationale)\n172\t\n173\t\n174\t# Bucket J4: per-run \"this sweep blew its budget\" flag. Mirrors the G4\n175\t# _DEGRADE_COUNT pattern in llm.py so orchestrator.main can read it after\n176\t# walk_pipeline returns and stamp the run as 'partial'. Cleared per run.\n177\t_BUDGET_EXCEEDED: \"dict[int, tuple[float, float]]\" = {}\n178\t\n179\t\n180\tdef _note_budget_exceeded(run_id: int, spent: float, cap: float) -> None:\n181\t    _BUDGET_EXCEEDED[run_id] = (spent, cap)\n182\t    log.warning(\"BUDGET EXCEEDED ($%.4f / cap=$%.4f) for run_id=%s — \"\n183\t                \"halting per-role loop; run will close as 'partial'\",\n184\t                spent, cap, run_id)\n185\t\n186\t\n187\tdef get_and_clear_budget_exceeded(run_id: int) -> Optional[tuple[float, float]]:\n188\t    return _BUDGET_EXCEEDED.pop(run_id, None)\n189\t\n190\t\n191\t# ----------------------------------------------------------------------------\n192\t# Lock — Bucket O-10 (2026-05-23): heartbeat lock\n193\t# ----------------------------------------------------------------------------\n194\t#\n195\t# v1: O_CREAT|O_EXCL flagfile, no liveness check. A sweep that crashed without\n196\t#     running `finally` (BSOD, kill, oomkiller, scheduled-task timeout) left\n197\t#     the lockfile in place; the next four hours of scheduled tasks blocked\n198\t#     on a dead lock.\n199\t#\n200\t# v2 (O-10): JSON payload {pid, last_heartbeat_unix}. A daemon thread updates"}]},"parent_tool_use_id":"toolu_01ACwxJodXAE6No2Hnb7B6TY","session_id":"a7fcfbf6-6e6f-495e-9c53-2f0602be6ffe","uuid":"82c4977b-cbb3-416a-8390-5a4a7f78bc06","timestamp":"2026-06-23T19:01:06.411Z","subagent_type":"Explore","task_description":"Map Aurora architecture & code"}
