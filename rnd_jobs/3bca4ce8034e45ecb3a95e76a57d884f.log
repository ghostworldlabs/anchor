{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0188SAWcr6imwMCoUshXGkj7","type":"tool_result","content":"\"\"\"Librarian — writes SQLite rows (artifacts, aliases, sources, validations,\r\nembeddings) and per-artifact markdown into library/<sweep_or_kind>/<slug>/index.md.\r\nAlso regenerates the top-level library/index.md.\r\n\r\nBucket L M-7 adds the models-sweep surface: upsert_model() (writes the artifacts\r\n+ models satellite rows, embedder placement OPTIONAL), write_model_md() (per-model\r\ncard with a Capacity profile block per MODEL_GRID_TEMPLATE), and render_model_grid()\r\n(library/models/_grid.md + a self-contained sortable library/_model_grid.html in\r\nthe same single-file style as roles/sunburst.py).\"\"\"\r\nfrom __future__ import annotations\r\nimport json\r\nimport logging\r\nimport os\r\nimport sqlite3\r\nfrom datetime import datetime, timezone\r\nfrom pathlib import Path\r\nfrom .contracts import (Candidate, EmbeddingPlacement, ReconciledVerdict,\r\n                         RunnerArtifact, ScreenedCandidate)\r\n\r\n# Wave B item B3 (2026-05-29): source-grounded extraction with character-offset\r\n# verification. Import is hard (the module itself is in-tree and dependency-\r\n# free); the langextract package it wraps is fail-soft per langextract_adapter.\r\nfrom . import langextract_adapter\r\n# Wave B item B4 (2026-05-29): per-claim provenance edge writer. Pure metadata,\r\n# fail-soft if migration 0018 hasn't been applied to the live DB yet.\r\nfrom . import prov as prov_helper\r\n# Wave C item C3 (2026-05-29): Aurora Sentinel security gate. Imported lazily\r\n# inside upsert_artifact via _maybe_run_security_scan() so a missing\r\n# detector/fetcher module in C1/C2 land doesn't break librarian import.\r\nfrom .security.contracts import get_security_mode, SERVABLE_VERDICTS\r\n\r\nlog = logging.getLogger(__name__)\r\n\r\n\r\ndef _now() -> str:\r\n    return datetime.now(timezone.utc).isoformat()\r\n\r\n\r\ndef _normalize_url(url: str) -> str:\r\n    \"\"\"Cheap structural normalization — Bucket O-20 (2026-05-23) widened.\r\n\r\n    Lowercase host, strip `www.` prefix, drop query string + fragment, strip\r\n    trailing `/`, strip `.git` suffix. This catches the easy mirror/fork\r\n    misses (case, www., URL-as-link-with-tracking-params). The heavier\r\n    redirect-follow + GitHub full_name fold lives in `canonical_url()`\r\n    backed by the `canonical_url_cache` migration 0004.\r\n    \"\"\"\r\n    if not url:\r\n        return url\r\n    from urllib.parse import urlsplit, urlunsplit\r\n    s = urlsplit(url.strip())\r\n    # Lowercase scheme + host; strip leading www.\r\n    scheme = (s.scheme or \"https\").lower()\r\n    netloc = (s.netloc or \"\").lower()\r\n    if netloc.startswith(\"www.\"):\r\n        netloc = netloc[4:]\r\n    path = s.path or \"\"\r\n    if path.endswith(\"/\"):\r\n        path = path.rstrip(\"/\")\r\n    if path.endswith(\".git\"):\r\n        path = path[:-4]\r\n    # Drop query + fragment (kill tracking params, anchors).\r\n    return urlunsplit((scheme, netloc, path, \"\", \"\"))\r\n\r\n\r\n_CANONICAL_TTL_SECONDS = 30 * 24 * 3600\r\n\r\n\r\ndef canonical_url(conn: sqlite3.Connection, observed_url: str) -> str:\r\n    \"\"\"O-20: persistent-TTL canonical-URL resolution.\r\n\r\n    Applies `_normalize_url` first, then consults `canonical_url_cache` to\r\n    fold mirrors/forks/renames into a single canonical URL.\r\n\r\n    Fully offline: only the structural normalization runs synchronously. The\r\n    GitHub-API resolution (full_name + numeric repo_id) is OPT-IN behind a\r\n    `AURORA_CANONICAL_GH=1` env so the librarian doesn't tail-latency the\r\n    sweep with N+1 network calls.\r\n\r\n    Returns the canonical URL string; a cache miss returns the structurally-\r\n    normalized URL and inserts a row so the next call is a hit.\r\n    \"\"\"\r\n    if not observed_url:\r\n        return observed_url\r\n    norm = _normalize_url(observed_url)\r\n    # Cache lookup — only if the table exists (migrations may not have run on\r\n    # an old aurora.db).\r\n    have_cache = conn.execute(\r\n        \"SELECT name FROM sqlite_master WHERE type='table' AND name='canonical_url_cache'\"\r\n    ).fetchone()\r\n    if have_cache is None:\r\n        return norm\r\n    row = conn.execute(\r\n        \"SELECT canonical_url, resolved_at, ttl_seconds FROM canonical_url_cache \"\r\n        \"WHERE observed_url = ?\", (observed_url,),\r\n    ).fetchone()\r\n    if row is not None:\r\n        cached_canonical, resolved_at, ttl = row\r\n        # TTL check (timestamp is best-effort; treat parse errors as stale).\r\n        try:","is_error":false}]},"parent_tool_use_id":"toolu_01Y16vzRsaFa4WCzXfR89u1q","session_id":"a7fcfbf6-6e6f-495e-9c53-2f0602be6ffe","uuid":"e98ef413-72e7-4c53-8b5d-993d1618dabc","timestamp":"2026-06-23T19:02:27.976Z","subagent_type":"Explore","task_description":"Audit Aurora recent work & health"}
