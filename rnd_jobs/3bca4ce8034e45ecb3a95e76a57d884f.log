{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013Luozeuq7UYXJQsbrctzm2","type":"tool_result","content":"1\t\"\"\"Readers for the ``reports/`` tree.\n2\t\n3\tW2: the morning glance surfaces (``latest_summary.json``, the briefing note, the\n4\tnewest weekly digest). W4 adds the per-sweep browser. Every reader fails soft —\n5\ta missing file yields ``None`` (never an exception) so the dashboard never 500s\n6\ton an absent report.\n7\t\"\"\"\n8\tfrom __future__ import annotations\n9\t\n10\timport json\n11\tfrom pathlib import Path\n12\t\n13\tfrom .freshness import iso_mtime\n14\t\n15\t\n16\tdef _read_text(path: Path) -> str | None:\n17\t    # errors=\"replace\": a stray cp1252 byte must never blank an entire report\n18\t    # (the quality build's W3 hit exactly this on Windows-encoded gh output).\n19\t    try:\n20\t        return path.read_text(encoding=\"utf-8\", errors=\"replace\")\n21\t    except (FileNotFoundError, OSError):\n22\t        return None\n23\t\n24\t\n25\tdef read_morning_summary(reports_dir: str | Path) -> dict | None:\n26\t    \"\"\"Parse ``reports/morning/latest_summary.json``. Returns the parsed object\n27\t    with an injected ``_as_of`` ISO stamp, or ``None`` if missing/corrupt.\"\"\"\n28\t    p = Path(reports_dir) / \"morning\" / \"latest_summary.json\"\n29\t    raw = _read_text(p)\n30\t    if raw is None:\n31\t        return None\n32\t    try:\n33\t        obj = json.loads(raw)\n34\t    except json.JSONDecodeError:\n35\t        return None\n36\t    if isinstance(obj, dict):\n37\t        obj[\"_as_of\"] = iso_mtime(p)\n38\t    return obj\n39\t\n40\t\n41\tdef read_briefing_note(reports_dir: str | Path) -> dict | None:\n42\t    \"\"\"The rendered daily briefing markdown (``latest_briefing_note.md``).\"\"\"\n43\t    p = Path(reports_dir) / \"morning\" / \"latest_briefing_note.md\"\n44\t    text = _read_text(p)\n45\t    if text is None:\n46\t        return None\n47\t    return {\"text\": text, \"as_of\": iso_mtime(p)}\n48\t\n49\t\n50\tdef read_latest_weekly(reports_dir: str | Path) -> dict | None:\n51\t    \"\"\"The newest ``reports/weekly/<YYYY-MM-DD>.md`` digest, by date in name.\"\"\"\n52\t    wdir = Path(reports_dir) / \"weekly\"\n53\t    if not wdir.is_dir():\n54\t        return None\n55\t    dated = sorted(\n56\t        (p for p in wdir.glob(\"*.md\") if _DATE_RE.match(p.stem)),\n57\t        key=lambda p: p.stem,\n58\t        reverse=True,\n59\t    )\n60\t    if not dated:\n61\t        return None\n62\t    p = dated[0]\n63\t    return {\"date\": p.stem, \"text\": _read_text(p) or \"\", \"as_of\": iso_mtime(p)}\n64\t\n65\t\n66\timport re\n67\t\n68\t_DATE_RE = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\n69\t\n70\t\n71\t# ── W4: per-sweep \"what was new\" browser ─────────────────────────────────────\n72\t\n73\tSWEEP_KINDS = (\"agents\", \"tools\", \"skills\", \"models\")\n74\t\n75\t\n76\tdef _valid_kind(kind: str) -> bool:\n77\t    return kind in SWEEP_KINDS\n78\t\n79\t\n80\tdef _valid_date(date: str) -> bool:\n81\t    return bool(_DATE_RE.match(date or \"\"))\n82\t\n83\t\n84\tdef list_sweep_dates(reports_dir: str | Path, kind: str, limit: int = 60) -> list[str]:\n85\t    \"\"\"Date dirs under ``reports/<kind>/``, newest first. ``[]`` for an unknown\n86\t    kind or absent dir (never raises).\"\"\"\n87\t    if not _valid_kind(kind):\n88\t        return []\n89\t    kdir = Path(reports_dir) / kind\n90\t    if not kdir.is_dir():\n91\t        return []\n92\t    dates = sorted(\n93\t        (p.name for p in kdir.iterdir() if p.is_dir() and _valid_date(p.name)),\n94\t        reverse=True,\n95\t    )\n96\t    return dates[:limit]\n97\t\n98\t\n99\tdef available_sweeps(reports_dir: str | Path, per_kind: int = 30) -> dict[str, list[str]]:\n100\t    \"\"\"{kind: [recent dates]} for the panel selector — only kinds present.\"\"\""}]},"parent_tool_use_id":"toolu_01ACwxJodXAE6No2Hnb7B6TY","session_id":"a7fcfbf6-6e6f-495e-9c53-2f0602be6ffe","uuid":"d57910eb-09e8-4f64-bf1c-2a3d44235bb0","timestamp":"2026-06-23T19:01:50.366Z","subagent_type":"Explore","task_description":"Map Aurora architecture & code"}
