{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GyaVnFgTHvC3wrRUJvM4tT","type":"tool_result","content":"1\t\"\"\"The dashboard blueprint factory.\n2\t\n3\t``create_blueprint(config)`` returns a Flask ``Blueprint`` exposing the\n4\t``/api/*`` surface and serving the static assets. It depends ONLY on\n5\t``dashboard.data`` (never on the Aurora sweep code), so mounting the dashboard\n6\tinto Anchor is just::\n7\t\n8\t    app.register_blueprint(create_blueprint(cfg))\n9\t\n10\tW1 ships: /api/health, /api/fingerprint, /api/state, and static serving.\n11\tLater waves add /api/morning (W2), /api/health[/detail] (W3),\n12\t/api/sweeps + /api/sweep/<kind>/<date> (W4), /api/catalog/* (W5).\n13\t\"\"\"\n14\tfrom __future__ import annotations\n15\t\n16\tfrom flask import Blueprint, Response, jsonify, request\n17\t\n18\tfrom ..config import DashboardConfig\n19\tfrom ..data import catalog, costs, freshness, health, reports\n20\tfrom ..data import db as _db\n21\tfrom ..data import models as _models\n22\t\n23\t\n24\tdef create_blueprint(config: DashboardConfig) -> Blueprint:\n25\t    static_dir = str(config.static_dir)\n26\t    bp = Blueprint(\n27\t        \"aurora_dashboard\",\n28\t        __name__,\n29\t        static_folder=static_dir,\n30\t        static_url_path=\"/dashboard-static\",\n31\t    )\n32\t\n33\t    # ── liveness + full health object (W1 liveness keys retained) ────────────\n34\t    @bp.route(\"/api/health\")\n35\t    def api_health():\n36\t        runs = health.run_status(config.kb_path)\n37\t        noise = health.noise_summary(config.reports_dir)\n38\t        backfills = health.backfill_audits(config.reports_dir)\n39\t        rejects = health.recent_rejects(config.reports_dir)\n40\t        return jsonify(\n41\t            {\n42\t                # W1 liveness (kept stable so the shell + W1 tests still pass)\n43\t                \"ok\": True,\n44\t                \"kb_present\": config.kb_path.exists(),\n45\t                \"reports_present\": config.reports_dir.exists(),\n46\t                # W3 health object\n47\t                \"runs\": runs,\n48\t                \"degraded_count\": sum(1 for r in runs if r.get(\"degraded\")),\n49\t                \"noise\": noise,\n50\t                \"backfills\": [\n51\t                    {k: v for k, v in b.items() if k != \"raw\"} for b in backfills\n52\t                ],\n53\t                \"rejects\": {\"date\": rejects[\"date\"], \"count\": len(rejects[\"rows\"]),\n54\t                            \"as_of\": rejects[\"as_of\"]},\n55\t                \"logs\": health.list_logs(config),\n56\t            }\n57\t        )\n58\t\n59\t    # ── human-readable value/health summary (W4 — the drill-down entry) ──────\n60\t    # `{ok, alerts, signals}` derived from run_status + the CC3 n-gated metric\n61\t    # set; /api/health/detail remains the per-signal drill-down. Must NEVER 500\n62\t    # on a sparse/pre-migration live KB (decisions absent, frontier_score NULL):\n63\t    # value_health_summary degrades each missing source to a pending/no_data\n64\t    # signal, and this handler wraps it so even an unexpected error returns a\n65\t    # graceful 200 body rather than a stack trace.\n66\t    @bp.route(\"/api/health/summary\")\n67\t    def api_health_summary():\n68\t        try:\n69\t            return jsonify(health.value_health_summary(config.kb_path))\n70\t        except Exception as exc:  # noqa: BLE001 — never 500 the live KB\n71\t            return jsonify({\"ok\": True, \"alerts\": [], \"signals\": {},\n72\t                            \"degraded\": f\"{type(exc).__name__}: {exc}\"})\n73\t\n74\t    # ── in-page detail for one health signal (G3) ───────────────────────────\n75\t    @bp.route(\"/api/health/detail\")\n76\t    def api_health_detail():\n77\t        kind = request.args.get(\"kind\", \"\")\n78\t        if kind == \"noise\":\n79\t            category = request.args.get(\"category\", \"\")\n80\t            return jsonify(\n81\t                health.noise_detail(config.kb_path, config.library_dir,\n82\t                                    config.reports_dir, category)\n83\t            )\n84\t        if kind == \"log\":\n85\t            name = request.args.get(\"name\", \"\")\n86\t            return jsonify(health.sweep_log_tail(config, name))\n87\t        if kind == \"rejects\":\n88\t            return jsonify(health.recent_rejects(config.reports_dir, n=50))\n89\t        if kind == \"backfill\":\n90\t            name = request.args.get(\"name\", \"\")\n91\t            for b in health.backfill_audits(config.reports_dir):\n92\t                if b[\"name\"] == name:\n93\t                    return jsonify(b)\n94\t            return jsonify({\"name\": name, \"raw\": None, \"missing\": True})\n95\t        return jsonify({\"error\": \"unknown signal kind\", \"kind\": kind}), 400\n96\t\n97\t    # ── freshness / poll ────────────────────────────────────────────────────\n98\t    @bp.route(\"/api/fingerprint\")\n99\t    def api_fingerprint():\n100\t        return jsonify({\"fingerprint\": freshness.fingerprint(freshness.watched_paths(config))})"}]},"parent_tool_use_id":"toolu_01ACwxJodXAE6No2Hnb7B6TY","session_id":"a7fcfbf6-6e6f-495e-9c53-2f0602be6ffe","uuid":"8af71fd9-fe8a-4036-a621-872a75d2f48d","timestamp":"2026-06-23T19:01:29.951Z","subagent_type":"Explore","task_description":"Map Aurora architecture & code"}
