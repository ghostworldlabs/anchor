{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RsrA7LNCDg1vzYRUTPygFy","type":"tool_result","content":"1\t\"\"\"Morning briefing renderer — invoked at 08:30 daily.\n2\tConsolidates the three nightly exec summaries plus budget, PAT expiry,\n3\tand KB delta. Writes to reports/morning/<YYYY-MM-DD>.md.\n4\t\n5\tBucket O-11 (2026-05-23): opens the DB in read-only mode (`mode=ro` URI) so\n6\tthe 08:30 briefing cannot ever stall or write-lock a sweep that overran into\n7\tits window. Apply `PRAGMA busy_timeout=5000` for the same reason.\"\"\"\n8\tfrom __future__ import annotations\n9\timport json\n10\timport re\n11\timport sqlite3\n12\tfrom datetime import datetime, timezone, timedelta\n13\tfrom pathlib import Path\n14\t\n15\tROOT = Path(__file__).resolve().parent\n16\tDB_PATH = ROOT / \"kb\" / \"aurora.db\"\n17\tREPORTS = ROOT / \"reports\"\n18\tMORNING = REPORTS / \"morning\"\n19\t\n20\t# --- Wave 1 (2026-06-09): de-noised, ranked top finds ---------------------\n21\t# arxiv URL/slug detection imported from the ONE shared source of truth\n22\t# (aurora/roles/_arxiv_patterns.py, F-W2-05) so the briefing, screener,\n23\t# backfill, and noise audit CANNOT drift. The shared SQL LIKE patterns are\n24\t# slightly BROADER than the briefing's old `%//arxiv.org/%` (they use\n25\t# `%arxiv.org/%`), so the exclusion only ever catches MORE mis-kinded arxiv,\n26\t# never fewer.\n27\tfrom aurora.roles._arxiv_patterns import (  # noqa: E402\n28\t    ARXIV_SLUG_GLOB as _ARXIV_SLUG_GLOB,\n29\t    ARXIV_URL_LIKE_PATTERNS as _ARXIV_URL_PATTERNS,\n30\t)\n31\t\n32\t# Vendor domains whose pages are marketing/docs, not installable artifacts.\n33\t# Seeded with developer.nvidia.com (E*: vendor tools headline otherwise);\n34\t# grown by Wave 2's source-type gate. A URL containing any entry is excluded.\n35\tVENDOR_DENYLIST = (\n36\t    \"developer.nvidia.com\",\n37\t)\n38\t\n39\t# Rank priority by kind (lower sorts first): skill > agent > tool > template.\n40\t_KIND_RANK = {\"skill\": 0, \"agent\": 1, \"tool\": 2, \"template\": 3}\n41\t\n42\t# U+FFFD REPLACEMENT CHARACTER — stripped from why-lines (interim until Wave 4).\n43\t_REPLACEMENT_CHAR = \"�\"\n44\t\n45\t# --- Wave 5 (2026-06-10): bounded usage modifier on the RANKING surfaces -----\n46\t# The SAME ±0.10 / 30-day-half-life usage modifier the HH server applies to the\n47\t# cosine score is applied here ON TOP OF interest_score, so a slug John loads\n48\t# rises (and one he dismisses falls) in top_finds + the weekly digest too. Read\n49\t# hh_events telemetry only — NEVER write (keep the read-only briefing path\n50\t# side-effect-free). Bound enforced by a tanh squash (see\n51\t# `_usage_modifier_for_net`): the modifier lies in the CLOSED interval\n52\t# [-0.10, +0.10] — saturation reaches the ±0.10 cap but never breaches it.\n53\t_USAGE_MODIFIER_MAX = 0.10\n54\t_USAGE_MODIFIER_HALFLIFE_DAYS = 30.0\n55\t_USAGE_MODIFIER_SCALE = 3.0\n56\t\n57\t\n58\tdef _usage_modifier_for_net(net_weight: float) -> float:\n59\t    \"\"\"Squash a net decayed (loaded - dismissed) weight to the CLOSED interval\n60\t    [-0.10, +0.10]. |tanh| <= 1 for all finite inputs (saturating to exactly\n61\t    ±1.0 for large |net|), so the product reaches the ±0.10 cap but never\n62\t    breaches it even under huge usage counts (the unbounded-feedback trap is\n63\t    closed by construction).\"\"\"\n64\t    import math\n65\t    return _USAGE_MODIFIER_MAX * math.tanh(net_weight / _USAGE_MODIFIER_SCALE)\n66\t\n67\t\n68\tdef _usage_modifiers_by_slug(conn: sqlite3.Connection, slugs: list[str],\n69\t                             *, now: datetime | None = None) -> dict:\n70\t    \"\"\"{slug: modifier} from hh_events for the given slugs (read-only). +weight\n71\t    per 'loaded', -weight per 'dismissed', weight = 0.5 ** (age_days / 30); the\n72\t    net is squashed to ±0.10. Fail-open: a missing table / read error yields {}\n73\t    (no slug shifts). This MIRRORS the HH server's modifier so the ranking\n74\t    surfaces and the recall path can never drift.\"\"\"\n75\t    slugs = [s for s in slugs if s]\n76\t    if not slugs or not _table_exists(conn, \"hh_events\"):\n77\t        return {}\n78\t    now = now or datetime.now(timezone.utc)\n79\t    placeholders = \",\".join(\"?\" for _ in slugs)\n80\t    try:\n81\t        rows = conn.execute(\n82\t            \"SELECT slug, outcome, recorded_at FROM hh_events \"\n83\t            f\"WHERE slug IN ({placeholders}) \"\n84\t            \"AND outcome IN ('loaded', 'dismissed')\",\n85\t            tuple(slugs),\n86\t        ).fetchall()\n87\t    except sqlite3.DatabaseError:\n88\t        return {}\n89\t    net: dict[str, float] = {}\n90\t    for slug, outcome, recorded_at in rows:\n91\t        if not slug or not recorded_at:\n92\t            continue\n93\t        try:\n94\t            ts = datetime.fromisoformat(recorded_at)\n95\t            if ts.tzinfo is None:\n96\t                ts = ts.replace(tzinfo=timezone.utc)\n97\t        except (ValueError, TypeError):\n98\t            continue\n99\t        age_days = max(0.0, (now - ts).total_seconds() / 86400.0)\n100\t        weight = 0.5 ** (age_days / _USAGE_MODIFIER_HALFLIFE_DAYS)\n101\t        if outcome == \"loaded\":\n102\t            net[slug] = net.get(slug, 0.0) + weight\n103\t        elif outcome == \"dismissed\":\n104\t            net[slug] = net.get(slug, 0.0) - weight\n105\t    return {s: _usage_modifier_for_net(w) for s, w in net.items()}\n106\t\n107\t\n108\tdef _open_ro() -> sqlite3.Connection:\n109\t    \"\"\"O-11: read-only connection with busy_timeout. Briefing never writes.\"\"\"\n110\t    conn = sqlite3.connect(f\"file:{DB_PATH}?mode=ro\", uri=True)\n111\t    try:\n112\t        conn.execute(\"PRAGMA busy_timeout=5000\")\n113\t    except sqlite3.DatabaseError:\n114\t        pass\n115\t    return conn\n116\t\n117\t\n118\tdef _table_exists(conn: sqlite3.Connection, name: str) -> bool:\n119\t    return conn.execute(\n120\t        \"SELECT 1 FROM sqlite_master WHERE type='table' AND name=?\", (name,)\n121\t    ).fetchone() is not None\n122\t\n123\t\n124\tdef _hh_yesterday(conn: sqlite3.Connection) -> dict | None:\n125\t    \"\"\"Helping Hand activity for yesterday (UTC). Returns None when the table\n126\t    is absent or there were zero events — the caller suppresses the block.\"\"\"\n127\t    if not _table_exists(conn, \"hh_events\"):\n128\t        return None\n129\t    yday = (datetime.now(timezone.utc) - timedelta(days=1)).strftime(\"%Y-%m-%d\")\n130\t    total = conn.execute(\n131\t        \"SELECT COUNT(*) FROM hh_events WHERE substr(recorded_at,1,10)=?\", (yday,)\n132\t    ).fetchone()[0]\n133\t    if not total:\n134\t        return None\n135\t\n136\t    sessions = conn.execute(\n137\t        \"SELECT COUNT(DISTINCT session_id) FROM hh_events \"\n138\t        \"WHERE substr(recorded_at,1,10)=?\", (yday,)\n139\t    ).fetchone()[0]\n140\t    distinct_queries = conn.execute(\n141\t        \"SELECT COUNT(DISTINCT query_sha256) FROM hh_events \"\n142\t        \"WHERE substr(recorded_at,1,10)=?\", (yday,)\n143\t    ).fetchone()[0]\n144\t    match_calls = 0\n145\t    if _table_exists(conn, \"hh_sessions\"):\n146\t        match_calls = conn.execute(\n147\t            \"SELECT COALESCE(SUM(match_calls),0) FROM hh_sessions \"\n148\t            \"WHERE substr(last_seen_at,1,10)=?\", (yday,)\n149\t        ).fetchone()[0]\n150\t    loaded = conn.execute("}]},"parent_tool_use_id":"toolu_01ACwxJodXAE6No2Hnb7B6TY","session_id":"a7fcfbf6-6e6f-495e-9c53-2f0602be6ffe","uuid":"5a9ed033-fff0-4645-bb00-fd84d7900432","timestamp":"2026-06-23T19:01:30.372Z","subagent_type":"Explore","task_description":"Map Aurora architecture & code"}
