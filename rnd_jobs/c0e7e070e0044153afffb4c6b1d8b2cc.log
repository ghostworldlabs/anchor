{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Updc5YwP4KcKsBv5UK18s3","type":"tool_result","content":"1\t\"\"\"Aurora orchestrator â€” entry point for nightly sweeps.\n2\t\n3\tUsage:\n4\t    python -m aurora.orchestrator --sweep skills              # live sweep\n5\t    python -m aurora.orchestrator --sweep skills --dry-run    # walk pipeline, no LLM calls\n6\t    python -m aurora.orchestrator --sweep skills --no-swarm   # skip runner+critics+reconciler (P2 mode)\n7\t\"\"\"\n8\tfrom __future__ import annotations\n9\timport argparse\n10\timport asyncio\n11\timport contextlib\n12\timport hashlib\n13\timport json\n14\timport logging\n15\timport os\n16\timport shutil\n17\timport sqlite3\n18\timport sys\n19\timport tempfile\n20\timport time\n21\tfrom datetime import datetime, timezone\n22\tfrom pathlib import Path\n23\tfrom typing import Optional\n24\t\n25\timport yaml\n26\tfrom dotenv import load_dotenv\n27\t\n28\tfrom aurora.sweeps import SWEEP_CONFIGS, SweepConfig\n29\tfrom aurora.roles import scout, quarantine as quarantine_role, static_screener\n30\tfrom aurora.roles import sanitizer as sanitizer_role\n31\tfrom aurora.roles import embedder, librarian\n32\tfrom aurora.roles import runner as runner_role\n33\tfrom aurora.roles import critic_a, critic_b, critic_c, reconciler\n34\tfrom aurora.roles import batch_sweep\n35\tfrom aurora.roles import evidence, shadow_diff\n36\tfrom aurora.roles import model_card_parser, benchmark_scraper, literature_reviewer, pricing_collector\n37\t# Wave-C (2026-05-25): advisor replaces literature_reviewer's call site below.\n38\t# We keep the literature_reviewer import for a 1-week rollback window.\n39\tfrom aurora.roles import advisor as advisor_role\n40\tfrom aurora.llm import CostRecorder\n41\tfrom aurora.exec_summary import write_summary, mtd_per_vendor\n42\t\n43\tlog = logging.getLogger(\"aurora.orchestrator\")\n44\t\n45\tROOT = Path(__file__).resolve().parent\n46\tDB_PATH = ROOT / \"kb\" / \"aurora.db\"\n47\tLOCK_PATH = ROOT / \"lock\" / \"sweep.lock\"\n48\tLOG_DIR = ROOT / \"logs\"\n49\tLIBRARY_ROOT = ROOT / \"library\"\n50\tREPORTS_ROOT = ROOT / \"reports\"\n51\t\n52\tMONTHLY_CAPS = {\"anthropic\": 50.00, \"gemini\": 10.00}\n53\t\n54\t# Bucket J4 (v4.3, 2026-05-19 PM): per-sweep budget guardrail.\n55\t# Bucket O-12 (2026-05-23): per-role budget cells. The 15-20% overshoot pattern\n56\t# from J4 was critic_b-token-blowup-dominated; per-role cells isolate which\n57\t# throttle. The total still applies (sum of cells â‰¤ PER_SWEEP_BUDGET_USD).\n58\t# Cells are PROPORTIONAL â€” derived from observed nightly cost ratios. Adjust\n59\t# as the system grows; the guardrail prefers conservative (lower) caps.\n60\t_SWEEPS_PER_DAY = 3"}]},"parent_tool_use_id":null,"session_id":"71e5a556-8710-4d10-b60c-86fc91c9365e","uuid":"6f19fa31-54a7-4784-9891-11689aa9e8a2","timestamp":"2026-06-13T16:03:29.366Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\dev\\aurora\\orchestrator.py","content":"\"\"\"Aurora orchestrator â€” entry point for nightly sweeps.\n\nUsage:\n    python -m aurora.orchestrator --sweep skills              # live sweep\n    python -m aurora.orchestrator --sweep skills --dry-run    # walk pipeline, no LLM calls\n    python -m aurora.orchestrator --sweep skills --no-swarm   # skip runner+critics+reconciler (P2 mode)\n\"\"\"\nfrom __future__ import annotations\nimport argparse\nimport asyncio\nimport contextlib\nimport hashlib\nimport json\nimport logging\nimport os\nimport shutil\nimport sqlite3\nimport sys\nimport tempfile\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Optional\n\nimport yaml\nfrom dotenv import load_dotenv\n\nfrom aurora.sweeps import SWEEP_CONFIGS, SweepConfig\nfrom aurora.roles import scout, quarantine as quarantine_role, static_screener\nfrom aurora.roles import sanitizer as sanitizer_role\nfrom aurora.roles import embedder, librarian\nfrom aurora.roles import runner as runner_role\nfrom aurora.roles import critic_a, critic_b, critic_c, reconciler\nfrom aurora.roles import batch_sweep\nfrom aurora.roles import evidence, shadow_diff\nfrom aurora.roles import model_card_parser, benchmark_scraper, literature_reviewer, pricing_collector\n# Wave-C (2026-05-25): advisor replaces literature_reviewer's call site below.\n# We keep the literature_reviewer import for a 1-week rollback window.\nfrom aurora.roles import advisor as advisor_role\nfrom aurora.llm import CostRecorder\nfrom aurora.exec_summary import write_summary, mtd_per_vendor\n\nlog = logging.getLogger(\"aurora.orchestrator\")\n\nROOT = Path(__file__).resolve().parent\nDB_PATH = ROOT / \"kb\" / \"aurora.db\"\nLOCK_PATH = ROOT / \"lock\" / \"sweep.lock\"\nLOG_DIR = ROOT / \"logs\"\nLIBRARY_ROOT = ROOT / \"library\"\nREPORTS_ROOT = ROOT / \"reports\"\n\nMONTHLY_CAPS = {\"anthropic\": 50.00, \"gemini\": 10.00}\n\n# Bucket J4 (v4.3, 2026-05-19 PM): per-sweep budget guardrail.\n# Bucket O-12 (2026-05-23): per-role budget cells. The 15-20% overshoot pattern\n# from J4 was critic_b-token-blowup-dominated; per-role cells isolate which\n# throttle. The total still applies (sum of cells â‰¤ PER_SWEEP_BUDGET_USD).\n# Cells are PROPORTIONAL â€” derived from observed nightly cost ratios. Adjust\n# as the system grows; the guardrail prefers conservative (lower) caps.\n_SWEEPS_PER_DAY = 3","numLines":60,"startLine":1,"totalLines":1457}}}
