{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J4dP4ZD1yh99LNU2TkiseV","type":"tool_result","content":"1\t# Anchor R&D per-project store — tracking policy (reconciles C9 + C10).\n2\t#\n3\t# C9 (durable/git-trackable): the lightweight JSON *pointer-records* that index\n4\t#   each project's efforts ARE meant to be committed so history survives.\n5\t# C10 (no personal-data leak / shareable distro): raw run logs, large engine\n6\t#   outputs, and anything that may carry absolute paths / tokens / personal\n7\t#   data are git-IGNORED here and excluded by the distribution scan (Wave 8).\n8\t#\n9\t# Default: ignore the heavy/volatile artifacts; allow-list the pointer records.\n10\t\n11\tprojects/*/jobs/\n12\tprojects/*/**/*.log\n13\tprojects/*/**/*.pdf\n14\tprojects/*/**/raw/\n15\t\n16\t# Re-include the small pointer-record JSON index files (git-trackable).\n17\t!projects/*/**/index.json\n18\t!projects/*/**/*.pointer.json\n19\t"}]},"parent_tool_use_id":null,"session_id":"16a9bdd0-f93f-4912-8d3b-5b01a38c458f","uuid":"c0b40695-e1e4-43bf-83b8-f213f67d84d0","timestamp":"2026-06-24T04:50:24.669Z","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/john/AppData/Local/Temp/pytest-of-john/pytest-2176/test_single_instance_returns_s0/P/.anchor/.gitignore","content":"# Anchor R&D per-project store — tracking policy (reconciles C9 + C10).\n#\n# C9 (durable/git-trackable): the lightweight JSON *pointer-records* that index\n#   each project's efforts ARE meant to be committed so history survives.\n# C10 (no personal-data leak / shareable distro): raw run logs, large engine\n#   outputs, and anything that may carry absolute paths / tokens / personal\n#   data are git-IGNORED here and excluded by the distribution scan (Wave 8).\n#\n# Default: ignore the heavy/volatile artifacts; allow-list the pointer records.\n\nprojects/*/jobs/\nprojects/*/**/*.log\nprojects/*/**/*.pdf\nprojects/*/**/raw/\n\n# Re-include the small pointer-record JSON index files (git-trackable).\n!projects/*/**/index.json\n!projects/*/**/*.pointer.json\n","numLines":19,"startLine":1,"totalLines":19}}}
