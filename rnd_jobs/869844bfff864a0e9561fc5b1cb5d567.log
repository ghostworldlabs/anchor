{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HHX2RYePMQ2rxh953DNUat","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"STUB Stage-A runner — emits a canned Gandalf RAW draft in a result envelope.\n3\t\n4\tWired in via ``ANCHOR_RUNNER_CMD`` (like ``tests/fake_claude.py`` /\n5\t``tests/stub_streamjson.py``) so a Gandalf engine test never calls real\n6\t``claude``. It emits the production stream-json envelope shape (a terminal\n7\t``{\"type\":\"result\",\"result\":\"<raw draft JSON>\"}`` line) carrying ONE compact\n8\tRAW-draft JSON object per ``runtime/RAW-DRAFT-CONTRACT.md`` — the un-stamped\n9\tfindings/elevations the host then grades.\n10\t\n11\tOverride the emitted draft via ``STUB_GANDALF_DRAFT`` (a JSON string). When set\n12\tto the literal ``UNPARSEABLE``, emit prose with NO balanced JSON object so the\n13\tStage-A unparseable-draft degrade path can be exercised. Exit 0.\n14\t\n15\tNEVER live — a STUB only. Stdlib only.\n16\t\"\"\"\n17\timport json\n18\timport os\n19\timport sys\n20\t\n21\t\n22\t#: A minimal but contract-valid RAW draft (the model's un-stamped output).\n23\t_DEFAULT_DRAFT = {\n24\t    \"reasoning\": \"The project has a clear objective and a coherent structure; the \"\n25\t                 \"trio docs are present and the test gate is green.\",\n26\t    \"verdict\": \"This is broadly sound, with one durability gap worth watching.\",\n27\t    \"findings\": [\n28\t        {\n29\t            \"id\": \"d-1\",\n30\t            \"kind\": \"diagnose\",\n31\t            \"rung\": \"OBSERVED\",\n32\t            \"reasoning\": \"The test gate runs green at the documented baseline.\",\n33\t            \"verdict\": \"The build is in a healthy, tested state.\",\n34\t            \"severity\": \"minor\",\n35\t        }\n36\t    ],\n37\t    \"nitpicks\": [\n38\t        {\n39\t            \"id\": \"n-1\",\n40\t            \"rung\": \"CLAIMED\",\n41\t            \"reasoning\": \"A few docstrings drift from the current behavior.\",\n42\t            \"verdict\": \"Minor doc drift; low stakes.\",\n43\t        }\n44\t    ],\n45\t    \"elevations\": [\n46\t        {\n47\t            \"id\": \"e-1\",\n48\t            \"value_if_true\": \"medium\",\n49\t            \"rung\": \"UNVERIFIED\",\n50\t            \"reasoning\": \"A periodic re-analysis would catch drift earlier.\",\n51\t            \"verdict\": \"Consider scheduling a recurring read.\",\n52\t            \"what_would_refute_it\": \"If drift never recurs across three release \"\n53\t                                    \"cycles, the scheduling cost is unjustified.\",\n54\t        }\n55\t    ],\n56\t}\n57\t\n58\t\n59\tdef main():\n60\t    counter = os.environ.get(\"STUB_GANDALF_COUNTER\")\n61\t    if counter:\n62\t        try:\n63\t            with open(counter, \"a\", encoding=\"utf-8\") as fh:\n64\t                fh.write(\"x\")\n65\t        except OSError:\n66\t            pass\n67\t\n68\t    raw = (os.environ.get(\"STUB_GANDALF_DRAFT\") or \"\").strip()\n69\t    if raw == \"UNPARSEABLE\":\n70\t        answer = \"I analyzed the project but could not produce structured output.\"\n71\t    elif raw:\n72\t        answer = raw\n73\t    else:\n74\t        answer = json.dumps(_DEFAULT_DRAFT, ensure_ascii=False)\n75\t\n76\t    def emit(obj):\n77\t        sys.stdout.write(json.dumps(obj) + \"\\n\")\n78\t        sys.stdout.flush()\n79\t\n80\t    emit({\"type\": \"system\", \"subtype\": \"init\", \"session_id\": \"stub-gandalf\"})\n81\t    emit({\"type\": \"assistant\",\n82\t          \"message\": {\"role\": \"assistant\",\n83\t                      \"content\": [{\"type\": \"text\", \"text\": answer}]},\n84\t          \"session_id\": \"stub-gandalf\"})\n85\t    emit({\"type\": \"result\", \"subtype\": \"success\", \"is_error\": False,\n86\t          \"result\": answer, \"total_cost_usd\": 0.0,\n87\t          \"usage\": {\"input_tokens\": 1, \"output_tokens\": 1},\n88\t          \"duration_ms\": 1, \"session_id\": \"stub-gandalf\"})\n