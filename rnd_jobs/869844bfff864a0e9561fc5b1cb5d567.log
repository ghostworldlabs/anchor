e d; print('count:', len(ps)); [print(' -', (p.get('name') or p.get('id'))[:40], '|', (p.get('folder_path') or '')[:50]) for p in (ps.values() if isinstance(ps,dict) else ps)]\" 2>&1 | head -30","description":"List registered R&D projects to see real usage"}}],"terminal_reason":"completed","fast_mode_state":"off","uuid":"f9e8a56c-6670-498d-a667-a5f8da8e015e"}
