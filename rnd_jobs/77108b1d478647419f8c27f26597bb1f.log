{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012DFBcfqhVQfWCtLXWH7DTs","type":"tool_result","content":"1\t\"\"\"Fleet health signals + in-page detail (W3 — the operator console).\n2\t\n3\tSurfaces, read-only:\n4\t- ``run_status``      — the latest ``runs`` row per sweep + a degrade flag\n5\t                        (critic_c abstain / errors).\n6\t- ``noise_summary``   — the ``noise_audit`` block from latest_summary.json.\n7\t- ``noise_detail``    — offending examples for the FILESYSTEM categories\n8\t                        (dead_library_links, retired_in_surfaces), derived\n9\t                        read-only so they can expand in-page. The KB-pattern\n10\t                        categories (arxiv/vendor/pointer) show counts + a rule\n11\t                        pointer — the dashboard stays portable (no roles/ import)\n12\t                        and never re-derives canonical patterns.\n13\t- ``backfill_audits`` — latest per-backfill audit JSON + a changed/err summary.\n14\t- ``recent_rejects``  — tail of the newest screen_rejects/<date>.jsonl.\n15\t- ``sweep_log_tail``  — last N lines of an ALLOWLISTED log file (logs/reports\n16\t                        only; path traversal refused — secrets like .env can\n17\t                        never be tailed).\n18\t\"\"\"\n19\tfrom __future__ import annotations\n20\t\n21\timport json\n22\timport re\n23\tfrom pathlib import Path\n24\t\n25\tfrom . import db\n26\tfrom .freshness import iso_mtime\n27\t\n28\t# critic_c states that mean \"ran degraded\" (vs ok/None-not-applicable).\n29\t_DEGRADE_STATES = {\"abstain_no_key\", \"degraded\", \"error\", \"rate_limited\"}\n30\t_FILESYSTEM_NOISE = {\"dead_library_links\", \"retired_in_surfaces\"}\n31\t_LOG_NAME_RE = re.compile(r\"^[A-Za-z0-9._-]+\\.log$\")\n32\t\n33\t\n34\t# ── runs / degrade ───────────────────────────────────────────────────────────\n35\t\n36\tdef run_status(kb_path: str | Path) -> list[dict]:\n37\t    \"\"\"Latest run per sweep, newest first, each with a ``degraded`` flag.\"\"\"\n38\t    rows = db.query(\n39\t        kb_path,\n40\t        \"\"\"\n41\t        SELECT r.sweep, r.status, r.started_at, r.finished_at,\n42\t               r.critic_c_status, r.critic_c_calls, r.critic_c_errors\n43\t        FROM runs r\n44\t        JOIN (SELECT sweep, MAX(started_at) AS ms FROM runs GROUP BY sweep) m\n45\t          ON r.sweep = m.sweep AND r.started_at = m.ms\n46\t        ORDER BY r.started_at DESC\n47\t        \"\"\",\n48\t    )\n49\t    for r in rows:\n50\t        cstat = r.get(\"critic_c_status\")\n51\t        r[\"degraded\"] = bool(\n52\t            (cstat in _DEGRADE_STATES) or ((r.get(\"critic_c_errors\") or 0) > 0)\n53\t        )\n54\t    return rows\n55\t\n56\t\n57\t# ── noise audit ──────────────────────────────────────────────────────────────\n58\t\n59\tdef _summary_path(reports_dir: Path) -> Path:\n60\t    return Path(reports_dir) / \"morning\" / \"latest_summary.json\"\n61\t\n62\t\n63\tdef noise_summary(reports_dir: str | Path) -> dict:\n64\t    \"\"\"The noise_audit block from latest_summary.json (counts + total).\n65\t    Returns ``{}`` (with as_of None) when no summary exists.\"\"\"\n66\t    p = _summary_path(Path(reports_dir))\n67\t    try:\n68\t        obj = json.loads(p.read_text(encoding=\"utf-8\"))\n69\t    except (FileNotFoundError, OSError, json.JSONDecodeError):\n70\t        return {\"categories\": {}, \"total\": 0, \"as_of\": None}\n71\t    na = obj.get(\"noise_audit\") or {}\n72\t    total = na.get(\"total\", 0)\n73\t    categories = {k: v for k, v in na.items() if k != \"total\"}\n74\t    return {\"categories\": categories, \"total\": total, \"as_of\": iso_mtime(p)}\n75\t\n76\t\n77\tdef _live_slugs_by_kind(kb_path: str | Path) -> tuple[dict[tuple[str, str], int], dict[tuple[str, str], int]]:\n78\t    \"\"\"Return ((kind,slug)->id for LIVE rows, (kind,slug)->id for RETIRED rows).\n79\t    Library dirs live under ``library/<kind-plural>/<slug>``; the KB ``kind`` is\n80\t    singular, so the caller maps kind->dir.\"\"\"\n81\t    live, retired = {}, {}\n82\t    for r in db.query(kb_path, \"SELECT id, kind, slug, retired_at FROM artifacts\"):\n83\t        key = (r[\"kind\"], r[\"slug\"])\n84\t        (retired if r[\"retired_at\"] else live)[key] = r[\"id\"]\n85\t    return live, retired\n86\t\n87\t\n88\t# library dir name (plural) -> KB kind (singular)\n89\t_DIR_TO_KIND = {\n90\t    \"skills\": \"skill\", \"tools\": \"tool\", \"agents\": \"agent\",\n91\t    \"templates\": \"template\", \"models\": \"model\", \"papers\": \"paper\",\n92\t}\n93\t\n94\t\n95\tdef noise_detail(kb_path: str | Path, library_dir: str | Path, reports_dir: str | Path,\n96\t                 category: str, limit: int = 200) -> dict:\n97\t    \"\"\"Offending examples for one noise category.\n98\t\n99\t    Filesystem categories (dead_library_links / retired_in_surfaces) are derived\n100\t    read-only by walking ``library/`` against the KB. Pattern categories return\n101\t    their count + a rule pointer (no canonical-pattern duplication).\"\"\"\n102\t    summ = noise_summary(reports_dir)\n103\t    count = summ[\"categories\"].get(category, 0)\n104\t    if category not in _FILESYSTEM_NOISE:\n105\t        return {\n106\t            \"category\": category, \"count\": count, \"examples\": [],\n107\t            \"note\": \"Count from the nightly noise audit. Per-row detail for \"\n108\t                    \"pattern categories lives in bin/noise_audit.py (the dashboard \"\n109\t                    \"stays portable and does not re-derive canonical patterns).\",\n110\t        }\n111\t\n112\t    lib = Path(library_dir)\n113\t    live, retired = _live_slugs_by_kind(kb_path)\n114\t    examples: list[str] = []\n115\t    if lib.is_dir():\n116\t        for kind_dir in sorted(lib.iterdir()):\n117\t            if not kind_dir.is_dir():\n118\t                continue\n119\t            kind = _DIR_TO_KIND.get(kind_dir.name)\n120\t            if kind is None:\n121\t                continue\n122\t            for slug_dir in sorted(kind_dir.iterdir()):\n123\t                if not slug_dir.is_dir():\n124\t                    continue\n125\t                key = (kind, slug_dir.name)\n126\t                rel = f\"{kind_dir.name}/{slug_dir.name}\"\n127\t                if category == \"retired_in_surfaces\" and key in retired:\n128\t                    examples.append(rel)\n129\t                elif category == \"dead_library_links\" and key not in live and key not in retired:\n130\t                    examples.append(rel)\n131\t                if len(examples) >= limit:\n132\t                    break\n133\t            if len(examples) >= limit:\n134\t                break\n135\t    note = None\n136\t    if not (len(examples) >= limit) and len(examples) != count:\n137\t        # The canonical audit (bin/noise_audit.py) also counts active rows whose\n138\t        # card dir is missing; the dashboard shows the dominant dir-orphan subset\n139\t        # read-only. Surface the gap honestly rather than imply an exact match.\n140\t        note = (f\"Showing {len(examples)} library dirs with no matching artifact row; \"\n141\t                f\"the audit total ({count}) may also include active rows missing a card.\")\n142\t    return {\"category\": category, \"count\": count, \"examples\": examples,\n143\t            \"truncated\": len(examples) >= limit, \"note\": note}\n144\t\n145\t\n146\t# ── backfill audits ──────────────────────────────────────────────────────────\n147\t\n148\tdef _summarize_backfill(obj: dict) -> tuple[dict, bool]:\n149\t    \"\"\"Reduce a backfill audit JSON to (counts, has_error).\"\"\"\n150\t    counts: dict[str, int] = {}"}]},"parent_tool_use_id":"toolu_01UkhjqCpsBaWTEbkLkiiJeJ","session_id":"0e9f13f6-4032-41a4-8d9f-b9e18c221609","uuid":"d8e8e1e5-6ba1-4b2f-bf0f-dc7dac5111e1","timestamp":"2026-06-23T18:40:26.313Z","subagent_type":"Explore","task_description":"Explore Aurora core architecture"}
