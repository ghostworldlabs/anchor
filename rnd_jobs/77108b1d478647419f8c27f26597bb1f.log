{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QRB8j9DjWAdMEoQcwqRwyU","type":"tool_result","content":"1\t\"\"\"Publisher — runs after the Agents sweep (01:45 daily per plan §16.2).\n2\t\n3\tBuilds a scrubbed kb-snapshot.sqlite (no transcripts, no artifact bundles),\n4\tgenerates the daily CHANGELOG entry, stages an explicit allowlist of paths,\n5\tand (when not in --dry-run) git commit + tag YYYYMMDD + push.\n6\t\n7\tP8 scaffold: --dry-run mode shows what would be staged. Live push needs the\n8\tuser to create the aurora-library private repo on GitHub and set GITHUB_PAT +\n9\tGITHUB_REPO in .env, then run `python -m aurora.publisher` (no --dry-run).\n10\t\"\"\"\n11\tfrom __future__ import annotations\n12\timport argparse\n13\timport hashlib\n14\timport json\n15\timport os\n16\timport shutil\n17\timport sqlite3\n18\timport subprocess\n19\timport sys\n20\timport tempfile\n21\tfrom datetime import datetime, timezone\n22\tfrom pathlib import Path\n23\t\n24\t# Force line-buffered stdout/stderr so cmd-launcher and scheduled-task callers\n25\t# see progress in real time instead of one big buffered dump (or nothing).\n26\ttry:\n27\t    sys.stdout.reconfigure(line_buffering=True)\n28\t    sys.stderr.reconfigure(line_buffering=True)\n29\texcept Exception:\n30\t    pass\n31\t\n32\t# Publisher is a stand-alone entry point — it must NOT depend on its caller\n33\t# loading .env. Load it ourselves.\n34\ttry:\n35\t    from dotenv import load_dotenv\n36\t    load_dotenv(Path(__file__).resolve().parent / \".env\", override=False)\n37\texcept Exception:\n38\t    pass\n39\t\n40\t# Wave 2 (2026-06-06) — single-owner gate predicate. Publisher is an in-package\n41\t# enforcement point, so it imports the gate clause from its sole owner rather\n42\t# than re-typing the servable SQL literal (the converged Shark finding).\n43\tfrom aurora.roles.security import gate\n44\t\n45\tROOT = Path(__file__).resolve().parent\n46\tDB_PATH = ROOT / \"kb\" / \"aurora.db\"\n47\tLIBRARY_ROOT = ROOT / \"library\"\n48\tREPORTS_ROOT = ROOT / \"reports\"\n49\tSEED_MAP_ROOT = ROOT / \"seed_map\"\n50\tHELPING_HAND_PLUGIN = ROOT / \"helping-hand-plugin\"\n51\tPUBLISH_ROOT = ROOT / \"_publish\"     # local staging tree\n52\tSNAPSHOT_NAME = \"kb-snapshot.sqlite\"\n53\t\n54\t# ── Awareness Revamp Wave 3 (2026-06-12): model_benchmarks CC1 disposition ────\n55\t# model_benchmarks disposition = PUBLISH-WITH-LICENSE-FILTER. The table SHIPS,\n56\t# but the publisher deletes every cell that is null-license, non-allowed-license,\n57\t# or restricted-source BEFORE the final VACUUM. These two sets are the auditable\n58\t# policy (RESEARCH §B-5/§B-6): Epoch CC-BY-4.0 and Aider/Terminal-Bench\n59\t# Apache-2.0 are redistributable; Artificial-Analysis-derived and OpenRouter-\n60\t# derived cells are NOT (scrubbed by source regardless of license).\n61\tALLOWED_BENCHMARK_LICENSES = (\"CC-BY-4.0\", \"Apache-2.0\")\n62\tEXCLUDED_BENCHMARK_SOURCES = (\"artificial-analysis\", \"openrouter\")\n63\t\n64\t\n65\t# Wave C C3 (2026-05-29): Aurora Sentinel security gate.\n66\t# Mode-aware SQL fragment for filtering non-clean artifacts out of the\n67\t# published snapshot + the published library/ copytree. Two of the four\n68\t# §4.2 enforcement points live in this file (the other two live in\n69\t# librarian.upsert_artifact and the MCP server).\n70\tdef _security_gate_clause(table_alias: str = \"a\") -> str:\n71\t    \"\"\"Mode-aware servable clause for the snapshot SELECT (§4.2 enforcement\n72\t    point #3). Delegates to the single owner gate.enforcement_clause() so the\n73\t    servable SQL literal lives in exactly one file (roles/security/gate.py).\"\"\"\n74\t    return gate.enforcement_clause(table_alias)\n75\t\n76\t\n77\tdef _artifact_is_servable_in_snapshot(conn: sqlite3.Connection,\n78\t                                       slug: str) -> bool:\n79\t    \"\"\"Predicate for the copytree filter (§4.2 enforcement point #4). Returns\n80\t    True when this slug's most recent artifact row passes the gate; True in\n81\t    shadow/off so calibration data flows through.\n82\t\n83\t    Lookup is by slug-only (most-recent row wins on ties) because the\n84\t    library directory layout `library/<kind>/<slug>/` indexes by slug. In\n85\t    practice (sweep, slug) is unique per kind, so this is unambiguous for\n86\t    any catalog populated by the current librarian.\n87\t\n88\t    Wave 2 (2026-06-10) — retired pages must NEVER ship (E20). This predicate is\n89\t    evaluated FIRST, UNCONDITIONALLY, BEFORE the AURORA_SECURITY_MODE early-\n90\t    return below — because in production that env var is UNSET, and a check\n91\t    placed after the early-return would be dead code that never runs. A slug\n92\t    whose most-recent row is retired is non-servable regardless of security mode.\n93\t    \"\"\"\n94\t    try:\n95\t        rrow = conn.execute(\n96\t            \"SELECT retired_at FROM artifacts \"\n97\t            \"WHERE slug=? ORDER BY last_verified_at DESC LIMIT 1\",\n98\t            (slug,),\n99\t        ).fetchone()\n100\t        if rrow is not None and rrow[0] is not None:\n101\t            return False\n102\t    except sqlite3.DatabaseError:\n103\t        # retired_at column missing on this (very old) build — can't enforce\n104\t        # retirement; fall through to the security gate below.\n105\t        pass\n106\t\n107\t    if os.environ.get(\"AURORA_SECURITY_MODE\", \"off\").strip().lower() != \"enforce\":\n108\t        return True\n109\t    try:\n110\t        row = conn.execute(\n111\t            \"SELECT security_status FROM artifacts \"\n112\t            \"WHERE slug=? ORDER BY last_verified_at DESC LIMIT 1\",\n113\t            (slug,),\n114\t        ).fetchone()\n115\t    except sqlite3.DatabaseError:\n116\t        # security_status column missing => fail open (column doesn't exist\n117\t        # on this build; can't enforce). Logged at the call site.\n118\t        return True\n119\t    if row is None:\n120\t        # Card exists on disk but no DB row — legacy or orphan. Don't ship.\n121\t        return False\n122\t    return row[0] in gate.SERVABLE_VERDICTS\n123\t\n124\t\n125\t# Paths that get pushed (explicit allowlist — no .gitignore-based exclusion)\n126\tSYNC_ALLOWLIST = [\n127\t    \"library\",                # includes _map.html (sunburst) since v4.2\n128\t    \"library/_model_grid.html\",  # Bucket L M-9: explicit for clarity (library/ already covers it)\n129\t    \"reports\",\n130\t    \"seed_map\",               # current YAMLs only; quarantine/ excluded below\n131\t    SNAPSHOT_NAME,\n132\t    \"helping-hand.plugin\",\n133\t    \"helping-hand-plugin\",    # source dir for collaborators who want to inspect\n134\t    \"CHANGELOG.md\",\n135\t    \"README.md\",\n136\t    \"CONTRIBUTORS.md\",        # added v4.2 (Bucket A #4); empty stub until collaborators arrive\n137\t    \"COLLABORATOR-SETUP.md\",  # one-pager for clone-and-go install\n138\t]\n139\t\n140\t\n141\tdef _now_iso() -> str:\n142\t    return datetime.now(timezone.utc).isoformat()\n143\t\n144\t\n145\tdef _sha256(path: Path) -> str:\n146\t    h = hashlib.sha256()\n147\t    with open(path, \"rb\") as f:\n148\t        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n149\t            h.update(chunk)\n150\t    return h.hexdigest()\n151\t\n152\t\n153\tdef build_snapshot() -> Path:\n154\t    \"\"\"Make a scrubbed, vacuumed copy of aurora.db at _publish/kb-snapshot.sqlite.\n155\t\n156\t    Bucket O-13 (2026-05-23) — forensic-safe snapshot dance:\n157\t\n158\t      1. `PRAGMA wal_checkpoint(TRUNCATE)` on source so the WAL is empty\n159\t         (otherwise WAL plaintext survives anything we do downstream).\n160\t      2. `VACUUM INTO 'kb-snapshot.wip.sqlite'` — single atomic op that\n161\t         rewrites every allocated page into a fresh file. Unlike `backup()`,\n162\t         this does NOT copy free-page debris from the source.\n163\t      3. Open the wip file with restrictive perms; enable\n164\t         `PRAGMA secure_delete=ON` so subsequent UPDATE/DROP scrubs zero\n165\t         deleted content on subsequent writes.\n166\t      4. Run scrubs (see SCRUB_STATEMENTS).\n167\t      5. `VACUUM` again on wip to compact post-scrub free pages.\n168\t      6. `os.replace(wip, snap)` — atomic publish.\n169\t\n170\t    The \"backup() + scrub\" v1 inherited freelist debris from `aurora.db` and\n171\t    left dropped-row contents recoverable via forensics in the published\n172\t    snapshot. v2 closes that.\n173\t    \"\"\"\n174\t    PUBLISH_ROOT.mkdir(parents=True, exist_ok=True)\n175\t    snap = PUBLISH_ROOT / SNAPSHOT_NAME\n176\t    wip = PUBLISH_ROOT / \"kb-snapshot.wip.sqlite\"\n177\t    if snap.exists():\n178\t        snap.unlink()\n179\t    if wip.exists():\n180\t        wip.unlink()\n181\t\n182\t    # 1. Checkpoint + drain the WAL on source so VACUUM INTO sees a coherent\n183\t    # snapshot with no plaintext lingering in -wal.\n184\t    src = sqlite3.connect(str(DB_PATH))\n185\t    try:\n186\t        src.execute(\"PRAGMA busy_timeout=5000\")\n187\t    except sqlite3.DatabaseError:\n188\t        pass\n189\t    try:\n190\t        src.execute(\"PRAGMA wal_checkpoint(TRUNCATE)\")\n191\t    except sqlite3.DatabaseError as e:\n192\t        print(f\"publisher: wal_checkpoint warning: {e}\", flush=True)\n193\t\n194\t    # 2. VACUUM INTO — atomic single-op rewrite of every allocated page into\n195\t    # a fresh file; free pages and dropped-row debris are NOT carried over.\n196\t    src.execute(\"VACUUM INTO ?\", (str(wip),))\n197\t    src.close()\n198\t\n199\t    # 3. Restrict perms on the wip file (it briefly contains the un-scrubbed\n200\t    # data). Best-effort — Windows ACLs don't honor 0o600 in the POSIX sense"}]},"parent_tool_use_id":"toolu_01UkhjqCpsBaWTEbkLkiiJeJ","session_id":"0e9f13f6-4032-41a4-8d9f-b9e18c221609","uuid":"aa799a8f-b988-4f2a-a7f5-3f8e05016d4d","timestamp":"2026-06-23T18:39:55.112Z","subagent_type":"Explore","task_description":"Explore Aurora core architecture"}
