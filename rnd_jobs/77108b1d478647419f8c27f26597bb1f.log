{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BPiD1k4Ghs5yNmpoehdFLU","type":"tool_result","content":"1\t\"\"\"Morning briefing renderer — invoked at 08:30 daily.\n2\tConsolidates the three nightly exec summaries plus budget, PAT expiry,\n3\tand KB delta. Writes to reports/morning/<YYYY-MM-DD>.md.\n4\t\n5\tBucket O-11 (2026-05-23): opens the DB in read-only mode (`mode=ro` URI) so\n6\tthe 08:30 briefing cannot ever stall or write-lock a sweep that overran into\n7\tits window. Apply `PRAGMA busy_timeout=5000` for the same reason.\"\"\"\n8\tfrom __future__ import annotations\n9\timport json\n10\timport re\n11\timport sqlite3\n12\tfrom datetime import datetime, timezone, timedelta\n13\tfrom pathlib import Path\n14\t\n15\tROOT = Path(__file__).resolve().parent\n16\tDB_PATH = ROOT / \"kb\" / \"aurora.db\"\n17\tREPORTS = ROOT / \"reports\"\n18\tMORNING = REPORTS / \"morning\"\n19\t\n20\t# --- Wave 1 (2026-06-09): de-noised, ranked top finds ---------------------\n21\t# arxiv URL/slug detection imported from the ONE shared source of truth\n22\t# (aurora/roles/_arxiv_patterns.py, F-W2-05) so the briefing, screener,\n23\t# backfill, and noise audit CANNOT drift. The shared SQL LIKE patterns are\n24\t# slightly BROADER than the briefing's old `%//arxiv.org/%` (they use\n25\t# `%arxiv.org/%`), so the exclusion only ever catches MORE mis-kinded arxiv,\n26\t# never fewer.\n27\tfrom aurora.roles._arxiv_patterns import (  # noqa: E402\n28\t    ARXIV_SLUG_GLOB as _ARXIV_SLUG_GLOB,\n29\t    ARXIV_URL_LIKE_PATTERNS as _ARXIV_URL_PATTERNS,\n30\t)\n31\t\n32\t# Vendor domains whose pages are marketing/docs, not installable artifacts.\n33\t# Seeded with developer.nvidia.com (E*: vendor tools headline otherwise);\n34\t# grown by Wave 2's source-type gate. A URL containing any entry is excluded.\n35\tVENDOR_DENYLIST = (\n36\t    \"developer.nvidia.com\",\n37\t)\n38\t\n39\t# Rank priority by kind (lower sorts first): skill > agent > tool > template.\n40\t_KIND_RANK = {\"skill\": 0, \"agent\": 1, \"tool\": 2, \"template\": 3}\n41\t\n42\t# U+FFFD REPLACEMENT CHARACTER — stripped from why-lines (interim until Wave 4).\n43\t_REPLACEMENT_CHAR = \"�\"\n44\t\n45\t# --- Wave 5 (2026-06-10): bounded usage modifier on the RANKING surfaces -----\n46\t# The SAME ±0.10 / 30-day-half-life usage modifier the HH server applies to the\n47\t# cosine score is applied here ON TOP OF interest_score, so a slug John loads\n48\t# rises (and one he dismisses falls) in top_finds + the weekly digest too. Read\n49\t# hh_events telemetry only — NEVER write (keep the read-only briefing path\n50\t# side-effect-free). Bound enforced by a tanh squash (see\n51\t# `_usage_modifier_for_net`): the modifier lies in the CLOSED interval\n52\t# [-0.10, +0.10] — saturation reaches the ±0.10 cap but never breaches it.\n53\t_USAGE_MODIFIER_MAX = 0.10\n54\t_USAGE_MODIFIER_HALFLIFE_DAYS = 30.0\n55\t_USAGE_MODIFIER_SCALE = 3.0\n56\t\n57\t\n58\tdef _usage_modifier_for_net(net_weight: float) -> float:\n59\t    \"\"\"Squash a net decayed (loaded - dismissed) weight to the CLOSED interval\n60\t    [-0.10, +0.10]. |tanh| <= 1 for all finite inputs (saturating to exactly\n61\t    ±1.0 for large |net|), so the product reaches the ±0.10 cap but never\n62\t    breaches it even under huge usage counts (the unbounded-feedback trap is\n63\t    closed by construction).\"\"\"\n64\t    import math\n65\t    return _USAGE_MODIFIER_MAX * math.tanh(net_weight / _USAGE_MODIFIER_SCALE)\n66\t\n67\t\n68\tdef _usage_modifiers_by_slug(conn: sqlite3.Connection, slugs: list[str],\n69\t                             *, now: datetime | None = None) -> dict:\n70\t    \"\"\"{slug: modifier} from hh_events for the given slugs (read-only). +weight\n71\t    per 'loaded', -weight per 'dismissed', weight = 0.5 ** (age_days / 30); the\n72\t    net is squashed to ±0.10. Fail-open: a missing table / read error yields {}\n73\t    (no slug shifts). This MIRRORS the HH server's modifier so the ranking\n74\t    surfaces and the recall path can never drift.\"\"\"\n75\t    slugs = [s for s in slugs if s]\n76\t    if not slugs or not _table_exists(conn, \"hh_events\"):\n77\t        return {}\n78\t    now = now or datetime.now(timezone.utc)\n79\t    placeholders = \",\".join(\"?\" for _ in slugs)\n80\t    try:\n81\t        rows = conn.execute(\n82\t            \"SELECT slug, outcome, recorded_at FROM hh_events \"\n83\t            f\"WHERE slug IN ({placeholders}) \"\n84\t            \"AND outcome IN ('loaded', 'dismissed')\",\n85\t            tuple(slugs),\n86\t        ).fetchall()\n87\t    except sqlite3.DatabaseError:\n88\t        return {}\n89\t    net: dict[str, float] = {}\n90\t    for slug, outcome, recorded_at in rows:\n91\t        if not slug or not recorded_at:\n92\t            continue\n93\t        try:\n94\t            ts = datetime.fromisoformat(recorded_at)\n95\t            if ts.tzinfo is None:\n96\t                ts = ts.replace(tzinfo=timezone.utc)\n97\t        except (ValueError, TypeError):\n98\t            continue\n99\t        age_days = max(0.0, (now - ts).total_seconds() / 86400.0)\n100\t        weight = 0.5 ** (age_days / _USAGE_MODIFIER_HALFLIFE_DAYS)\n101\t        if outcome == \"loaded\":\n102\t            net[slug] = net.get(slug, 0.0) + weight\n103\t        elif outcome == \"dismissed\":\n104\t            net[slug] = net.get(slug, 0.0) - weight\n105\t    return {s: _usage_modifier_for_net(w) for s, w in net.items()}\n106\t\n107\t\n108\tdef _open_ro() -> sqlite3.Connection:\n109\t    \"\"\"O-11: read-only connection with busy_timeout. Briefing never writes.\"\"\"\n110\t    conn = sqlite3.connect(f\"file:{DB_PATH}?mode=ro\", uri=True)\n111\t    try:\n112\t        conn.execute(\"PRAGMA busy_timeout=5000\")\n113\t    except sqlite3.DatabaseError:\n114\t        pass\n115\t    return conn\n116\t\n117\t\n118\tdef _table_exists(conn: sqlite3.Connection, name: str) -> bool:\n119\t    return conn.execute(\n120\t        \"SELECT 1 FROM sqlite_master WHERE type='table' AND name=?\", (name,)\n121\t    ).fetchone() is not None\n122\t\n123\t\n124\tdef _hh_yesterday(conn: sqlite3.Connection) -> dict | None:\n125\t    \"\"\"Helping Hand activity for yesterday (UTC). Returns None when the table\n126\t    is absent or there were zero events — the caller suppresses the block.\"\"\"\n127\t    if not _table_exists(conn, \"hh_events\"):\n128\t        return None\n129\t    yday = (datetime.now(timezone.utc) - timedelta(days=1)).strftime(\"%Y-%m-%d\")\n130\t    total = conn.execute(\n131\t        \"SELECT COUNT(*) FROM hh_events WHERE substr(recorded_at,1,10)=?\", (yday,)\n132\t    ).fetchone()[0]\n133\t    if not total:\n134\t        return None\n135\t\n136\t    sessions = conn.execute(\n137\t        \"SELECT COUNT(DISTINCT session_id) FROM hh_events \"\n138\t        \"WHERE substr(recorded_at,1,10)=?\", (yday,)\n139\t    ).fetchone()[0]\n140\t    distinct_queries = conn.execute(\n141\t        \"SELECT COUNT(DISTINCT query_sha256) FROM hh_events \"\n142\t        \"WHERE substr(recorded_at,1,10)=?\", (yday,)\n143\t    ).fetchone()[0]\n144\t    match_calls = 0\n145\t    if _table_exists(conn, \"hh_sessions\"):\n146\t        match_calls = conn.execute(\n147\t            \"SELECT COALESCE(SUM(match_calls),0) FROM hh_sessions \"\n148\t            \"WHERE substr(last_seen_at,1,10)=?\", (yday,)\n149\t        ).fetchone()[0]\n150\t    loaded = conn.execute(\n151\t        \"SELECT COUNT(*) FROM hh_events \"\n152\t        \"WHERE substr(recorded_at,1,10)=? AND outcome='loaded'\", (yday,)\n153\t    ).fetchone()[0]\n154\t    dismissed = conn.execute(\n155\t        \"SELECT COUNT(*) FROM hh_events \"\n156\t        \"WHERE substr(recorded_at,1,10)=? AND outcome='dismissed'\", (yday,)\n157\t    ).fetchone()[0]\n158\t    terminal = loaded + dismissed\n159\t    accept_rate = (loaded / terminal) if terminal else None\n160\t\n161\t    top_surfaced = conn.execute(\n162\t        \"SELECT slug, COUNT(*) c FROM hh_events \"\n163\t        \"WHERE substr(recorded_at,1,10)=? AND slug IS NOT NULL \"\n164\t        \"GROUP BY slug ORDER BY c DESC, slug LIMIT 5\", (yday,)\n165\t    ).fetchall()\n166\t    top_loaded = conn.execute(\n167\t        \"SELECT slug, COUNT(*) c FROM hh_events \"\n168\t        \"WHERE substr(recorded_at,1,10)=? AND outcome='loaded' AND slug IS NOT NULL \"\n169\t        \"GROUP BY slug ORDER BY c DESC, slug LIMIT 5\", (yday,)\n170\t    ).fetchall()\n171\t    by_kind = conn.execute(\n172\t        \"SELECT COALESCE(artifact_kind,'(unknown)') k, COUNT(*) c FROM hh_events \"\n173\t        \"WHERE substr(recorded_at,1,10)=? GROUP BY k ORDER BY c DESC\", (yday,)\n174\t    ).fetchall()\n175\t\n176\t    return {\n177\t        \"date\": yday, \"events\": total, \"sessions\": sessions,\n178\t        \"match_calls\": match_calls, \"distinct_queries\": distinct_queries,\n179\t        \"loaded\": loaded, \"dismissed\": dismissed, \"accept_rate\": accept_rate,\n180\t        \"top_surfaced\": top_surfaced, \"top_loaded\": top_loaded, \"by_kind\": by_kind,\n181\t    }\n182\t\n183\t\n184\tdef _models_block(conn: sqlite3.Connection, today: str) -> dict | None:\n185\t    \"\"\"Models-sweep summary for the briefing. Returns None when the `models`\n186\t    satellite table is absent or holds zero rows (caller suppresses the block).\n187\t\n188\t    Reports:\n189\t      - total models tracked (artifacts kind='model', not retired)\n190\t      - newly-seen-today by provider (artifacts.first_seen_at = today)\n191\t      - latest model_smoke_tests rollup (✓ ok / ✗ error / – no_key)\n192\t      - models whose deprecation_date falls within the next 30 days\n193\t    \"\"\"\n194\t    if not _table_exists(conn, \"models\"):\n195\t        return None\n196\t    total = conn.execute(\n197\t        \"SELECT COUNT(*) FROM artifacts WHERE kind='model' AND retired_at IS NULL\"\n198\t    ).fetchone()[0]\n199\t    if not total:\n200\t        return None\n201\t\n202\t    # Awareness Revamp W1: the junk-filter (dashboard.data.models.USABLE_MODEL_PREDICATE)\n203\t    # is the SINGLE source of truth and must gate EVERY model surface in this\n204\t    # block — including \"new today by provider\", so a $0/preview/sentinel model\n205\t    # first-seen-today can never inflate the count John reads. Defensive import:\n206\t    # a host without the dashboard package degrades to unfiltered counts rather\n207\t    # than crashing the scheduled briefing.\n208\t    try:\n209\t        from dashboard.data.models import USABLE_MODEL_PREDICATE as _UMP\n210\t    except Exception:  # noqa: BLE001 — degrade gracefully, never break the briefing\n211\t        _UMP = None\n212\t    _usable_and = f\" AND {_UMP}\" if _UMP else \"\"\n213\t\n214\t    new_by_provider = conn.execute(\n215\t        \"SELECT m.provider, COUNT(*) c FROM artifacts a \"\n216\t        \"JOIN models m ON m.artifact_id = a.id \"\n217\t        \"WHERE a.kind='model' AND substr(a.first_seen_at,1,10)=?\" + _usable_and +\n218\t        \" GROUP BY m.provider ORDER BY c DESC, m.provider\", (today,)\n219\t    ).fetchall()\n220\t\n221\t    # Wave B5 (2026-05-29): the writer now actually fires (default-off behind\n222\t    # AURORA_SMOKE_TESTS_ENABLED=1). Surface top-3 error classes when errors>0\n223\t    # and a sub-bullet for cost-skipped / no-endpoint models.\n224\t    smoke = {\"ok\": 0, \"error\": 0, \"no_key\": 0, \"no_endpoint\": 0, \"skipped_cap\": 0}\n225\t    smoke_top_errors: list[tuple[str, int]] = []\n226\t    smoke_total_usd: float = 0.0\n227\t    if _table_exists(conn, \"model_smoke_tests\"):\n228\t        # Roll up the most recent smoke run only (max run_id present).\n229\t        max_run = conn.execute(\n230\t            \"SELECT MAX(run_id) FROM model_smoke_tests\"\n231\t        ).fetchone()[0]\n232\t        if max_run is not None:\n233\t            rows = conn.execute(\n234\t                \"SELECT status, COUNT(*) FROM model_smoke_tests \"\n235\t                \"WHERE run_id=? GROUP BY status\", (max_run,)\n236\t            ).fetchall()\n237\t            for status, c in rows:\n238\t                if status == \"ok\":\n239\t                    smoke[\"ok\"] += c\n240\t                elif status == \"no_key\":\n241\t                    smoke[\"no_key\"] += c\n242\t                elif status == \"no_endpoint\":\n243\t                    smoke[\"no_endpoint\"] += c\n244\t                elif status == \"skipped_cap\":\n245\t                    smoke[\"skipped_cap\"] += c\n246\t                else:  # error / timeout / rate_limited / auth_failed / unsupported\n247\t                    smoke[\"error\"] += c\n248\t            if smoke[\"error\"]:\n249\t                smoke_top_errors = conn.execute(\n250\t                    \"SELECT COALESCE(error_class,'other') ec, COUNT(*) c \"\n251\t                    \"FROM model_smoke_tests \"\n252\t                    \"WHERE run_id=? AND status='error' \"\n253\t                    \"GROUP BY ec ORDER BY c DESC LIMIT 3\", (max_run,)\n254\t                ).fetchall()\n255\t            usd_row = conn.execute(\n256\t                \"SELECT COALESCE(SUM(usd_estimate),0.0) FROM model_smoke_tests \"\n257\t                \"WHERE run_id=?\", (max_run,)\n258\t            ).fetchone()\n259\t            smoke_total_usd = float(usd_row[0] or 0.0)\n260\t\n261\t    # Deprecating within 30 days (inclusive of today).\n262\t    soon = (datetime.now(timezone.utc) + timedelta(days=30)).strftime(\"%Y-%m-%d\")\n263\t    deprecating = conn.execute(\n264\t        \"SELECT a.slug, m.deprecation_date FROM models m \"\n265\t        \"JOIN artifacts a ON a.id = m.artifact_id \"\n266\t        \"WHERE a.retired_at IS NULL AND m.deprecation_date IS NOT NULL \"\n267\t        \"AND m.deprecation_date >= ? AND m.deprecation_date <= ? \"\n268\t        \"ORDER BY m.deprecation_date, a.slug\", (today, soon)\n269\t    ).fetchall()\n270\t\n271\t    # Awareness Revamp W1: junk-filtered USABLE counts + license distribution,\n272\t    # gated by the SAME single-source predicate imported above (_UMP). Degrades\n273\t    # to no usable block if the dashboard package wasn't importable on this host.\n274\t    usable_total = None\n275\t    usable_by_provider: list = []\n276\t    license_distribution: list = []\n277\t    if _UMP:\n278\t        try:\n279\t            usable_total = conn.execute(\n280\t                f\"SELECT COUNT(*) FROM models m JOIN artifacts a ON a.id = m.artifact_id \"\n281\t                f\"WHERE a.retired_at IS NULL AND {_UMP}\"\n282\t            ).fetchone()[0]\n283\t            usable_by_provider = conn.execute(\n284\t                f\"SELECT m.provider, COUNT(*) c FROM models m \"\n285\t                f\"JOIN artifacts a ON a.id = m.artifact_id \"\n286\t                f\"WHERE a.retired_at IS NULL AND {_UMP} \"\n287\t                f\"GROUP BY m.provider ORDER BY c DESC, m.provider\"\n288\t            ).fetchall()\n289\t            # license distribution over USABLE rows; NULL -> 'unknown' (never hidden)\n290\t            license_distribution = conn.execute(\n291\t                f\"SELECT COALESCE(m.license_class, 'unknown') lic, COUNT(*) c \"\n292\t                f\"FROM models m JOIN artifacts a ON a.id = m.artifact_id \"\n293\t                f\"WHERE a.retired_at IS NULL AND {_UMP} \"\n294\t                f\"GROUP BY lic ORDER BY c DESC, lic\"\n295\t            ).fetchall()\n296\t        except Exception:  # noqa: BLE001 — degrade gracefully, never break the briefing\n297\t            pass\n298\t\n299\t    # Awareness Revamp W3: a license-clean benchmark-coverage line + best-for-X\n300\t    # pick. Degrades gracefully: when model_benchmarks is empty (or the"}]},"parent_tool_use_id":"toolu_01UkhjqCpsBaWTEbkLkiiJeJ","session_id":"0e9f13f6-4032-41a4-8d9f-b9e18c221609","uuid":"2c73ce63-e492-47f4-8d4b-fbfc43400ce5","timestamp":"2026-06-23T18:40:06.632Z","subagent_type":"Explore","task_description":"Explore Aurora core architecture"}
