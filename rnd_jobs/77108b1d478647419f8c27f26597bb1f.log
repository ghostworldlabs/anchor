{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KhzPDECceRoLn9Q1ydC4H7","type":"tool_result","content":"1\t\"\"\"Wave L6 (2026-06-07) — opt-in Message-Batches coordinator for the nightly\n2\tsweep's non-interactive Anthropic calls.\n3\t\n4\tThe nightly critic/judge sweeps run unattended (22:00–00:00) and are NOT\n5\tlatency-sensitive, so they are the textbook fit for Anthropic's Message Batches\n6\tAPI (~50% discount). This module collects the per-candidate critic_a and\n7\treconciler Anthropic prompts into ONE batch submission each (per wave) so the\n8\torchestrator can spend the batch discount on a whole sweep at once.\n9\t\n10\tOPT-IN + DEFAULT OFF. `AURORA_BATCH_SWEEP=1` is the ONLY switch that engages any\n11\tof this. With it unset, `walk_pipeline` never imports/calls this module's submit\n12\thelpers and runs the byte-for-byte synchronous pipeline.\n13\t\n14\tDATA-DEPENDENCY: critic_a is independent across candidates -> one batch.\n15\treconciler embeds the critics' rubrics in its prompt, so it can only batch AFTER\n16\tthe critics for every candidate are known -> a SECOND batch. The security judge\n17\truns on the SEPARATE gate path (roles/security/judge.py), not in walk_pipeline;\n18\t`map_judge_batch_text` here gives that path the same collect-or-fail-closed\n19\tmapping for when it adopts batching.\n20\t\n21\tFAIL-SOFT INVARIANTS (mirroring the whole pipeline):\n22\t  * a single item that fails in the batch -> its custom_id lands in `failed`;\n23\t    the orchestrator degrades THAT candidate to the synchronous `critique` /\n24\t    `reconcile` (which meters batch_mode=False and the `_note_degrade` counter\n25\t    fires in llm.submit_anthropic_batch). The sweep never aborts.\n26\t  * a missing security-judge batch result -> abstain (fail-CLOSED). NEVER a\n27\t    silent pass/clear.\n28\t\"\"\"\n29\tfrom __future__ import annotations\n30\t\n31\timport logging\n32\timport os\n33\tfrom dataclasses import dataclass\n34\tfrom typing import Optional\n35\t\n36\tlog = logging.getLogger(__name__)\n37\t\n38\t\n39\tdef batch_sweep_enabled() -> bool:\n40\t    \"\"\"The Message-Batches sweep path is OFF by default. Curator opts in with\n41\t    AURORA_BATCH_SWEEP=1. With it unset, walk_pipeline runs the byte-for-byte\n42\t    synchronous pipeline and never touches this module's submit helpers.\"\"\"\n43\t    val = (os.environ.get(\"AURORA_BATCH_SWEEP\") or \"\").strip().lower()\n44\t    return val in (\"1\", \"true\", \"yes\", \"on\")\n45\t\n46\t\n47\tdef critic_a_model() -> str:\n48\t    \"\"\"The same model resolution critic_a.critique uses, so a batched request is\n49\t    aimed at the same tier (and a Gemini override sidesteps batching entirely).\"\"\"\n50\t    return os.environ.get(\"AURORA_CRITIC_A_MODEL\", \"claude-sonnet-4-6\")\n51\t\n52\t\n53\tdef reconciler_model() -> str:\n54\t    return os.environ.get(\"AURORA_RECONCILER_MODEL\", \"claude-sonnet-4-6\")\n55\t\n56\t\n57\tdef _is_anthropic_model(model: str) -> bool:\n58\t    \"\"\"Batching is Anthropic-only. A Gemini/Google override or a models/-prefixed\n59\t    tag routes through the synchronous Gemini path (call_model), so we must NOT\n60\t    pull it into an Anthropic Message Batch.\"\"\"\n61\t    m = (model or \"\").lower()\n62\t    return not (\"gemini\" in m or \"google\" in m or m.startswith(\"models/\"))\n63\t\n64\t\n65\t@dataclass\n66\tclass CriticABatchPlan:\n67\t    \"\"\"The critic_a batch plan for a sweep: the collected per-slug response texts\n68\t    (already metered at 0.5x) and the slugs whose batched request failed (the\n69\t    orchestrator degrades each to a synchronous critic_a.critique).\"\"\"\n70\t    texts: \"dict[str, str]\"\n71\t    failed: \"set[str]\"\n72\t\n73\t\n74\tdef submit_critic_a_batch(items, *, cost_recorder=None) -> CriticABatchPlan:\n75\t    \"\"\"Submit critic_a's per-candidate Anthropic prompts as ONE Message Batch.\n76\t\n77\t    `items` is a list of (slug, prompt) pairs the orchestrator built via\n78\t    `critic_a.build_prompt`. Returns a CriticABatchPlan keyed by slug. Each\n79\t    SUCCEEDED result is metered at the 0.5x batch rate inside\n80\t    llm.submit_anthropic_batch; each FAILED/missing slug is in `.failed` for the\n81\t    orchestrator to degrade synchronously.\n82\t\n83\t    Empty / non-Anthropic-model -> empty plan with every slug marked failed, so\n84\t    the orchestrator runs the synchronous path for all of them (no behaviour\n85\t    change beyond the degrade counter, which only fires inside the batch helper\n86\t    on a real submit).\"\"\"\n87\t    from aurora import llm\n88\t    from aurora.roles.contracts import CRITIC_VERDICT_SCHEMA\n89\t\n90\t    model = critic_a_model()\n91\t    slugs = [slug for slug, _ in items]\n92\t    if not items:\n93\t        return CriticABatchPlan(texts={}, failed=set())\n94\t    if not _is_anthropic_model(model):\n95\t        log.info(\"batch_sweep: critic_a model %s is non-Anthropic — skipping batch \"\n96\t                 \"(synchronous path)\", model)\n97\t        return CriticABatchPlan(texts={}, failed=set(slugs))\n98\t\n99\t    from aurora.roles import critic_a as critic_a_role\n100\t    batch_items = [\n101\t        llm.BatchItem(\n102\t            custom_id=slug,\n103\t            params=llm.build_anthropic_request_params(\n104\t                prompt, model=model, max_tokens=400,\n105\t                system=critic_a_role._SYSTEM, cache_system=True,\n106\t                output_schema=CRITIC_VERDICT_SCHEMA,\n107\t            ),\n108\t            structured=True,\n109\t        )\n110\t        for slug, prompt in items\n111\t    ]\n112\t    res = llm.submit_anthropic_batch(batch_items, cost_recorder=cost_recorder)\n113\t    return CriticABatchPlan(texts=res.texts, failed=res.failed)\n114\t\n115\t\n116\t@dataclass\n117\tclass ReconcilerBatchPlan:\n118\t    texts: \"dict[str, str]\"\n119\t    failed: \"set[str]\"\n120\t\n121\t\n122\tdef submit_reconciler_batch(items, *, cost_recorder=None) -> ReconcilerBatchPlan:\n123\t    \"\"\"Submit the reconciler's per-candidate Anthropic prompts as ONE Message\n124\t    Batch (the SECOND wave, after critics are known). `items` is a list of\n125\t    (slug, prompt) pairs from `reconciler.build_prompt`. Same fail-soft contract\n126\t    as `submit_critic_a_batch`.\"\"\"\n127\t    from aurora import llm\n128\t    from aurora.roles.contracts import RECONCILED_VERDICT_SCHEMA\n129\t\n130\t    model = reconciler_model()\n131\t    slugs = [slug for slug, _ in items]\n132\t    if not items:\n133\t        return ReconcilerBatchPlan(texts={}, failed=set())\n134\t    if not _is_anthropic_model(model):\n135\t        log.info(\"batch_sweep: reconciler model %s is non-Anthropic — skipping \"\n136\t                 \"batch (synchronous path)\", model)\n137\t        return ReconcilerBatchPlan(texts={}, failed=set(slugs))\n138\t\n139\t    from aurora.roles import reconciler as reconciler_role\n140\t    batch_items = [\n141\t        llm.BatchItem(\n142\t            custom_id=slug,\n143\t            params=llm.build_anthropic_request_params(\n144\t                prompt, model=model, max_tokens=500,\n145\t                system=reconciler_role._SYSTEM, cache_system=True,\n146\t                output_schema=RECONCILED_VERDICT_SCHEMA,\n147\t            ),\n148\t            structured=True,\n149\t        )\n150\t        for slug, prompt in items"}]},"parent_tool_use_id":"toolu_01UkhjqCpsBaWTEbkLkiiJeJ","session_id":"0e9f13f6-4032-41a4-8d9f-b9e18c221609","uuid":"a80d6447-e322-45fb-bbf2-e8c3ae154bd3","timestamp":"2026-06-23T18:40:42.684Z","subagent_type":"Explore","task_description":"Explore Aurora core architecture"}
