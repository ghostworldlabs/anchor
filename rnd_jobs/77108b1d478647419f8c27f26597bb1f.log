sd: 0.59\n74\t      tokens_out_per_million_usd: 0.79\n75\t  local:\n76\t    default:\n77\t      tokens_in_per_million_usd: 0.0\n78\t      tokens_out_per_million_usd: 0.0\n79\tdefault_models:\n80\t  scout:\n81\t    vendor: gemini\n82\t    model: gemini-3.5-flash\n83\t  runner:\n84\t    vendor: anthropic\n85\t    model: claude-sonnet-4-6\n86\t  critic_a:\n87\t    vendor: anthropic\n88\t    model: claude-sonnet-4-6\n89\t  critic_b:\n90\t    vendor: gemini\n91\t    model: gemini-3.5-flash\n92\t  reconciler:\n93\t    vendor: anthropic\n94\t    model: claude-sonnet-4-6\n95\t  embedder:\n96\t    vendor: gemini\n97\t    model: gemini-3.5-flash\n98\t  librarian:\n99\t    vendor: gemini\n100\t    model: gemini-3.5-flash\n101\t  # Wave 4 (2026-06-10) — the taste scorer (roles/taste.py). Resolves its model\n102\t  # from this entry (overridable via AURORA_TASTE_MODEL). Chosen tag:\n103\t  # claude-haiku-4-5-20251001 — ALREADY priced above at $1/$5 (verified:true,\n104\t  # see the verification block), the project's standard cheap Anthropic tier, no\n105\t  # new provider/API-key dependency. The taste scorer runs nightly, capped, at\n106\t  # cents/night, so the cheap Haiku tier is the right fit. E17 (the unpriced-tag\n107\t  # trap): taste.py records every call's cost via CostRecorder against the SAME\n108\t  # vendor/model the Anthropic SDK echoes back (resp.model == this tag), which\n109\t  # resolves to the non-zero $1/$5 priced key here — no $0 fiction. The priced\n110\t  # key (claude-haiku-4-5-20251001) and the called tag are PROVABLY IDENTICAL.\n111\t  taste:\n112\t    vendor: anthropic\n113\t    model: claude-haiku-4-5-20251001\n114\t\n115\t# Wave 4 (2026-06-06) — rate provenance. Keyed \"vendor/model\". `verified: true`\n116\t# means the rate was confirmed against an authoritative published source on\n117\t# `at`; `verified: false` means it is a best-effort ESTIMATE with no pinnable\n118\t# SKU (do not treat the resulting usd_estimate as ground truth). Sibling block\n1