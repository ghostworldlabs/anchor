{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SYNUK9S3Cp9GLheYynW2BB","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Aurora Dashboard — local launcher.\n3\t\n4\tA read-only operator console for the nightly multi-agent fleet. Mirrors the\n5\tAnchor pattern (a Python server serving an HTML dashboard) but NEVER writes:\n6\tit opens kb/aurora.db read-only and only reads reports/.\n7\t\n8\tUsage:  python aurora_dashboard.py\n9\tThen open http://127.0.0.1:5001 in your browser.\n10\t\n11\tThe app is a Flask blueprint (dashboard.web.blueprint.create_blueprint) so it\n12\tcan later be mounted into Anchor as a tab without code changes.\n13\t\"\"\"\n14\timport threading\n15\timport webbrowser\n16\t\n17\tfrom dashboard import DashboardConfig, create_app\n18\t\n19\t\n20\tdef _open_browser(url: str):\n21\t    import time\n22\t    time.sleep(1.2)\n23\t    try:\n24\t        webbrowser.open(url)\n25\t    except Exception:\n26\t        pass\n27\t\n28\t\n29\tdef _safe_print(msg: str):\n30\t    # Windows consoles default to cp1252; a non-ASCII banner char would raise\n31\t    # UnicodeEncodeError and kill the launcher. Degrade to ASCII rather than die.\n32\t    try:\n33\t        print(msg)\n34\t    except UnicodeEncodeError:\n35\t        print(msg.encode(\"ascii\", \"replace\").decode(\"ascii\"))\n36\t\n37\t\n38\tdef main():\n39\t    cfg = DashboardConfig.default()\n40\t    app = create_app(cfg)\n41\t    url = f\"http://{cfg.host}:{cfg.port}\"\n42\t    _safe_print(\"\\n  Aurora Dashboard\")\n43\t    _safe_print(\"  ----------------\")\n44\t    _safe_print(f\"  KB (read-only): {cfg.kb_path}\")\n45\t    _safe_print(f\"  Reports:        {cfg.reports_dir}\")\n46\t    _safe_print(f\"  Dashboard:      {url}\\n\")\n47\t    threading.Thread(target=_open_browser, args=(url,), daemon=True).start()\n48\t    app.run(host=cfg.host, port=cfg.port, debug=False)\n49\t\n50\t\n51\tif __name__ == \"__main__\":\n52\t    main()\n53\t"}]},"parent_tool_use_id":"toolu_01UkhjqCpsBaWTEbkLkiiJeJ","session_id":"0e9f13f6-4032-41a4-8d9f-b9e18c221609","uuid":"b8818815-3fdb-40fe-9fb0-287a93148ca6","timestamp":"2026-06-23T18:40:00.208Z","subagent_type":"Explore","task_description":"Explore Aurora core architecture"}
