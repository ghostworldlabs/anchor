{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F9n5qbKXeUocsvGmwSPDMh","type":"tool_result","content":"1\t\"\"\"Nightly executive-summary writer. Reads from the DB for *this run*,\n2\trenders reports/<sweep>/<YYYY-MM-DD>/summary.md per §9.1 of the plan.\"\"\"\n3\tfrom __future__ import annotations\n4\timport sqlite3\n5\tfrom datetime import datetime, timezone\n6\tfrom pathlib import Path\n7\t\n8\t\n9\t_COMPLEXITY_LABELS = {0: \"one-shot\", 1: \"recipe\", 2: \"workflow\",\n10\t                      3: \"autonomous\", 4: \"open-ended\"}\n11\t\n12\t\n13\tdef _now() -> str:\n14\t    return datetime.now(timezone.utc).isoformat()\n15\t\n16\t\n17\tdef write_summary(reports_root: Path, db_or_path, run_id: int,\n18\t                  sweep: str, monthly_caps: dict, mtd: dict) -> Path:\n19\t    own_conn = False\n20\t    if isinstance(db_or_path, sqlite3.Connection):\n21\t        conn = db_or_path\n22\t    else:\n23\t        conn = sqlite3.connect(str(db_or_path))\n24\t        own_conn = True\n25\t    # Cost rollup for this run\n26\t    # Per-vendor totals for this run\n27\t    cost_rows = conn.execute(\n28\t        \"SELECT vendor, SUM(tokens_in), SUM(tokens_out), SUM(usd_estimate) \"\n29\t        \"FROM costs WHERE run_id=? GROUP BY vendor ORDER BY vendor\",\n30\t        (run_id,),\n31\t    ).fetchall()\n32\t    per_vendor: dict[str, dict] = {}\n33\t    for v, ti, to, usd in cost_rows:\n34\t        per_vendor[v] = {\"tokens_in\": ti or 0, \"tokens_out\": to or 0, \"usd\": usd or 0.0}\n35\t    total_usd = sum(d[\"usd\"] for d in per_vendor.values())\n36\t    total_in = sum(d[\"tokens_in\"] for d in per_vendor.values())\n37\t    total_out = sum(d[\"tokens_out\"] for d in per_vendor.values())\n38\t\n39\t    # Artifacts whose static validation came from THIS run.\n40\t    # Take the LATEST embedding per artifact (not every historical one) and the\n41\t    # latest static validation from this run, grouped so each artifact appears once.\n42\t    new_rows = conn.execute(\n43\t        \"SELECT a.kind, a.slug, a.name, a.short_description, \"\n44\t        \"       e.domain_path, e.complexity_rank, v.verdict, v.score \"\n45\t        \"FROM artifacts a \"\n46\t        \"JOIN validations v ON v.id = (\"\n47\t        \"    SELECT id FROM validations \"\n48\t        \"    WHERE artifact_id = a.id AND run_id = ? AND stage = 'static' \"\n49\t        \"    ORDER BY id DESC LIMIT 1\"\n50\t        \") \"\n51\t        \"JOIN embeddings e ON e.id = (\"\n52\t        \"    SELECT id FROM embeddings WHERE artifact_id = a.id \"\n53\t        \"    ORDER BY embedded_at DESC LIMIT 1\"\n54\t        \") \"\n55\t        \"ORDER BY a.name\",\n56\t        (run_id,),\n57\t    ).fetchall()\n58\t\n59\t    run = conn.execute(\n60\t        \"SELECT started_at, finished_at, status, notes FROM runs WHERE id=?\",\n61\t        (run_id,),\n62\t    ).fetchone()\n63\t    if own_conn:\n64\t        conn.close()\n65\t\n66\t    date_str = (run[0] or _now())[:10]\n67\t    folder = reports_root / sweep / date_str\n68\t    folder.mkdir(parents=True, exist_ok=True)\n69\t    out = folder / \"summary.md\"\n70\t\n71\t    lines = [\n72\t        f\"# {sweep.capitalize()} sweep — {date_str}\",\n73\t        f\"Status: **{run[2] or '?'}**    Started: {run[0]}    Finished: {run[1] or '(running)'}\",\n74\t        \"\",\n75\t        \"## Budget\",\n76\t    ]\n77\t    for vendor in sorted(per_vendor.keys() | set(monthly_caps.keys())):\n78\t        v = per_vendor.get(vendor, {\"tokens_in\": 0, \"tokens_out\": 0, \"usd\": 0.0})\n79\t        cap = monthly_caps.get(vendor, 0.0)\n80\t        mtd_v = mtd.get(vendor, 0.0)\n81\t        bar = \"✓\" if (cap == 0 or mtd_v < 0.8 * cap) else \"⚠\"\n82\t        lines.append(\n83\t            f\"- **{vendor}:** ${v['usd']:.4f} this run · \"\n84\t            f\"{v['tokens_in']:,} in / {v['tokens_out']:,} out · \"\n85\t            f\"MTD ${mtd_v:.2f} of ${cap:.2f} cap {bar}\"\n86\t        )\n87\t    lines.append(f\"- **Total this run: ${total_usd:.4f} · {total_in:,} in / {total_out:,} out**\")\n88\t    lines.append(\"\")\n89\t\n90\t    lines += [\"## What's new tonight\", \"\"]\n91\t    if not new_rows:\n92\t        lines.append(\"_(no new artifacts surfaced)_\")\n93\t    else:\n94\t        for kind, slug, name, desc, domain, rank, verdict, score in new_rows:\n95\t            label = _COMPLEXITY_LABELS.get(rank, \"?\") if rank is not None else \"?\"\n96\t            lines.append(\n97\t                f\"- **{name}** ({kind}) — {(desc or '')[:120]} · \"\n98\t                f\"domain `{domain}` · complexity {rank} ({label}) · \"\n99\t                f\"verdict `{verdict}` (score {score:.2f})\"\n100\t            )\n101\t    lines.append(\"\")\n102\t\n103\t    lines += [\n104\t        \"## Top picks for incorporation\",\n105\t        \"\",\n106\t    ]\n107\t    for kind, slug, name, *_ in new_rows[:3]:\n108\t        lines.append(f\"- **{name}** — [open in library]({Path('../../../library')/f'{kind}s'/slug/'index.md'})\")\n109\t    lines.append(\"\")\n110\t\n111\t    lines += [\n112\t        \"## Notes\",\n113\t        \"\",\n114\t        run[3] or \"\",\n115\t        \"\",\n116\t    ]\n117\t    out.write_text(\"\\n\".join(lines), encoding=\"utf-8\")\n118\t    return out\n119\t\n120\t\n121\tdef mtd_per_vendor(db_or_path) -> dict:\n122\t    \"\"\"Sum of usd_estimate over the current calendar month, per vendor.\"\"\"\n123\t    own_conn = False\n124\t    if isinstance(db_or_path, sqlite3.Connection):\n125\t        conn = db_or_path\n126\t    else:\n127\t        conn = sqlite3.connect(str(db_or_path))\n128\t        own_conn = True\n129\t    rows = conn.execute(\n130\t        \"SELECT vendor, SUM(usd_estimate) FROM costs \"\n131\t        \"WHERE substr(recorded_at,1,7) = strftime('%Y-%m','now') \"\n132\t        \"GROUP BY vendor\",\n133\t    ).fetchall()\n134\t    if own_conn:\n135\t        conn.close()\n136\t    return {v: float(u or 0.0) for v, u in rows}\n137\t"}]},"parent_tool_use_id":"toolu_01UkhjqCpsBaWTEbkLkiiJeJ","session_id":"0e9f13f6-4032-41a4-8d9f-b9e18c221609","uuid":"ae06da50-053c-45e4-8865-07c968a46a35","timestamp":"2026-06-23T18:40:03.431Z","subagent_type":"Explore","task_description":"Explore Aurora core architecture"}
