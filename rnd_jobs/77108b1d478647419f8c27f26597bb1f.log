he sub-rates are estimates (~0.1x /\n155\t  # ~1.25x input, no pinnable cache SKU) so honestly flagged cache_verified:false,\n156\t  # mirroring the L1 sonnet/haiku entries. tokenizer_factor (1.35) is an ESTIMATE\n157\t  # of the 4.7+ tokenizer's ~35%-more-tokens behaviour (claude-api skill:\n158\t  # \"Updated token counting\") — it applies to PRE-CALL estimates only, never to\n159\t  # recorded actuals, so it is flagged unverified too.\n160\t  anthropic/claude-opus-4-8:\n161\t    verified: true\n162\t    in: 5.0\n163\t    out: 25.0\n164\t    source: \"platform.claude.com pricing (claude-api skill, cached 2026-05-26): Opus 4.8 $5/$25\"\n165\t    at: \"2026-06-07\"\n166\t    cache_verified: false\n167\t    cache_source: \"Anthropic prompt-caching / Batches docs estimate\"\n168\t    tokenizer_factor_verified: false\n169\t    tokenizer_factor_source: \"claude-api skill 'Updated token counting' — 4.7+ tokenizer counts ~35% more tokens than 4.6 (estimate; re-baseline with count_tokens)\"\n170\t  gemini/gemini-2.5-pro:\n171\t    verified: true\n172\t    in: 1.25\n173\t    out: 10.0\n174\t    source: \"Google published Gemini 2.5 Pro SKU\"\n175\t    at: \"2026-06-06\"\n176\t  gemini/gemini-2.5-flash:\n177\t    verified: true\n178\t    in: 0.3\n179\t    out: 2.5\n180\t    source: \"Google published Gemini 2.5 Flash SKU\"\n181\t    at: \"2026-06-06\"\n182\t  gemini/text-embedding-004:\n183\t    verified: false\n184\t    source: \"estimate — legacy embedder default; confirm against Google embedding SKU\"\n185\t  gemini/gemini-3.5-flash:\n186\t    verified: false\n187\t    source: \"estimate — no published Google SKU for this tag (cost-audit 2026-06-05)\"\n188\t  gemini/gemini-embedding-2:\n189\t    verified: false\n190\t    source: \"estimate — no published Google SKU for this tag (cost-audit 2026-06-05)\"\n191\t  deepseek/deepseek-chat:\n192\t    verified: true\n193\t    in: 0.27\n194\t    out: 1.10\n195\t    source: \"DeepSeek published API pricing: $0.27/$1.10\"\n196\t   