{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AJshvh5KxnkuBaFvK8pj8o","type":"tool_result","content":"614\tasync def walk_pipeline(cfg: SweepConfig, conn: sqlite3.Connection, run_id: int, *,\n615\t                        dry_run: bool, no_swarm: bool) -> str:\n616\t    log.info(\"─\" * 60)\n617\t    log.info(\"Sweep: %s  run_id=%s  dry_run=%s  no_swarm=%s\",\n618\t             cfg.name, run_id, dry_run, no_swarm)\n619\t    log.info(\"─\" * 60)\n620\t\n621\t    seed_map = yaml.safe_load(cfg.seed_map_path.read_text(encoding=\"utf-8\"))\n622\t    log.info(\"[1/8] seed_map loaded: %s\", cfg.seed_map_path.name)\n623\t\n624\t    # Bucket O-21 follow-up (2026-05-23): drain the embeddings_pending queue\n625\t    # at the start of every sweep. Cheap when the queue is empty (single\n626\t    # SELECT). Runs inside the held sweep_lock — no separate lock needed.\n627\t    if not dry_run:\n628\t        drain_cost = CostRecorder(conn, run_id, \"embedder\")\n629\t        drain_result = embedder.drain_pending(conn, cost_recorder=drain_cost,\n630\t                                              max_items=int(os.environ.get(\n631\t                                                  \"AURORA_DRAIN_MAX_ITEMS\", \"10\")))\n632\t        if drain_result[\"attempted\"]:\n633\t            log.info(\"[0/8] embeddings_pending drain: attempted=%d succeeded=%d still_failing=%d\",\n634\t                     drain_result[\"attempted\"], drain_result[\"succeeded\"],\n635\t                     drain_result[\"still_failing\"])\n636\t\n637\t    # Wave 5 (2026-06-06): scout memory — prioritize historically high-yield\n638\t    # seeds (exploit) while reserving a slice for new ones (explore). Yields are\n639\t    # computed from prior sweeps' attributed artifacts; best-effort. Ordering is\n640\t    # active as soon as yield history exists; the explore/exploit BUDGET CAP\n641\t    # (which skips some low-yield seeds to spend a measurable slice on new ones)\n642\t    # is opt-in via AURORA_SCOUT_BUDGET so the default nightly coverage is never\n643\t    # silently reduced. None -> fetch all (ordered).\n644\t    scout_yields = None\n645\t    if not dry_run:\n646\t        try:\n647\t            from aurora.roles import source_reputation\n648\t            scout_yields = source_reputation.compute_yield(conn) or None\n649\t        except Exception as e:  # noqa: BLE001 — never break the sweep on memory\n650\t            log.warning(\"[2/8] scout yield computation failed: %s\", e)\n651\t            scout_yields = None\n652\t    _scout_budget_env = os.environ.get(\"AURORA_SCOUT_BUDGET\", \"\").strip()\n653\t    scout_budget = int(_scout_budget_env) if _scout_budget_env.isdigit() else None\n654\t    fetched = await scout.fan_out(seed_map, dry_run=dry_run, yields=scout_yields,\n655\t                                  budget=scout_budget)\n656\t    log.info(\"[2/8] scout -> %d sources\", len(fetched))\n657\t\n658\t    # Wave 3 (2026-06-02): awesome-list links are enqueued (not emitted one-per-\n659\t    # link). Flush this sweep's buffered links into discovery_queue, then drain a\n660\t    # bounded batch back into the pipeline — sibling to the embeddings_pending\n661\t    # drain above. Keeps a ~200-link list from flooding a single sweep.\n662\t    if not dry_run:\n663\t        n_enq = scout.flush_discovery_buffer(conn)\n664\t        drained = scout.drain_discovery_queue(conn, max_items=int(os.environ.get(\n665\t            \"AURORA_DISCOVERY_DRAIN_MAX\", str(scout.DISCOVERY_DRAIN_MAX))))\n666\t        if n_enq or drained:\n667\t            log.info(\"[2.5/8] discovery_queue: enqueued=%d drained=%d\",\n668\t                     n_enq, len(drained))\n669\t        # Wave 2 (2026-06-10) — awesome-list root-cause fix (E21). The\n670\t        # awesome-list link enqueue happens at its REAL root cause in\n671\t        # scout._fetch_awesome_list (which extracts a README's repo links and\n672\t        # buffers them for discovery_queue, emitting NO FetchedSource itself).\n673\t        # Drained discovery_queue rows are therefore INDIVIDUAL repo URLs, each\n674\t        # carried as a synthetic single-URL body by scout._discovery_source —\n675\t        # never a link-list README (no re-fetch happens here). A drain-time\n676\t        # \"re-enqueue link lists\" branch was thus unreachable (the synthetic\n677\t        # body has zero markdown links) and has been removed; the screener's\n678\t        # pointer-description reject (static_screener._POINTER_PREFIX) is the\n679\t        # backstop that guarantees a drained pointer never mints an artifact.\n680\t        fetched.extend(drained)\n681\t\n682\t    quarantined = [quarantine_role.wrap(s) for s in fetched]\n683\t    log.info(\"[3/8] quarantine wrapped %d docs\", len(quarantined))\n684\t\n685\t    # Bucket O-18 (2026-05-23): PromptArmor-style cheap-Haiku sanitizer between\n686\t    # quarantine and screener. Fail-OPEN: a sanitizer outage never blocks the\n687\t    # sweep. Cost is recorded under role='sanitizer' for per-role rollups.\n688\t    sanitizer_cost = CostRecorder(conn, run_id, \"sanitizer\") if not dry_run else None\n689\t    quarantined, n_injections = sanitizer_role.sanitize(quarantined, cost_recorder=sanitizer_cost)\n690\t    if n_injections:\n691\t        log.info(\"[3.5/8] sanitizer scrubbed %d injection(s) across %d doc(s)\",\n692\t                 n_injections, len(quarantined))\n693\t    if not dry_run:\n694\t        _persist_sanitizer_telemetry(conn, run_id, n_injections)\n695\t\n696\t    screened = static_screener.screen(quarantined, dry_run=dry_run, sweep=cfg.name)\n697\t    log.info(\"[4/8] static_screener -> %d survivors\", len(screened))\n698\t\n699\t    # Split screened into swarm-bound top-K and embed-only tail.\n700\t    # Highest-scoring N go through the swarm; everything else gets embedded+filed\n701\t    # with static-only validation.\n702\t    swarm_top_k = 0 if no_swarm else int(os.environ.get(\"AURORA_SWARM_TOP_K\", \"2\"))\n703\t    screened_sorted = sorted(screened, key=lambda s: s.score, reverse=True)\n704\t    swarm_candidates = screened_sorted[:swarm_top_k]\n705\t    static_only = screened_sorted[swarm_top_k:]\n706\t    log.info(\"[5/8] split: %d for swarm, %d static-only\", len(swarm_candidates), len(static_only))\n707\t\n708\t    # Cost recorders, one per role for clean per-role rollup\n709\t    embedder_cost = CostRecorder(conn, run_id, \"embedder\")\n710\t    runner_cost = CostRecorder(conn, run_id, \"runner\")\n711\t    crit_a_cost = CostRecorder(conn, run_id, \"critic_a\")\n712\t    crit_b_cost = CostRecorder(conn, run_id, \"critic_b\")\n713\t    crit_c_cost = CostRecorder(conn, run_id, \"critic_c\")\n714\t    recon_cost = CostRecorder(conn, run_id, \"reconciler\")\n715\t    # Wave 2 (H2): the evidence loop's SHADOW re-scoring spend is metered under a\n716\t    # distinct role so bin/engine-diff.py can isolate the shadow-vs-legacy cost\n717\t    # ratio from the costs table. Every critic re-invocation inside the real\n718\t    # score_fn records through this recorder — no CostRecorder bypass.\n719\t    evidence_shadow_cost = CostRecorder(conn, run_id, \"evidence_shadow\") if not dry_run else None\n720\t\n721\t    placed = 0\n722\t    flagged = 0\n723\t    # Bucket J4: per-sweep budget guardrail. Skip the check entirely in dry-run\n724\t    # mode (no LLM calls => zero cost recorded => never trips, but also no\n725\t    # point hitting the DB on every iteration).\n726\t    budget_cap = PER_SWEEP_BUDGET_USD\n727\t    budget_check = not dry_run\n728\t\n729\t    # --- Wave L6 (2026-06-07): OPT-IN Message-Batches sweep (default OFF) ---\n730\t    # With AURORA_BATCH_SWEEP=1 the per-candidate critic_a Anthropic calls are\n731\t    # collected into ONE Message Batch submitted up front (~50% discount, metered\n732\t    # batch_mode=True). Each candidate's loop iteration then reads its prefetched\n733\t    # critic_a text instead of making a synchronous call; a slug whose batched\n734\t    # request FAILED is absent from `_ca_batch_texts`, so the loop passes\n735\t    # prefetched_text=None and critic_a degrades to the synchronous path (metered\n736\t    # batch_mode=False, `_note_degrade` already fired inside submit_anthropic_batch).\n737\t    #\n738\t    # DEFAULT (flag unset): `_ca_batch_texts` stays None and EVERY critique() call\n739\t    # below is invoked with prefetched_text=None — byte-for-byte the pre-Wave-L6\n740\t    # synchronous pipeline. The reconciler + security-judge batch helpers live in\n741\t    # roles/batch_sweep.py (the judge runs on the gate path, not here); reconciler\n742\t    # is left synchronous in this single-pass loop because its prompt embeds the\n743\t    # critics' rubrics (it can only batch in a second wave once every candidate's\n744\t    # critics are known) — the synchronous reconciler still meters correctly.\n745\t    _ca_batch_texts = None\n746\t    _ca_runner_cache: dict = {}  # slug -> RunnerArtifact prefetched in batch mode\n747\t    if not dry_run and batch_sweep.batch_sweep_enabled() and swarm_candidates:\n748\t        _ca_items = []\n749\t        for sc in swarm_candidates:\n750\t            rart_pre = runner_role.run(sc, cost_recorder=runner_cost,\n751\t                                       logs_dir=LOG_DIR, dry_run=dry_run)\n752\t            if rart_pre is None:\n753\t                continue\n754\t            _prompt = critic_a.build_prompt(sc.candidate, rart_pre)\n755\t            if _prompt is not None:\n756\t                _ca_items.append((sc.candidate.proposed_slug, _prompt))\n757\t            # cache the runner artifact so the loop below doesn't re-run it\n758\t            _ca_runner_cache[sc.candidate.proposed_slug] = rart_pre\n759\t        plan = batch_sweep.submit_critic_a_batch(_ca_items, cost_recorder=crit_a_cost)\n760\t        _ca_batch_texts = plan.texts\n761\t        log.info(\"[swarm] AURORA_BATCH_SWEEP: critic_a batch collected %d/%d \"\n762\t                 \"(failed=%d -> synchronous)\", len(plan.texts), len(_ca_items),\n763\t                 len(plan.failed))\n764\t\n765\t    # --- Swarm path: runner -> critic_a + critic_b -> reconciler -> embed -> file ---\n766\t    for sc in swarm_candidates:\n767\t        slug = sc.candidate.proposed_slug\n768\t        # O-12: pre-runner per-role + total budget check. A single Sonnet call\n769\t        # can spend ~$0.05; checking AFTER the runner overshoots by 15-20%.\n770\t        if budget_check:\n771\t            spent = _sweep_cost_so_far(conn, run_id)\n772\t            if spent > budget_cap:\n773\t                _note_budget_exceeded(run_id, spent, budget_cap)\n774\t                static_only = []\n775\t                break\n776\t            if _role_budget_exceeded(conn, run_id, \"runner\"):\n777\t                spent_r = _role_cost_so_far(conn, run_id, \"runner\")\n778\t                _note_budget_exceeded(run_id, spent_r, PER_ROLE_BUDGET_USD[\"runner\"])\n779\t                static_only = []\n780\t                break\n781\t        log.info(\"[swarm] runner slug=%s\", slug)\n782\t        # Wave L6: in batch mode the runner artifact was already produced in the\n783\t        # pre-pass (re-running would double runner spend) — reuse it. Flag-off:\n784\t        # `_ca_runner_cache` is empty, so this is the unchanged synchronous run.\n785\t        if slug in _ca_runner_cache:\n786\t            rart = _ca_runner_cache[slug]\n787\t        else:\n788\t            rart = runner_role.run(sc, cost_recorder=runner_cost,\n789\t                                    logs_dir=LOG_DIR, dry_run=dry_run)\n790\t        if rart is None:\n791\t            log.warning(\"[swarm] runner returned None for slug=%s; static-only fallback\", slug)\n792\t            static_only.append(sc)\n793\t            continue\n794\t        # Wave L6: when a critic_a batch text was collected for this slug, parse\n795\t        # it (already metered at 0.5x); else prefetched_text=None -> synchronous\n796\t        # critic_a (the flag-off default, or the per-item degrade on a batch miss).\n797\t        _ca_prefetched = _ca_batch_texts.get(slug) if _ca_batch_texts else None\n798\t        ca = critic_a.critique(sc.candidate, rart, cost_recorder=crit_a_cost,\n799\t                               dry_run=dry_run, prefetched_text=_ca_prefetched)\n800\t        cb = critic_b.critique(rart, cost_recorder=crit_b_cost, dry_run=dry_run)\n801\t        if ca is None or cb is None:\n802\t            log.warning(\"[swarm] missing critic verdicts for slug=%s; static-only fallback\", slug)\n803\t            static_only.append(sc)\n804\t            continue\n805\t        # O-19 follow-up: third family-aware judge. Returns None on abstain\n806\t        # (no third-family provider reachable) — the reconciler treats absent\n807\t        # critic_c identically to its pre-O-19 2-critic behavior. Bumps\n808\t        # _CRITIC_C_ABSTAIN_COUNT[run_id] on abstain so the morning briefing\n809\t        # surfaces degraded mode.\n810\t        # Wave 1 (2026-06-02): DeepSeek/Groq calls now route through llm.py\n811\t        # (llm.call_deepseek / llm.call_groq) and each successful call's cost is\n812\t        # recorded via crit_c_cost, the same CostRecorder pattern every other\n813\t        # role uses.\n814\t        cc = critic_c.critique(sc.candidate.name, sc.candidate.short_description,\n815\t                                run_id=run_id, cost_recorder=crit_c_cost)\n816\t        verdict = reconciler.reconcile(sc.candidate, rart, ca, cb,\n817\t                                        critic_c=cc,\n818\t                                        cost_recorder=recon_cost, dry_run=dry_run)\n819\t        if verdict is None:\n820\t            log.warning(\"[swarm] reconciler returned None for slug=%s; static-only fallback\", slug)\n821\t            static_only.append(sc)\n822\t            continue\n823\t        log.info(\"[swarm] verdict=%s score=%.2f disagreement=%.2f slug=%s\",\n824\t                 verdict.verdict, verdict.overall_score, verdict.disagreement, slug)\n825\t        # Wave 3 (2026-06-06) + Wave 2/H2 (2026-06-06): evidence-rigor loop.\n826\t        # The loop's verdict runs in SHADOW (validations_shadow) for the\n827\t        # promotion gate; the LIVE verdict stays the legacy reconciler's UNLESS\n828\t        # the separately-authorized live switch (AURORA_EVIDENCE_ENGINE=loop) is\n829\t        # set — which DEFAULTS TO LEGACY here.\n830\t        #\n831\t        # COST: by DEFAULT the nightly shadow path costs ZERO added LLM spend —\n832\t        # it uses make_precomputed_score_fn, which REPLAYS the critics the legacy\n833\t        # verdict already computed for this candidate (no new critic/reconciler\n834\t        # calls). This preserves the Wave-3 zero-cost shadow guarantee. The REAL\n835\t        # per-iteration re-scorer (make_live_score_fn), which re-invokes the full\n836\t        # panel 1-3x per candidate, is SA-1 (separately authorized, budget-capped\n837\t        # via bin/run_evidence_shadow.py). On the nightly path it is used ONLY when\n838\t        # the explicit, DEFAULT-OFF flag AURORA_EVIDENCE_LIVE_RESCORE=1 is set; with\n839\t        # it unset the nightly run incurs no evidence_shadow LLM cost.\n840\t        # Best-effort: never break the sweep on the loop.\n841\t        loop_res = None\n842\t        if not dry_run and \\\n843\t                os.environ.get(\"AURORA_EVIDENCE_LOOP\", \"on\").strip().lower() != \"off\":\n844\t            try:\n845\t                # Feed the runner transcript as corroborating primary evidence —\n846\t                # its presence is what earns a `verified` badge (vs. `documented`\n847\t                # for a metadata-only curation). Best-effort + capped.\n848\t                transcript_text = \"\"\n849\t                tp = getattr(rart, \"transcript_path\", None)\n850\t                try:\n851\t                    if tp and Path(tp).is_file():\n852\t                        transcript_text = Path(tp).read_text(\n853\t                            encoding=\"utf-8\", errors=\"ignore\")[:20000]\n854\t                except OSError:\n855\t                    transcript_text = \"\"\n856\t                ev_state = evidence.build_candidate_evidence(\n857\t                    short_description=sc.candidate.short_description or \"\",\n858\t                    transcript_text=transcript_text)\n859\t                score_fn = _select_shadow_score_fn(\n860\t                    conn, run_id,\n861\t                    candidate=sc.candidate, runner_artifact=rart,\n862\t                    critics=[c for c in (ca, cb, cc) if c is not None],\n863\t                    legacy_verdict=verdict.verdict,\n864\t                    overall_score=verdict.overall_score,\n865\t                    incorporation_note=getattr(\n866\t                        verdict, \"one_paragraph_incorporation_note\", \"\") or \"\",\n867\t                    rationale=getattr(verdict, \"rationale\", \"\") or \"\",\n868\t                    transcript_text=transcript_text,\n869\t                    cost_recorder=evidence_shadow_cost)\n870\t                loop_res = evidence.run_evidence_loop(ev_state, score_fn)\n871\t                verdict.confidence_badge = loop_res.confidence_badge\n872\t                verdict.evidence_iters = loop_res.iters\n873\t                log.info(\"[swarm] evidence badge=%s verdict=%s (%s, %d iter) slug=%s\",\n874\t                         loop_res.confidence_badge, loop_res.verdict,\n875\t                         loop_res.exit_reason, loop_res.iters, slug)\n876\t                # Wave 2/H2 live switch — DEFAULTS TO LEGACY. The live verdict\n877\t                # only adopts the loop's verdict when AURORA_EVIDENCE_ENGINE=loop\n878\t                # (and AURORA_ENGINE!=legacy). The loop is structurally monotonic\n879\t                # toward reject and force-downgrades pass->flag on non-convergence,\n880\t                # but that is monotonicity vs. its OWN reconciled input — NOT a\n881\t                # guarantee against legacy's verdict. So we add an explicit\n882\t                # fail-safe: adoption is monotonic-toward-stricter vs LEGACY. If\n883\t                # the loop verdict is MORE LENIENT (more servable) than legacy for\n884\t                # THIS artifact, we KEEP legacy and never adopt the looser verdict.\n885\t                # (SA-2 is the authorized flip; even then it can only tighten.)\n886\t                if evidence.live_engine_is_loop():\n887\t                    if _verdict_is_more_lenient(loop_res.verdict, verdict.verdict):\n888\t                        log.warning(\n889\t                            \"[swarm] AURORA_EVIDENCE_ENGINE=loop but loop verdict \"\n890\t                            \"%s is MORE LENIENT than legacy %s — KEEPING legacy \"\n891\t                            \"(monotonic-toward-stricter) slug=%s\",\n892\t                            loop_res.verdict, verdict.verdict, slug)\n893\t                    else:\n894\t                        log.info(\"[swarm] AURORA_EVIDENCE_ENGINE=loop — live verdict \"\n895\t                                 \"from loop (%s -> %s) slug=%s\",\n896\t                                 verdict.verdict, loop_res.verdict, slug)\n897\t                        verdict.verdict = loop_res.verdict\n898\t            except Exception as e:  # noqa: BLE001 — loop must never break a sweep\n899\t                log.warning(\"[swarm] evidence loop failed slug=%s: %s\", slug, e)\n900\t                loop_res = None\n901\t        placement = embedder.place(sc.candidate, verdict,\n902\t                                    cost_recorder=embedder_cost, dry_run=dry_run)\n903\t        if placement is None:\n904\t            continue\n905\t        if not dry_run:\n906\t            # Wave B4 (2026-05-29): pass runner_artifact through so the\n907\t            # librarian populates validations.transcript_path +\n908\t            # artifact_bundle_path on the 'runner' / 'reconciler' rows. The\n909\t            # columns have existed since v3 but were NULL on every row.\n910\t            artifact_id = librarian.upsert_artifact(conn, candidate=sc.candidate,\n911\t                                       run_id=run_id, screened=sc, placement=placement,\n912\t                                       verdict=verdict, runner_artifact=rart)\n913\t            # Wave 3: record the shadow-engine row for the promotion-gate diff.\n914\t            if loop_res is not None:\n915\t                try:\n916\t                    shadow_diff.record_shadow(\n917\t                        conn, artifact_id=artifact_id, run_id=run_id,\n918\t                        legacy_verdict=verdict.verdict, loop_result=loop_res)\n919\t                except Exception as e:  # noqa: BLE001 — never break a sweep\n920\t                    log.warning(\"[swarm] shadow record failed slug=%s: %s\", slug, e)\n921\t            # Wave A3 (2026-05-29): pass verdict + conn so the librarian renders\n922\t            # the reconciler's incorporation_note instead of the boilerplate.\n923\t            librarian.write_library_md(LIBRARY_ROOT, candidate=sc.candidate,\n924\t                                       screened=sc, placement=placement,\n925\t                                       verdict=verdict, conn=conn)\n926\t        placed += 1\n927\t        if verdict.verdict == \"flag\":\n928\t            flagged += 1\n929\t        # J4: after this candidate's roles all recorded, check budget.\n930\t        if budget_check:\n931\t            spent = _sweep_cost_so_far(conn, run_id)\n932\t            if spent > budget_cap:\n933\t                _note_budget_exceeded(run_id, spent, budget_cap)\n934\t                # Skip the rest of swarm AND the static-only loop.\n935\t                static_only = []\n936\t                break\n937\t\n938\t    # --- Static-only path: embed and file the rest ---\n939\t    for sc in static_only:\n940\t        log.info(\"[static] embedding slug=%s\", sc.candidate.proposed_slug)\n941\t        placement = embedder.place(sc.candidate, None,\n942\t                                    cost_recorder=embedder_cost, dry_run=dry_run)\n943\t        if placement is None:\n944\t            continue\n945\t        if not dry_run:\n946\t            librarian.upsert_artifact(conn, candidate=sc.candidate, run_id=run_id,\n947\t                                       screened=sc, placement=placement, verdict=None)\n948\t            # Wave A3 (2026-05-29): static-only path has no fresh verdict, but\n949\t            # pass conn so a prior sweep's persisted note (if any) is rendered\n950\t            # rather than reverting to boilerplate.\n951\t            librarian.write_library_md(LIBRARY_ROOT, candidate=sc.candidate,\n952\t                                       screened=sc, placement=placement,\n953\t                                       verdict=None, conn=conn)\n954\t        placed += 1\n955\t        # J4: same check on the static tail (embedder is cheap, but still\n956\t        # spends; defend the cap here too).\n957\t        if budget_check:\n958\t            spent = _sweep_cost_so_far(conn, run_id)\n959\t            if spent > budget_cap:\n960\t                _note_budget_exceeded(run_id, spent, budget_cap)\n961\t                break\n962\t\n963\t    log.info(\"[6/8] librarian filed %d artifacts (%d flagged)\", placed, flagged)\n964\t\n965\t    if not dry_run:\n966\t        # Wave 5 (2026-06-06): stamp each artifact's source-quality indicator\n967\t        # from its seed's yield BEFORE regenerating the index so the index\n968\t        # renders it. Best-effort — never break the sweep.\n969\t        try:\n970\t            from aurora.roles import source_reputation\n971\t            n_sq = source_reputation.assign_source_quality(conn)\n972\t            log.info(\"[6.5/8] source_quality stamped on %d artifacts\", n_sq)\n973\t        except Exception as e:  # noqa: BLE001\n974\t            log.warning(\"[6.5/8] assign_source_quality failed: %s\", e)\n975\t        librarian.regenerate_indexes(LIBRARY_ROOT, conn, dry_run=dry_run)\n976\t    log.info(\"[7/8] librarian.regenerate_indexes done\")\n977\t\n978\t    # Wave 4 (2026-06-10): the taste score. Post-librarian, score every NEW\n979\t    # non-paper/non-retired unscored find against docs/INTEREST_PROFILE.md,\n980\t    # capped (AURORA_TASTE_NIGHTLY_CAP, default 40) with a heuristic fallback so\n981\t    # nothing is left unscored. Metered through CostRecorder against the resolved\n982\t    # taste tag (E17). Best-effort — a taste failure NEVER breaks a sweep.\n983\t    if not dry_run:\n984\t        try:\n985\t            from aurora.roles import taste\n986\t            taste_cost = CostRecorder(conn, run_id, \"taste\")\n987\t            tsum = taste.run(conn, cost_recorder=taste_cost)\n988\t            log.info(\"[7.7/8] taste: %d via LLM, %d via heuristic (cap=%d, pending=%d)\",\n989\t                     tsum[\"scored_llm\"], tsum[\"scored_heuristic\"],\n990\t                     tsum[\"cap\"], tsum[\"pending\"])\n991\t        except Exception as e:  # noqa: BLE001 — never break a sweep on taste\n992\t            log.error(\"orchestrator: taste.run failed: %s\", e)\n993\t\n994\t    # Wave-A.2 + A.3 (2026-05-25): for the agents sweep, populate the\n995\t    # neural_plasticity table for every newly-validated agent + render the\n996\t    # 14-dim plasticity matrix. Both deterministic / cheap; the populator\n997\t    # is the §2.4 charter promise that's been unwired for weeks.\n998\t    if not dry_run and cfg.name == \"agents\":\n999\t        try:\n1000\t            from aurora.roles import populate_neural_plasticity as pnp\n1001\t            report = pnp.populate(slugs=None, dry_run=False)\n1002\t            log.info(\"[7.5/8] plasticity backfill: %d updated, %d skipped, %d errors\",\n1003\t                     len(report.get(\"updated\", [])), len(report.get(\"skipped\", [])),\n1004\t                     len(report.get(\"errors\", [])))\n1005\t        except Exception as e:\n1006\t            log.error(\"orchestrator: populate_neural_plasticity failed: %s\", e)\n1007\t        try:\n1008\t            from aurora.roles import plasticity_matrix\n1009\t            day = datetime.now(timezone.utc).strftime(\"%Y-%m-%d\")\n1010\t            mpath = plasticity_matrix.render_matrix(\n1011\t                conn, REPORTS_ROOT / \"agents\" / day)\n1012\t            log.info(\"[7.6/8] plasticity_matrix rendered -> %s\", mpath)\n1013\t        except Exception as e:\n1014\t            log.error(\"orchestrator: plasticity_matrix.render_matrix failed: %s\", e)\n1015\t\n1016\t    # Cost rollup + exec summary\n1017\t    cost_row = conn.execute(\n1018\t        \"SELECT COALESCE(SUM(usd_estimate),0), COALESCE(SUM(tokens_in),0), \"\n1019\t        \"COALESCE(SUM(tokens_out),0) FROM costs WHERE run_id=?\", (run_id,)\n1020\t    ).fetchone()\n1021\t    log.info(\"[7/8] cost rollup: $%.4f total · %dK in / %dK out\",\n1022\t             cost_row[0], cost_row[1] // 1000, cost_row[2] // 1000)\n1023\t\n1024\t    log.info(\"[8/8] exec summary will be written after close_run; status=ok\")\n1025\t\n1026\t    return (f\"sweep={cfg.name}; fetched={len(fetched)}; screened={len(screened)}; \"\n1027\t            f\"placed={placed}; usd=${cost_row[0]:.4f}; tokens_in={cost_row[1]}; \"\n1028\t            f\"tokens_out={cost_row[2]}\")\n1029\t\n1030\t\n1031\tasync def walk_models_pipeline(cfg: SweepConfig, conn: sqlite3.Connection, run_id: int, *,\n1032\t                               dry_run: bool, no_swarm: bool,\n1033\t                               top_k: Optional[int] = None,\n1034\t                               providers: Optional[set[str]] = None) -> str:\n1035\t    \"\"\"Models-sweep pipeline (Bucket L M-3/M-4 fetch+screen, M-6/M-7 persist).\n1036\t\n1037\t    Sibling of walk_pipeline. The scout (json_api kind) fetches the OpenRouter\n1038\t    model list on the host; the static screener dedupes it into one\n1039\t    Candidate(kind='model') per canonical model id (358 raw -> ~340 distinct).\n1040\t    M-6/M-7 wire the rest:\n1041\t\n1042\t      model_card_parser.parse  -> a `models`-row dict (mostly from the JSON; ONE\n1043\t                                  Haiku authoritative-field call per top-K /\n1044\t                                  frontier model — cost recorded).\n1045\t      librarian.upsert_model   -> artifacts(kind='model') + models satellite row\n1046\t                                  (embedder placement OPTIONAL for models).\n1047\t      benchmark_scraper.scrape -> model_benchmarks rows from Artificial Analysis\n1048\t                                  (KEY-OPTIONAL: skipped cleanly if no AA key).\n1049\t      librarian.write_model_md -> library/models/<provider>/<family>-<ver>/index.md\n1050\t      librarian.render_model_grid -> library/models/_grid.md + library/_model_grid.html\n1051\t\n1052\t    The LLM enrichment is gated to `top_k` candidates (default 20) so we never\n1053\t    LLM-extract all 340. Non-enriched models still persist fully from the JSON.\n1054\t    An empty fetch (dry_run / sandbox-blocked egress) is tolerated.\n1055\t    \"\"\"\n1056\t    log.info(\"─\" * 60)\n1057\t    log.info(\"Models sweep: %s  run_id=%s  dry_run=%s  top_k=%s  providers=%s\",\n1058\t             cfg.name, run_id, dry_run, top_k, sorted(providers) if providers else None)\n1059\t    log.info(\"─\" * 60)\n1060\t\n1061\t    seed_map = yaml.safe_load(cfg.seed_map_path.read_text(encoding=\"utf-8\"))\n1062\t    log.info(\"[1/7] seed_map loaded: %s\", cfg.seed_map_path.name)\n1063\t\n1064\t    fetched = await scout.fan_out(seed_map, dry_run=dry_run)\n1065\t    log.info(\"[2/7] scout -> %d model docs (json_api expands each model to one doc)\",\n1066\t             len(fetched))\n1067\t\n1068\t    quarantined = [quarantine_role.wrap(s) for s in fetched]\n1069\t    log.info(\"[3/7] quarantine wrapped %d docs\", len(quarantined))\n1070\t\n1071\t    # O-18: models sweep also gets the sanitizer (cheap; model JSON is short).\n1072\t    sanitizer_cost = CostRecorder(conn, run_id, \"sanitizer\") if not dry_run else None\n1073\t    quarantined, n_injections = sanitizer_role.sanitize(quarantined, cost_recorder=sanitizer_cost)\n1074\t    if n_injections:\n1075\t        log.info(\"[3.5/7] sanitizer scrubbed %d injection(s) across %d doc(s)\",\n1076\t                 n_injections, len(quarantined))\n1077\t    if not dry_run:\n1078\t        _persist_sanitizer_telemetry(conn, run_id, n_injections)\n1079\t\n1080\t    screened = static_screener.screen(quarantined, dry_run=dry_run, sweep=cfg.name)\n1081\t    log.info(\"[4/7] static_screener -> %d distinct models\", len(screened))\n1082\t\n1083\t    if dry_run:\n1084\t        log.info(\"[5/7] dry-run: skipping persist + enrichment + grid\")\n1085\t        return (f\"sweep={cfg.name}; fetched={len(fetched)}; screened {len(screened)} models; \"\n1086\t                f\"placed=0 (dry-run); usd=$0.0000\")\n1087\t\n1088\t    # Optional provider allowlist (matches the canonical id's provider prefix).\n1089\t    def _provider_of(sc) -> str:\n1090\t        cid = (sc.candidate.raw_model or {}).get(\"canonical_model_id\") or \"\"\n1091\t        prov = cid.split(\"/\", 1)[0].lower() if \"/\" in cid else \"\"\n1092\t        return model_card_parser._PROVIDER_NORMALIZE.get(prov, prov)\n1093\t\n1094\t    if providers:\n1095\t        before = len(screened)\n1096\t        screened = [sc for sc in screened if _provider_of(sc) in providers]\n1097\t        log.info(\"[5/7] provider allowlist %s: %d/%d models retained\",\n1098\t                 sorted(providers), len(screened), before)\n1099\t\n1100\t    # Enrichment gate: only the top-K (default 20) get the LLM authoritative-field\n1101\t    # call. Rank by score then context size as a cheap \"frontier\" proxy.\n1102\t    enrich_k = top_k if top_k is not None else 20\n1103\t    screened_sorted = sorted(\n1104\t        screened,\n1105\t        key=lambda s: (s.score,\n1106\t                       ((s.candidate.raw_model or {}).get(\"raw\") or {}).get(\"context_length\") or 0),\n1107\t        reverse=True,\n1108\t    )\n1109\t    enrich_set = {id(sc) for sc in screened_sorted[:max(0, enrich_k)]}\n1110\t    log.info(\"[5/7] enrichment gated to top-%d models (LLM authoritative-field call)\",\n1111\t             min(enrich_k, len(screened_sorted)))\n1112\t\n1113\t    parser_cost = CostRecorder(conn, run_id, \"model_card_parser\")\n1114\t    embedder_cost = CostRecorder(conn, run_id, \"embedder\")\n1115\t\n1116\t    placed = 0\n1117\t    model_artifacts: list[tuple[int, str]] = []  # (artifact_id, canonical_id) for benchmark match\n1118\t    written_md: list[str] = []\n1119\t    budget_cap = PER_SWEEP_BUDGET_USD\n1120\t\n1121\t    for sc in screened_sorted:\n1122\t        cand = sc.candidate\n1123\t        canonical_id = (cand.raw_model or {}).get(\"canonical_model_id\") or cand.proposed_slug\n1124\t        do_enrich = id(sc) in enrich_set\n1125\t        model_row = model_card_parser.parse(cand, enrich=do_enrich, cost_recorder=parser_cost)\n1126\t        # Embedder placement is OPTIONAL for models. Place only the top-K (cheap\n1127\t        # taxonomy node) so the grid stays the interface but frontier models also\n1128\t        # appear on the sunburst under agent-internals > underlying-models.\n1129\t        placement = None\n1130\t        if do_enrich:\n1131\t            placement = embedder.place_model(cand, model_row,\n1132\t                                             cost_recorder=embedder_cost) \\\n1133\t                if hasattr(embedder, \"place_model\") else None\n1134\t        artifact_id = librarian.upsert_model(\n1135\t            conn, candidate=cand, run_id=run_id, screened=sc,\n1136\t            model_row=model_row, placement=placement, verdict=None,\n1137\t        )\n1138\t        model_artifacts.append((artifact_id, canonical_id))\n1139\t        placed += 1\n1140\t        # Budget guard (J4): the only spend here is the per-top-K Haiku call.\n1141\t        spent = _sweep_cost_so_far(conn, run_id)\n1142\t        if spent > budget_cap:\n1143\t            _note_budget_exceeded(run_id, spent, budget_cap)\n1144\t            break\n1145\t\n1146\t    log.info(\"[6/7] persisted %d models (artifacts + models satellite rows)\", placed)\n1147\t\n1148\t    # Benchmarks (Artificial Analysis; KEY-OPTIONAL — clean skip if no key).\n1149\t    n_bench = benchmark_scraper.scrape(conn, model_artifacts)\n1150\t\n1151\t    # Per-model cards. Re-read each persisted model row + its benchmarks so the\n1152\t    # card reflects exactly what's in the DB.\n1153\t    conn.row_factory = sqlite3.Row\n1154\t    for artifact_id, canonical_id in model_artifacts:\n1155\t        mrow = conn.execute(\"SELECT * FROM models WHERE artifact_id=?\", (artifact_id,)).fetchone()\n1156\t        if mrow is None:\n1157\t            continue\n1158\t        # Find the candidate again for name/sources/description.\n1159\t        cand = next((s.candidate for s in screened_sorted\n1160\t                     if (s.candidate.raw_model or {}).get(\"canonical_model_id\") == canonical_id\n1161\t                     or s.candidate.proposed_slug == canonical_id), None)\n1162\t        if cand is None:\n1163\t            continue\n1164\t        benches = [dict(b) for b in conn.execute(\n1165\t            \"SELECT benchmark, score, score_text, contamination_flag, source_url \"\n1166\t            \"FROM model_benchmarks WHERE artifact_id=?\", (artifact_id,)).fetchall()]\n1167\t        p = librarian.write_model_md(LIBRARY_ROOT, cand, dict(mrow), benchmarks=benches)\n1168\t        written_md.append(str(p))\n1169\t    conn.row_factory = None\n1170\t\n1171\t    grid = librarian.render_model_grid(LIBRARY_ROOT, conn, dry_run=False)\n1172\t    n_grid = grid.get(\"n_models\", 0) if grid else 0\n1173\t\n1174\t    # Pricing Intelligence: Verify collected prices and sync to config.\n1175\t    try:\n1176\t        pricing_collector.run_verification(conn, run_id)\n1177\t    except Exception as e:\n1178\t        log.error(\"orchestrator: pricing_collector failed: %s\", e)\n1179\t\n1180\t    # Wave B5 (2026-05-29): nightly smoke tests against the model catalog.\n1181\t    # Default-OFF: opt in with AURORA_SMOKE_TESTS_ENABLED=1 so the curator can\n1182\t    # review cost behavior over a few nights before paying for OpenRouter probes.\n1183\t    # Same wave-A pattern used by populate_neural_plasticity (dry-run-by-default).\n1184\t    smoke_summary = \"smoke: disabled (set AURORA_SMOKE_TESTS_ENABLED=1 to enable)\"\n1185\t    if os.environ.get(\"AURORA_SMOKE_TESTS_ENABLED\", \"\").strip() == \"1\":\n1186\t        try:\n1187\t            from aurora.roles import model_smoke_tester as mst\n1188\t            cap = float(os.environ.get(mst.CAP_USD_ENV, mst.DEFAULT_CAP_USD))\n1189\t            smoke_results = mst.run_smoke_tests(\n1190\t                conn, run_id,\n1191\t                max_usd=cap,\n1192\t                providers_subset=providers,  # honor --providers allowlist too\n1193\t            )\n1194\t            smoke_summary = (\n1195\t                f\"smoke: ok={smoke_results.n_ok} error={smoke_results.n_error} \"\n1196\t                f\"no_key={smoke_results.n_no_key} skipped_cap={smoke_results.n_skipped_cap} \"\n1197\t                f\"usd=${smoke_results.total_usd:.4f}\"\n1198\t            )\n1199\t        except Exception as e:\n1200\t            log.error(\"orchestrator: model_smoke_tester failed: %s\", e)\n1201\t            smoke_summary = f\"smoke: failed ({type(e).__name__})\"\n1202\t\n1203\t    cost_row = conn.execute(\n1204\t        \"SELECT COALESCE(SUM(usd_estimate),0), COALESCE(SUM(tokens_in),0), \"\n1205\t        \"COALESCE(SUM(tokens_out),0) FROM costs WHERE run_id=?\", (run_id,)\n1206\t    ).fetchone()\n1207\t    log.info(\"[7/7] models complete: fetched %d, screened %d, persisted %d, \"\n1208\t             \"cards %d, benchmarks %d, grid models %d; $%.4f spent; %s\",\n1209\t             len(fetched), len(screened), placed, len(written_md), n_bench, n_grid,\n1210\t             cost_row[0], smoke_summary)\n1211\t\n1212\t    return (f\"sweep={cfg.name}; fetched={len(fetched)}; screened {len(screened)} models; \"\n1213\t            f\"placed={placed}; cards={len(written_md)}; benchmarks={n_bench}; \"\n1214\t            f\"grid_models={n_grid}; usd=${cost_row[0]:.4f}; \"\n1215\t            f\"tokens_in={cost_row[1]}; tokens_out={cost_row[2]}; {smoke_summary}\")\n1216\t\n1217\t\n1218\t# ----------------------------------------------------------------------------\n1219\t# Awareness Revamp Wave 2: SHADOW-ONLY retarget (CC2 — never touches live KB)\n1220\t# ----------------------------------------------------------------------------\n1221\t\n1222\tSHADOW_RETARGET_SEED_MAP = ROOT / \"seed_map\" / \"shadow_retarget.yaml\"\n1223\t\n1224\t\n1225\tdef _load_shadow_retarget_seeds() -> list[dict]:\n1226\t    \"\"\"Load the SHADOW-ONLY retarget seeds (seed_map/shadow_retarget.yaml).\n1227\t    These are NEVER loaded by the nightly path — only this shadow branch reads\n1228\t    them. Returns the raw seed dicts (all `enabled: false` + `shadow_only: true`\n1229\t    on disk; the shadow pass enables them in-memory for the shadow fetch only).\"\"\"\n1230\t    import yaml\n1231\t    if not SHADOW_RETARGET_SEED_MAP.exists():\n1232\t        return []\n1233\t    data = yaml.safe_load(SHADOW_RETARGET_SEED_MAP.read_text(encoding=\"utf-8\")) or {}\n1234\t    return list(data.get(\"seeds\", []))\n1235\t\n1236\t\n1237\tdef _run_retarget_shadow(cfg, *, shadow_date: Optional[str]) -> int:\n1238\t    \"\"\"Run the W2 high-signal sources + frontier ranker in SHADOW ONLY.\n1239\t\n1240\t    CC2: opens the live KB STRICTLY read-only (via bin/run_ranker_shadow), runs\n1241\t    the ranker over current artifacts, writes the diff to reports/ranker_shadow/\n1242\t    and (if any rows are persisted) to a SEPARATE shadow DB — NEVER the live\n1243\t    aurora.db. Nothing is promoted to cron. The new sources are loaded from\n1244\t    seed_map/shadow_retarget.yaml and reported (the live shadow FETCH of those\n1245\t    sources is gated by the cost cap + remains shadow-only; in this wave the\n1246\t    deliverable is the reviewable ranker diff + the recall-net proof).\"\"\"\n1247\t    from datetime import date as _date\n1248\t    sys.path.insert(0, str(ROOT / \"bin\"))\n1249\t    import importlib.util\n1250\t\n1251\t    spec = importlib.util.spec_from_file_location(\n1252\t        \"run_ranker_shadow\", ROOT / \"bin\" / \"run_ranker_shadow.py\")\n1253\t    rrs = importlib.util.module_from_spec(spec)\n1254\t    spec.loader.exec_module(rrs)\n1255\t\n1256\t    run_date = shadow_date or _date.today().isoformat()\n1257\t    seeds = _load_shadow_retarget_seeds()\n1258\t    arxiv_seeds = [s for s in seeds if s.get(\"kind\") in (\"arxiv\", \"feed\")]\n1259\t    log.info(\"orchestrator[retarget-shadow]: %d shadow seeds loaded \"\n1260\t             \"(%d arxiv recall-net), date=%s — SHADOW ONLY, live KB read-only\",\n1261\t             len(seeds), len(arxiv_seeds), run_date)\n1262\t\n1263\t    diff = rrs.run_shadow(\n1264\t        db_path=DB_PATH, date=run_date, top_n=50,\n1265\t        persist_diffs=True, dry_run=False,\n1266\t    )\n1267\t    log.info(\"orchestrator[retarget-shadow]: %d artifacts, %d loaded; \"\n1268\t             \"ranker_validated=%s; promotion_eligible=%s; diff -> %s\",\n1269\t             diff[\"n_artifacts\"], diff[\"n_loaded\"], diff[\"ranker_validated\"],\n1270\t             diff[\"promotion_eligible\"], diff.get(\"_written\"))\n1271\t    log.info(\"orchestrator[retarget-shadow]: budget cell 'ranker_shadow' cap \"\n1272\t             \"$%.4f; promotion to cron is a MANUAL step after review\",\n1273\t             PER_ROLE_BUDGET_USD[\"ranker_shadow\"])\n1274\t    return 0\n1275\t\n1276\t\n1277\t# ----------------------------------------------------------------------------\n1278\t# Main\n1279\t# ----------------------------------------------------------------------------\n1280\t\n1281\tdef main(argv: Optional[list[str]] = None) -> int:\n1282\t    load_dotenv(ROOT / \".env\", override=False)\n1283\t\n1284\t    ap = argparse.ArgumentParser(description=\"Aurora nightly sweep orchestrator.\")\n1285\t    ap.add_argument(\"--sweep\", required=True, choices=[\"skills\", \"tools\", \"agents\", \"models\"])\n1286\t    ap.add_argument(\"--dry-run\", action=\"store_true\",\n1287\t                    help=\"Walk the pipeline with no LLM calls or network fetches.\")\n1288\t    ap.add_argument(\"--no-swarm\", action=\"store_true\",\n1289\t                    help=\"Skip runner+critic_a+critic_b+reconciler; embed and file every static-pass candidate.\")\n1290\t    # Bucket L M-2: models-sweep knobs. Parsed now (so the CLI surface is stable\n1291\t    # for scripts/scheduled tasks); wired into the smoke_runner + screener in\n1292\t    # later waves. --providers restricts which vendor keys the smoke runner\n1293\t    # exercises; --top-k caps how many candidates enter the swarm.\n1294\t    ap.add_argument(\"--providers\", default=None,\n1295\t                    help=\"(models sweep) comma-separated provider allowlist, e.g. 'anthropic,google'. \"\n1296\t                         \"Parsed now; used by the smoke runner in a later wave.\")\n1297\t    ap.add_argument(\"--top-k\", type=int, default=None,\n1298\t                    help=\"(models sweep) cap on candidates entering the swarm. \"\n1299\t                         \"Parsed now; used by the screener in a later wave.\")\n1300\t    ap.add_argument(\"--log-level\", default=\"INFO\",\n1301\t                    choices=[\"DEBUG\", \"INFO\", \"WARNING\", \"ERROR\"])\n1302\t    # Awareness Revamp Wave 2 (2026-06-12): SHADOW-ONLY retarget. Default False.\n1303\t    # When UNSET (the cron default) behavior is byte-for-byte unchanged — the\n1304\t    # flag is not consulted anywhere on the live write path below. When SET, the\n1305\t    # orchestrator runs the new high-signal sources + frontier ranker in SHADOW\n1306\t    # against a *_shadow/fixture KB (NEVER the live tables), cost-capped via the\n1307\t    # \"ranker_shadow\" budget cell, and returns WITHOUT opening a live run. CC2:\n1308\t    # zero live-DB writes; off cron; promotion is a documented MANUAL step.\n1309\t    ap.add_argument(\"--retarget-shadow\", action=\"store_true\", default=False,\n1310\t                    help=\"SHADOW-ONLY: run the W2 high-signal sources + frontier \"\n1311\t                         \"ranker against a fixture/shadow KB (never live), \"\n1312\t                         \"cost-capped; nothing is promoted to cron.\")\n1313\t    ap.add_argument(\"--shadow-date\", default=None,"}]},"parent_tool_use_id":"toolu_01UkhjqCpsBaWTEbkLkiiJeJ","session_id":"0e9f13f6-4032-41a4-8d9f-b9e18c221609","uuid":"80fc9b6c-3b62-4d30-92f9-df9c7ea28c14","timestamp":"2026-06-23T18:39:51.875Z","subagent_type":"Explore","task_description":"Explore Aurora core architecture"}
