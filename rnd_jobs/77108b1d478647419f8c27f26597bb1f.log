{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TKwF1gDQ5ebyeKLKD7B44n","type":"tool_result","content":"1\t\"\"\"Thin LLM wrapper that records every call into the `costs` table.\n2\tSingle point where pricing lives so all roles share the same accounting.\n3\t\n4\tBucket G1+G2 (v4.3, 2026-05-19):\n5\t  - tenacity-driven retry on transient Anthropic and Gemini errors\n6\t    (full-jitter exponential 1..60s, 5 attempts, then degrade to Haiku)\n7\t  - critic_b default model swapped to gemini-2.5-flash-lite\n8\t    (thinking-off-by-default, 6x cheaper, sidesteps the MAX_TOKENS bug)\n9\t\"\"\"\n10\tfrom __future__ import annotations\n11\timport logging\n12\timport os\n13\timport time\n14\tfrom dataclasses import dataclass\n15\tfrom datetime import datetime, timezone\n16\tfrom pathlib import Path\n17\tfrom typing import Optional\n18\timport yaml\n19\t\n20\tfrom tenacity import (\n21\t    retry,\n22\t    stop_after_attempt,\n23\t    stop_after_delay,\n24\t    wait_exponential_jitter,\n25\t    retry_if_exception,\n26\t    before_sleep_log,\n27\t)\n28\t\n29\tlog = logging.getLogger(__name__)\n30\t\n31\tROOT = Path(__file__).resolve().parent\n32\tPRICING_PATH = ROOT / \"kb\" / \"pricing.yaml\"\n33\t\n34\t# ---- Transient-error classifiers (Bucket G1) ----\n35\t\n36\tdef _is_retryable_anthropic(exc: BaseException) -> bool:\n37\t    \"\"\"True for transient Anthropic errors: timeouts, connection drops,\n38\t    429 (rate-limited), 5xx, and 529 (overloaded). NOT for 4xx like 400/401/403.\"\"\"\n39\t    import anthropic\n40\t    if isinstance(exc, (anthropic.APITimeoutError, anthropic.APIConnectionError)):\n41\t        return True\n42\t    if isinstance(exc, anthropic.APIStatusError):\n43\t        return exc.status_code in (408, 425, 429, 500, 502, 503, 504, 529)\n44\t    return False\n45\t\n46\t\n47\tdef _is_retryable_genai(exc: BaseException) -> bool:\n48\t    \"\"\"Heuristic for google-generativeai transient errors. Their exception\n49\t    hierarchy is less structured than Anthropic's, so we match on type name\n50\t    and message keywords.\"\"\"\n51\t    name = type(exc).__name__\n52\t    if name in (\n53\t        \"ServiceUnavailable\", \"DeadlineExceeded\", \"Aborted\",\n54\t        \"ResourceExhausted\", \"InternalServerError\", \"RetryError\",\n55\t    ):\n56\t        return True\n57\t    msg = str(exc).lower()\n58\t    return any(k in msg for k in (\n59\t        \"503\", \"504\", \"529\", \"overloaded\", \"timeout\", \"rate limit\", \"try again\",\n60\t    ))\n61\t\n62\t\n63\t# ---- Retry decorators ----\n64\t# Full-jitter exponential, 5 attempts, max 60s wait. `reraise=True` so the\n65\t# caller sees the original exception type, not a tenacity RetryError.\n66\t#\n67\t# Bucket O-23 (2026-05-23): stop is now `stop_after_attempt(5) | stop_after_delay(60)`\n68\t# so the inner retry chain cannot run longer than 60s wall-clock regardless of\n69\t# attempt count. The outer Sonnet→Haiku fallback in call_anthropic has its own\n70\t# wall-clock guard (HAIKU_FALLBACK_DEADLINE_S) so the total worst case is\n71\t# 60s + 60s = 120s, not the prior 5×60 + 5×60 = ~10min.\n72\t_RETRY_KW = dict(\n73\t    wait=wait_exponential_jitter(initial=1, max=60),\n74\t    stop=stop_after_attempt(5) | stop_after_delay(60),\n75\t    reraise=True,\n76\t    before_sleep=before_sleep_log(log, logging.WARNING),\n77\t)\n78\t\n79\t# O-23: outer wall-clock budget across the Sonnet→Haiku fallback chain.\n80\tHAIKU_FALLBACK_DEADLINE_S = 120.0\n81\t\n82\t\n83\t@retry(retry=retry_if_exception(_is_retryable_anthropic), **_RETRY_KW)\n84\tdef _anthropic_create(client, **kw):\n85\t    return client.messages.create(**kw)\n86\t\n87\t\n88\t@retry(retry=retry_if_exception(_is_retryable_genai), **_RETRY_KW)\n89\tdef _gemini_generate(model_obj, prompt, generation_config):\n90\t    return model_obj.generate_content(prompt, generation_config=generation_config)\n91\t\n92\t\n93\t# ---- Bucket G4: per-run degrade counter, read by orchestrator.close_run() ----\n94\t# Incremented whenever a Sonnet->Haiku or Gemini->Haiku fallback fires for a\n95\t# given run. orchestrator looks at this after walk_pipeline to decide whether\n96\t# to close the run as 'ok' or 'partial'.\n97\t_DEGRADE_COUNT: \"dict[int, int]\" = {}\n98\t\n99\t\n100\tdef _note_degrade(cost_recorder: Optional[\"CostRecorder\"], reason: str) -> None:\n101\t    if cost_recorder is None:\n102\t        return\n103\t    rid = cost_recorder.run_id\n104\t    _DEGRADE_COUNT[rid] = _DEGRADE_COUNT.get(rid, 0) + 1\n105\t    log.warning(\"degrade #%d for run_id=%s: %s\", _DEGRADE_COUNT[rid], rid, reason)\n106\t\n107\t\n108\tdef get_and_clear_degrade_count(run_id: int) -> int:\n109\t    \"\"\"Read + reset the per-run degrade counter. Called by orchestrator after\n110\t    walk_pipeline so the next run starts at zero even if process is long-lived.\"\"\"\n111\t    return _DEGRADE_COUNT.pop(run_id, 0)\n112\t\n113\t\n114\tdef load_pricing() -> dict:\n115\t    return yaml.safe_load(PRICING_PATH.read_text(encoding=\"utf-8\"))\n116\t\n117\t\n118\t# 2026-06-05 (cost-audit): models seen unpriced at runtime, warned once each so\n119\t# a silent $0 charge surfaces in logs instead of vanishing. The Gemini embedding\n120\t# path records `models/gemini-embedding-2`, but pricing.yaml keys it without the\n121\t# `models/` prefix — that mismatch priced every embedding at $0 and is the main\n122\t# reason Aurora's `gemini_mtd` was fiction. See reports/cost-audit-2026-06-05.md.\n123\t_WARNED_UNPRICED: set[str] = set()\n124\t\n125\t\n126\tdef lookup_rates(pricing: dict, vendor: str, model: str) -> tuple[float, float]:\n127\t    \"\"\"Resolve (in_rate, out_rate) per-million USD for vendor/model.\n128\t\n129\t    Robust to the `models/` prefix the Gemini embedding API uses (recorded as\n130\t    `models/gemini-embedding-2`, priced in pricing.yaml as `gemini-embedding-2`).\n131\t    Returns (0.0, 0.0) and warns ONCE per (vendor, model) when no price entry\n132\t    exists, so an unpriced model is visible rather than silently free.\n133\t    \"\"\"\n134\t    v = (pricing.get(\"vendors\") or {}).get(vendor, {})\n135\t    candidates = [model]\n136\t    if model.startswith(\"models/\"):\n137\t        candidates.append(model[len(\"models/\"):])\n138\t    for key in candidates:\n139\t        if key in v:\n140\t            r = v[key]\n141\t            return (float(r.get(\"tokens_in_per_million_usd\", 0.0)),\n142\t                    float(r.get(\"tokens_out_per_million_usd\", 0.0)))\n143\t    tag = f\"{vendor}/{model}\"\n144\t    if tag not in _WARNED_UNPRICED:\n145\t        _WARNED_UNPRICED.add(tag)\n146\t        log.warning(\"pricing: no rate for %s — recording usd_estimate=0.0 \"\n147\t                    \"(add it to kb/pricing.yaml; see cost-audit-2026-06-05)\", tag)\n148\t    return (0.0, 0.0)\n149\t\n150\t"}]},"parent_tool_use_id":"toolu_01UkhjqCpsBaWTEbkLkiiJeJ","session_id":"0e9f13f6-4032-41a4-8d9f-b9e18c221609","uuid":"d50e0628-7de2-4758-af47-c4b3895623e1","timestamp":"2026-06-23T18:39:40.969Z","subagent_type":"Explore","task_description":"Explore Aurora core architecture"}
