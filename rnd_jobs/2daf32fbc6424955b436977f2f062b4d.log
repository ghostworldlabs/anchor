{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L3vmTzs89ff8EQ4kHLJ1eF","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"\n3\tAnchor GUI â€” Local web-based dashboard with full read/write access.\n4\t\n5\tStarts a local HTTP server that serves the interactive dashboard and provides\n6\tAPI endpoints so that every click (done, add, capture) writes directly to\n7\tthe markdown files, logs changes, and refreshes the state.\n8\t\n9\tUsage:\n10\t    python3 anchor_gui.py          # Opens dashboard in your default browser\n11\t    python3 anchor_gui.py --port 8777   # Use a custom port\n12\t\n13\tLaunch from Cowork by typing \"Dashboard\" â€” Claude will run this for you.\n14\t\"\"\"\n15\t\n16\timport json, logging, os, re, socket, sys, threading, time, traceback, webbrowser\n17\tfrom datetime import datetime, date\n18\tfrom pathlib import Path\n19\tfrom http.server import ThreadingHTTPServer, BaseHTTPRequestHandler\n20\tfrom urllib.parse import parse_qs, quote as url_quote, urlparse\n21\timport html as html_lib\n22\t\n23\t# â”€â”€ Paths â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n24\t# Single-folder layout (was previously dual-folder PSU + Axmra; consolidated 2026-05-02).\n25\t# Wave 2: data paths resolve via the shared `paths` helper, honoring the\n26\t# ANCHOR_DATA_DIR env var (unset -> the code dir, so behavior is unchanged).\n27\timport paths as _paths\n28\t\n29\t# Process-wide write lock: held around every markdown/JSON mutation so two\n30\t# concurrent mutating requests (ThreadingHTTPServer) cannot lose an update.\n31\tWRITE_LOCK = _paths.WRITE_LOCK\n32\t\n33\t# ANCHOR_DIR is the *code* dir (used for static assets like anchor.ico).\n34\tANCHOR_DIR = _paths.CODE_DIR\n35\t\n36\tDASHBOARD_MD = _paths.dashboard_md()\n37\tPROJECTS_MD = _paths.projects_md()\n38\tINBOX_MD = _paths.inbox_md()\n39\tDOMAINS_DIR = _paths.domains_dir()\n40\tLOGS_DIR = _paths.logs_dir()\n41\tCANCELLED_MD = _paths.cancelled_md()\n42\tSAVED_FOR_LATER_MD = _paths.saved_for_later_md()\n43\t\n44\t# Ensure data dirs exist (logs/, domains/, health_reports/). This is the GUI's\n45\t# explicit call â€” directory creation is no longer an import-time side effect of\n46\t# the shared helper.\n47\t_paths.ensure_data_dirs()\n48\t\n49\t# â”€â”€ Error Logging â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n50\tERROR_LOG = LOGS_DIR / \"errors.log\"\n51\tERROR_LOG.parent.mkdir(parents=True, exist_ok=True)\n52\tlogging.basicConfig(\n53\t    filename=str(ERROR_LOG),\n54\t    level=logging.ERROR,\n55\t    format=\"%(asctime)s â€” %(levelname)s â€” %(message)s\",\n56\t    datefmt=\"%Y-%m-%d %H:%M:%S\",\n57\t)\n58\t# Also log INFO to the error log for server lifecycle events\n59\t_logger = logging.getLogger(\"anchor\")\n60\t_logger.setLevel(logging.INFO)\n61\t# Guard against double-handler attach: if anchor_gui is imported more than once\n62\t# in the same interpreter (e.g. by anchor_healthcheck), only one FileHandler\n63\t# should remain on the logger. Also disable propagation so records don't also\n64\t# get written by the root logger's FileHandler (installed by basicConfig above)\n65\t# â€” that was producing duplicated lines in errors.log.\n66\tif not any(isinstance(h, logging.FileHandler) and getattr(h, \"baseFilename\", None) == str(ERROR_LOG)\n67\t           for h in _logger.handlers):\n68\t    _fh = logging.FileHandler(str(ERROR_LOG))\n69\t    _fh.setFormatter(logging.Formatter(\"%(asctime)s â€” %(levelname)s â€” %(message)s\", datefmt=\"%Y-%m-%d %H:%M:%S\"))\n70\t    _logger.addHandler(_fh)\n71\t_logger.propagate = False\n72\t\n73\t\n74\t# â”€â”€ Build identity (cache-bust) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n75\t# Computed ONCE at process startup. Used by the self-healing client JS to\n76\t# detect a redeploy and force a cache-busting reload (and to kill any leftover\n77\t# service worker / Cache Storage left behind by an old Anchor build).\n78\tdef _compute_build_id():\n79\t    import subprocess\n80\t    try:\n81\t        out = subprocess.run(\n82\t            [\"git\", \"rev-parse\", \"--short\", \"HEAD\"],\n83\t            cwd=str(ANCHOR_DIR),\n84\t            capture_output=True, text=True, timeout=5,\n85\t        )\n86\t        rev = (out.stdout or \"\").strip()\n87\t        if out.returncode == 0 and rev:\n88\t            return rev\n89\t    except Exception:\n90\t        pass\n91\t    # Fallback: mtime of this source file (changes on every redeploy).\n92\t    try:\n93\t        return str(int(os.path.getmtime(__file__)))\n94\t    except Exception:\n95\t        return \"0\"\n96\t\n97\t\n98\tBUILD_ID = _compute_build_id()\n99\t\n100\t\n101\t# Self-healing cache-bust client JS. Kept as a plain (non-f) string so it can\n102\t# be embedded verbatim in BOTH the f-string dashboard page (generate_html) and\n103\t# the concatenated project-window page without brace-doubling concerns. The\n104\t# build id is substituted via a simple placeholder, not f-string formatting.\n105\t_CACHE_BUST_JS_TEMPLATE = \"\"\"\n106\t(function () {\n107\t  try {\n108\t    window.__ANCHOR_BUILD__ = \"__ANCHOR_BUILD_ID__\";\n109\t    // Kill any leftover service worker registered by an OLD Anchor build.\n110\t    if (navigator.serviceWorker && navigator.serviceWorker.getRegistrations) {\n111\t      navigator.serviceWorker.getRegistrations().then(function (rs) {\n112\t        rs.forEach(function (r) { try { r.unregister(); } catch (e) {} });\n113\t      }).catch(function () {});\n114\t    }\n115\t    // Best-effort: clear any stale Cache Storage entries.\n116\t    if (window.caches && caches.keys) {\n117\t      caches.keys().then(function (ks) {\n118\t        ks.forEach(function (k) { try { caches.delete(k); } catch (e) {} });\n119\t      }).catch(function () {});\n120\t    }"}]},"parent_tool_use_id":null,"session_id":"57b165ea-801c-4884-a9c5-829f186468e5","uuid":"8c757eb8-7c99-42d4-b2e2-573cf5b23b37","timestamp":"2026-06-13T12:43:03.151Z","tool_use_result":{"type":"text","file":{"filePath":"/c/dev/Anchor/anchor_gui.py","content":"#!/usr/bin/env python3\n\"\"\"\nAnchor GUI â€” Local web-based dashboard with full read/write access.\n\nStarts a local HTTP server that serves the interactive dashboard and provides\nAPI endpoints so that every click (done, add, capture) writes directly to\nthe markdown files, logs changes, and refreshes the state.\n\nUsage:\n    python3 anchor_gui.py          # Opens dashboard in your default browser\n    python3 anchor_gui.py --port 8777   # Use a custom port\n\nLaunch from Cowork by typing \"Dashboard\" â€” Claude will run this for you.\n\"\"\"\n\nimport json, logging, os, re, socket, sys, threading, time, traceback, webbrowser\nfrom datetime import datetime, date\nfrom pathlib import Path\nfrom http.server import ThreadingHTTPServer, BaseHTTPRequestHandler\nfrom urllib.parse import parse_qs, quote as url_quote, urlparse\nimport html as html_lib\n\n# â”€â”€ Paths â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n# Single-folder layout (was previously dual-folder PSU + Axmra; consolidated 2026-05-02).\n# Wave 2: data paths resolve via the shared `paths` helper, honoring the\n# ANCHOR_DATA_DIR env var (unset -> the code dir, so behavior is unchanged).\nimport paths as _paths\n\n# Process-wide write lock: held around every markdown/JSON mutation so two\n# concurrent mutating requests (ThreadingHTTPServer) cannot lose an update.\nWRITE_LOCK = _paths.WRITE_LOCK\n\n# ANCHOR_DIR is the *code* dir (used for static assets like anchor.ico).\nANCHOR_DIR = _paths.CODE_DIR\n\nDASHBOARD_MD = _paths.dashboard_md()\nPROJECTS_MD = _paths.projects_md()\nINBOX_MD = _paths.inbox_md()\nDOMAINS_DIR = _paths.domains_dir()\nLOGS_DIR = _paths.logs_dir()\nCANCELLED_MD = _paths.cancelled_md()\nSAVED_FOR_LATER_MD = _paths.saved_for_later_md()\n\n# Ensure data dirs exist (logs/, domains/, health_reports/). This is the GUI's\n# explicit call â€” directory creation is no longer an import-time side effect of\n# the shared helper.\n_paths.ensure_data_dirs()\n\n# â”€â”€ Error Logging â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nERROR_LOG = LOGS_DIR / \"errors.log\"\nERROR_LOG.parent.mkdir(parents=True, exist_ok=True)\nlogging.basicConfig(\n    filename=str(ERROR_LOG),\n    level=logging.ERROR,\n    format=\"%(asctime)s â€” %(levelname)s â€” %(message)s\",\n    datefmt=\"%Y-%m-%d %H:%M:%S\",\n)\n# Also log INFO to the error log for server lifecycle events\n_logger = logging.getLogger(\"anchor\")\n_logger.setLevel(logging.INFO)\n# Guard against double-handler attach: if anchor_gui is imported more than once\n# in the same interpreter (e.g. by anchor_healthcheck), only one FileHandler\n# should remain on the logger. Also disable propagation so records don't also\n# get written by the root logger's FileHandler (installed by basicConfig above)\n# â€” that was producing duplicated lines in errors.log.\nif not any(isinstance(h, logging.FileHandler) and getattr(h, \"baseFilename\", None) == str(ERROR_LOG)\n           for h in _logger.handlers):\n    _fh = logging.FileHandler(str(ERROR_LOG))\n    _fh.setFormatter(logging.Formatter(\"%(asctime)s â€” %(levelname)s â€” %(message)s\", datefmt=\"%Y-%m-%d %H:%M:%S\"))\n    _logger.addHandler(_fh)\n_logger.propagate = False\n\n\n# â”€â”€ Build identity (cache-bust) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n# Computed ONCE at process startup. Used by the self-healing client JS to\n# detect a redeploy and force a cache-busting reload (and to kill any leftover\n# service worker / Cache Storage left behind by an old Anchor build).\ndef _compute_build_id():\n    import subprocess\n    try:\n        out = subprocess.run(\n            [\"git\", \"rev-parse\", \"--short\", \"HEAD\"],\n            cwd=str(ANCHOR_DIR),\n            capture_output=True, text=True, timeout=5,\n        )\n        rev = (out.stdout or \"\").strip()\n        if out.returncode == 0 and rev:\n            return rev\n    except Exception:\n        pass\n    # Fallback: mtime of this source file (changes on every redeploy).\n    try:\n        return str(int(os.path.getmtime(__file__)))\n    except Exception:\n        return \"0\"\n\n\nBUILD_ID = _compute_build_id()\n\n\n# Self-healing cache-bust client JS. Kept as a plain (non-f) string so it can\n# be embedded verbatim in BOTH the f-string dashboard page (generate_html) and\n# the concatenated project-window page without brace-doubling concerns. The\n# build id is substituted via a simple placeholder, not f-string formatting.\n_CACHE_BUST_JS_TEMPLATE = \"\"\"\n(function () {\n  try {\n    window.__ANCHOR_BUILD__ = \"__ANCHOR_BUILD_ID__\";\n    // Kill any leftover service worker registered by an OLD Anchor build.\n    if (navigator.serviceWorker && navigator.serviceWorker.getRegistrations) {\n      navigator.serviceWorker.getRegistrations().then(function (rs) {\n        rs.forEach(function (r) { try { r.unregister(); } catch (e) {} });\n      }).catch(function () {});\n    }\n    // Best-effort: clear any stale Cache Storage entries.\n    if (window.caches && caches.keys) {\n      caches.keys().then(function (ks) {\n        ks.forEach(function (k) { try { caches.delete(k); } catch (e) {} });\n      }).catch(function () {});\n    }","numLines":120,"startLine":1,"totalLines":8094}}}
