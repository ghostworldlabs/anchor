ion Plan and Execution Log are named as member docs but no detailed content from them was provided in this session input, so no claims about their specifics (wave breakdown, execution outcomes) are asserted here."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4410,"cache_read_input_tokens":45117,"cache_creation":{"ephemeral_5m_input_tokens":4410,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ca55eaaa-5954-4f4f-8c1a-506b2b4535b4","uuid":"3e9b1403-281b-40d4-8268-bcd70583fd7c","request_id":"req_011Cc1JNcfdhj4nYwfSTCvvW"}
