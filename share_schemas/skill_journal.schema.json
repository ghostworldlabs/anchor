{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "anchor://share/skill_journal.schema.json",
  "title": "Shareable skill-run journal record (v1)",
  "description": "Minimal Foundry-oriented journal record for recipient skill trees. Schema-versioned semver. Mandatory: skill_id, skill_version, outcome class, structural_failure_codes.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "schema_version",
    "skill_id",
    "skill_version",
    "outcome",
    "structural_failure_codes"
  ],
  "properties": {
    "schema": { "const": "share-skill-journal/v1" },
    "schema_version": {
      "type": "string",
      "description": "Semver for this journal contract (e.g. 1.0.0)."
    },
    "record_id": { "type": "string" },
    "ts": {},
    "skill_id": { "type": "string", "minLength": 1 },
    "skill_version": { "type": "string", "minLength": 1 },
    "outcome": {
      "enum": ["worked", "friction", "failed", "refused", "workaround"]
    },
    "structural_failure_codes": {
      "type": "array",
      "items": {
        "enum": [
          "timeout",
          "tool_missing",
          "seat_failover",
          "parse_error",
          "gate_red",
          "budget_exhausted",
          "permission_denied",
          "network_denied",
          "unknown",
          "none"
        ]
      }
    },
    "notes": { "type": "string" },
    "duration_band": {
      "enum": ["lt_1m", "1_5m", "5_30m", "30m_2h", "gt_2h", "unknown"]
    },
    "complexity_band": {
      "enum": ["trivial", "small", "medium", "large", "unknown"]
    },
    "os_class": {
      "enum": ["windows", "macos", "linux", "other", "unknown"]
    },
    "model_family_seats": {
      "type": "array",
      "items": {
        "enum": ["claude", "gemini", "grok", "openai", "unknown"]
      }
    },
    "workaround_codes": {
      "type": "array",
      "items": {
        "enum": [
          "retry",
          "seat_switch",
          "manual_fix",
          "skip_step",
          "reduce_scope",
          "reread_docs",
          "other",
          "none"
        ]
      }
    },
    "workaround_tokens": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "maxLength": 24 }
    }
  }
}
