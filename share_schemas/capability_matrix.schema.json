{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "anchor://share/capability_matrix.schema.json",
  "title": "Shareable skills capability matrix (v1)",
  "description": "Per-skill Anchor coupling: works-without-Anchor | degraded-without-Anchor | Anchor-required. Package A roster policy is exclude | stub | include.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "skills"],
  "properties": {
    "schema": { "const": "share-capability-matrix/v1" },
    "schema_version": { "const": 1 },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/skill_capability" }
    }
  },
  "definitions": {
    "capability": {
      "description": "How the skill behaves without a live Anchor service.",
      "enum": [
        "works-without-Anchor",
        "degraded-without-Anchor",
        "Anchor-required"
      ]
    },
    "package_a_policy": {
      "description": "Skills-only package membership: exclude (omit), stub (include with degraded label), include (full).",
      "enum": ["exclude", "stub", "include"]
    },
    "skill_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "display_name",
        "suite",
        "capability",
        "package_a_policy",
        "degraded_label"
      ],
      "properties": {
        "skill_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "minLength": 1
        },
        "display_name": { "type": "string", "minLength": 1 },
        "suite": {
          "enum": ["trio", "foundry", "anchor-feature"]
        },
        "capability": { "$ref": "#/definitions/capability" },
        "package_a_policy": { "$ref": "#/definitions/package_a_policy" },
        "degraded_label": {
          "type": "string",
          "minLength": 1,
          "description": "Plain-English label when excluded/stubbed or running without Anchor."
        }
      }
    }
  }
}
