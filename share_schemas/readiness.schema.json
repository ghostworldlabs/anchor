{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "anchor://share/readiness.schema.json",
  "title": "Shareable package readiness stamp (v1)",
  "description": "Machine-readable ready | degraded stamp with closed reason codes. Green ready requires governance + coding seat OR explicit user-accepted degraded (implemented in later waves; schema frozen here).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "reason_codes", "package_id"],
  "properties": {
    "schema": { "const": "share-readiness/v1" },
    "schema_version": { "const": 1 },
    "status": {
      "description": "Closed readiness status. Never claim ready without governance+seat or explicit degraded acceptance.",
      "enum": ["ready", "degraded"]
    },
    "reason_codes": {
      "type": "array",
      "items": { "$ref": "#/definitions/reason_code" }
    },
    "package_id": { "enum": ["A", "B"] },
    "governance_installed": { "type": "boolean" },
    "coding_seat_ok": { "type": "boolean" },
    "user_accepted_degraded": { "type": "boolean" },
    "feedback_opt_in": {
      "type": "boolean",
      "description": "Feedback consent is NOT a readiness gate; default false."
    },
    "notes": { "type": "string" }
  },
  "definitions": {
    "reason_code": {
      "enum": [
        "governance_missing",
        "no_coding_seat",
        "user_accepted_degraded",
        "skills_pin_mismatch",
        "journal_contract_unproven",
        "skill_tree_forked",
        "os_desktop_skipped",
        "anchor_service_unavailable",
        "seat_probe_failed",
        "openai_sole_family_rejected",
        "prereq_missing"
      ]
    }
  }
}
