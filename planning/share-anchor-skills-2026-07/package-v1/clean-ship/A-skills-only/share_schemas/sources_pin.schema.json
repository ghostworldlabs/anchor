{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "anchor://share/sources_pin.schema.json",
  "title": "SOURCES multi-repo pin schema (v1)",
  "description": "Attestation shape for SOURCES.md / machine pin: multi-repo freeze tags/commits, package versions, skills_pin, scrub tool versions, ship_allowed. Freeze values are PLACEHOLDER until post-merge go-ahead.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "pins",
    "package_versions",
    "skills_pin",
    "scrub_tool_versions",
    "ship_allowed"
  ],
  "properties": {
    "schema": { "const": "share-sources-pin/v1" },
    "schema_version": { "const": 1 },
    "pins": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/repo_pin" }
    },
    "package_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "properties": {
        "A": { "type": "string", "minLength": 1 },
        "B": { "type": "string", "minLength": 1 }
      }
    },
    "skills_pin": { "$ref": "#/definitions/skills_pin" },
    "scrub_tool_versions": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "ship_allowed": {
      "type": "boolean",
      "description": "False until concurrent skill-run merge + John go-ahead. Plan-complete ≠ ship-allowed."
    },
    "ship_allowed_stamp_text": { "type": "string" }
  },
  "definitions": {
    "repo_id": {
      "enum": ["anchor", "trio", "skill-foundry"]
    },
    "repo_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "tag", "commit"],
      "properties": {
        "repo": { "$ref": "#/definitions/repo_id" },
        "tag": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "skills_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit"],
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 }
      }
    }
  }
}
